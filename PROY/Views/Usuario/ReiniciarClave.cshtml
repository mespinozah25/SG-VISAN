@model PROY.ViewModels.UsuarioVM

<h1>Reiniciar contraseña de usuario</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-controller="Usuario" asp-action="ReiniciarClave" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="IdUsuario" type="hidden" value="@Model.IdUsuario" />
            
            <div class="form-group">
                <label asp-for="Clave" class="control-label">Contraseña nueva</label>
                <input asp-for="Clave" type="text" class="form-control" />
                <span asp-validation-for="Clave" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConfirmarClave" class="control-label">Confirmar contraseña nueva</label>
                <input asp-for="ConfirmarClave" type="text" class="form-control" />
                <span asp-validation-for="ConfirmarClave" class="text-danger"></span>
            </div>            
            <br />
            <div class="form-group">
                <input type="submit" value="Actualizar" class="btn btn-primary" />
                <a asp-controller="Home" asp-action="Start" class="btn btn-warning">Regresar</a>
            </div>

            @if (ViewData["Mensaje"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    @ViewData["Mensaje"]
                </div>
            }
            
        </form>
    </div>
</div>

<div>
    
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
