<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous">

<head>
</head>

<style>
    table thead th {
        pointer-events: none;
        /* Desactiva la interacción con los títulos */
    }
</style>

@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    ViewData["Title"] = "Reporte de Despachos APA";
}
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

<h2 class="float-start">Reporte de Despachos APA</h2>
<p><br /></p>

<br />

@await Html.PartialAsync("_CriteriosDeBusquedaAPA")

<!-- Aquí puedes agregar una tabla para mostrar los resultados -->
<div class="row mt-4">
    <div class="col">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Resultados</h5>
                <div id="tablaResultados">
                    <!-- Los resultados se cargarán aquí -->
                    <p class="text-muted">Use los criterios de búsqueda para mostrar resultados.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>

        var tipoReporte = 12;
        var nombreReporte = "Reporte de Despachos APA";

        $(document).ready(function () {
            HabilitarBusquedas();
        });

        function HabilitarBusquedas() {
            $('#divCriteriosBusqueda').show();
            $('#divFechaMovimientoInicio').show(); // Habilita los criterios
            $('#divFechaMovimientoFin').show();
            $('#divIdDepartamento').show();
            $('#divIdMunicipio').show();
        }

        function LimpiarCriterios() {
            $('#_frmBusqueda')[0].reset();
            return false;
        }

        var tipoReporte = 12;
        var nombreReporte = "Reporte Listado de Convenios";

        function Buscar() {
            // Obtener los valores del formulario
            var fechaInicio = $('#txtFechaInicio').val();
            var fechaFin = $('#txtFechaFin').val();
            var idDepartamento = $('#cbIdDepartamento').val();
            var idMunicipio = $('#cbIdMunicipio').val();

            // Mostrar loading
            $('#tablaResultados').html('<div class="text-center"><div class="spinner-border" role="status"><span class="visually-hidden">Cargando...</span></div></div>');

            var filtros = {
                FechaInicio: fechaInicio ? new Date(fechaInicio).toISOString() : null,
                FechaFin: fechaFin ? new Date(fechaFin).toISOString() : null,
                IdDepartamento: idDepartamento ? parseInt(idDepartamento) : null,
                IdMunicipio: idMunicipio ? parseInt(idMunicipio) : null
            };
            // Llamada AJAX
            $.ajax({
                url: '@Url.Action("BuscarDespachosAPA", "Reportes")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(filtros),
                success: function (response) {
                    if (response.success) {
                        // Actualizar la tabla con los resultados
                        ActualizarTablaResultados(response.data);
                    } else {
                        alert('Error: ' + response.message);
                        $('#tablaResultados').html('<p class="text-danger">Error al realizar la búsqueda</p>');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error en AJAX:', error);
                    alert('Error al conectar con el servidor');
                    $('#tablaResultados').html('<p class="text-danger">Error de conexión</p>');
                }
            });

            return false;
        }


        function ActualizarTablaResultados(datos) {
            if (!datos || datos.length === 0) {
                $('#tablaResultados').html('<div class="alert alert-info text-center">No se encontraron resultados con los criterios especificados.</div>');
                return;
            }

            var tablaHTML = `
                    <div class="table-responsive">
                                <table class="table" style="width:100%; position:relative; z-index:2;">
                                    <thead>
                                        <tr>
                                            <th>Despacho de Almacen</th>
                                            <th>Exp</th>
                                            <th>No. de Raciones</th>
                                            <th>Exp2</th>
                                            <th>Departamento</th>
                                            <th>Municipio</th>
                                            <th>Comunidad</th>
                                            <th>Tecnico Responsable</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                        `;

            datos.forEach(function (item) {
                tablaHTML += `
                       <tr>
                                                <td>${item.despacho}</td>
                                                <td>${item.exp}</td>
                                                <td>${item.totalRaciones}</td>
                                                <td>${item.exp2 ?? ''}</td>
                                                <td>${item.departamento}</td>
                                                <td>${item.municipio}</td>
                                                <td>${item.comunidad}</td>
                                                <td>${item.tecnicoResponsable}</td>
                                            </tr>`;

            });

            tablaHTML += `
                            </tbody>
                        </table>
                        <div class="row mt-3">
                            <div class="col-md-6">
                            </div>
                            <div class="col-md-6 text-end">
                                <small class="text-muted">Consulta generada: ${new Date().toLocaleString()}</small>
                            </div>
                        </div>
                    </div>`;

            $('#tablaResultados').html(tablaHTML);
        }
    </script>
}

<script src="~/js/reportes.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

