@model PROY.ViewModels.SolicitudSalidaAlimentosVM;
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous">
<head>
</head>

<style>
    table thead th {
        pointer-events: none; /* Desactiva la interacción con los títulos */
    }
</style>

@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    ViewData["Title"] = "ConstanciaSalida";
}
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}


<h2 class="float-start">Constancia de Salida de Alimentos</h2>
<p><br /></p>

<br />

@await Html.PartialAsync("_CriteriosDeBusqueda")

<table class="table" id="tableDetalle">
    <thead>
        <tr>
            <th>No.</th>
            <th>NÚMERO DE SOLICITUD</th>
            <th>FECHA DESPACHO</th>
            <th>PLACAS TRANSPORTE</th>
            <th>NOMBRE PILOTO</th>
        </tr>
    </thead>
    <tbody>
        @try
        {
            int indexCount = 0;

            foreach (var item in Model.listaSolicitudSalidaAlimentos)
            {
                <tr>
                    <td>
                        @{
                            indexCount++;
                        }
                        @indexCount
                    </td>
                    <td>@item.NoConstancia</td>
                    <td>
                        @{
                            var fechaVen = item.FechaDespacho != null ? item.FechaDespacho.Value.ToString("dd/MM/yyyy") : " ";
                        }
                        @fechaVen
                    </td>
                    <td>
                        @{
                            // Obtener la descripción usando el diccionario
                            string descripcionTrans = Model.TransportistaDict.TryGetValue(item.IdTransportista ?? 0, out var descBod)
                            ? descBod
                            : "Transporte no encontrado";
                        }
                        @descripcionTrans
                    </td>
                    <td>
                        @{
                            // Obtener la descripción usando el diccionario
                            string descripcioPiloto = Model.PilotoDict.TryGetValue(item.IdPiloto ?? 0, out var descPro)
                            ? descPro
                            : "Piloto no encontrada";
                        }
                        @descripcioPiloto
                    </td>
                </tr>
            }
        }
        catch
        {

        }

    </tbody>
</table>



@section Scripts {

    <script>

        var tipoReporte = 9;
        var nombreReporte = "Constancia de Salida de Alimentos";

        $( document ).ready(function() {

            $('#tableDetalle_paginate').hide();
            $('#tableDetalle_info').hide();
            $('#tableDetalle_filter').hide();

            // Oculta las flechas de ordenamiento
            $('table.dataTable thead th').removeClass('sorting sorting_asc sorting_desc');

            HabilitarBusquedas();
        });

        // Función que habilita los criterios de búsqueda que necesita para el reporte
        function HabilitarBusquedas(){

            $('#divCriteriosBusqueda').show(); // Habilita los criterios

            // Colocar .show() los criterios que desean que se visualicen
            $('#divNoConstancia').show();
        }

        function Buscar(){

            // Se inicia reiniciando la tabla
             $("#tableDetalle tbody").empty();

             let filtros = {
                NoConstancia: $("#txtNoConstancia").val(),
            };

             let datosEnvio = {
                FiltrosReportesDTO: filtros,
            };

            // Crear un objeto FormData
            var formData = new FormData();

            // Agregar los datos del formulario al objeto FormData
            formData.append('modelo', JSON.stringify(datosEnvio)); // Enviar el modelo como JSON

             $.ajax({
                url: `@ViewData["rutaApp"]/Reportes/BusquedaConstanciaSalida`,
                type: "POST",
                contentType: false,
                processData: false,
                data: formData,
                success: function (data) {

                    console.log(data.tabla);

                    let tabla = document.getElementById("tableDetalle");
                    let tbody = tabla.getElementsByTagName("tbody")[0];

                    data.tabla.forEach((detalle, index) => {

                        let fila = document.createElement("tr");

                        var fechaDesp = '';

                        if(detalle.fechaDespacho != null){
                            var fecha = detalle.fechaDespacho;  // Fecha recibida
                            fechaDesp = fecha.split("T")[0]; // Extrae solo la parte "YYYY-MM-DD"
                        }

                        let txtTransportista = $("#cbIdTransportista option[value='" + detalle.idTransportista + "']").text(); // Nombre de Transportista
                        let txtPiloto = $("#cbIdPiloto option[value='" + detalle.idPiloto + "']").text(); // Nombre del Piloto

                        fila.innerHTML = `
                            <td>${index + 1}</td>
                            <td>${detalle.noConstancia}</td>
                            <td>${fechaDesp}</td>
                            <td>${txtTransportista}</td>
                            <td>${txtPiloto}</td>
                        `;

                        tbody.appendChild(fila);
                    });
                },
                error: function (xhr, status, error) {
                    console.error("Error al mostrar Tabla:", error);
                    alert("Ocurrió un error al extraer los datos de la tabla.");
                }
            });
        }


    </script>
}

<script src="~/js/reportes.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

