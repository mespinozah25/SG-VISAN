@model PROY.ViewModels.TransportistaVM;
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous">
<head>
</head>
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    ViewData["Title"] = "Transportistas";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@* <div class="=row">
        <div class="col-sm-8"> *@
<h2 class="float-start">Administración de Transportistas</h2> <a class="btn btn-primary btn-sm float-end" onclick="abrirModalYActualizarUrl(0)"><i class="fas fa-plus-square"></i> Transportistas</a>
<p><br /></p>
<table class="table">
    <thead>
        <tr>
            <th>No.</th>
            <th>NOMBRE</th>
            <th>TELÉFONO</th>
            <th>NOMBRE CONTACTO</th>
            <th>OPCIONES</th>
        </tr>
    </thead>
    <tbody>
        @try
        {
            int indexCount = 0;

            foreach (var item in Model.listaTransportistas)
            {
                <tr>
                    <td>
                        @{
                            indexCount++;
                        }
                        @indexCount
                    </td>
                    <td>@item.NombreTransportista</td>
                    <td>@item.Telefono</td>
                    <td>@item.NombreContacto</td>
                    <td class="text-center">
                        <a class="btn btn-info btn-sm" onclick="abrirModalYActualizarUrl(@item.IdTransportista)"><i class="fas fa-edit"></i> Editar</a>
                        <a class="btn btn-danger btn-sm" asp-controller="Transportista" asp-action="Eliminar" asp-route-id="@item.IdTransportista" onclick="confirmar(event)"><i class="fas fa-trash"></i> Eliminar</a>
                    </td>

                </tr>
            }
        }
        catch
        {

        }

    </tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="wNewTransportista" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="height:400px;">
            <form asp-action="GuardarTransportista" asp-controller="Transportista" method="post">
                <div class="modal-header bg-secondary">
                    <h5 class="modal-title text-white" id="lblModalTitle">@ViewBag.ModalTitle</h5>
                    <button type="button" id="btnClose" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" id="idTransportista" asp-for="@Model.Transportista.IdTransportista" />
                    <div>
                        <div class="col">
                            <label for="txtNombreTransportista" class="control-label">Nombre del Transportista</label>
                            <input type="text" class="form-control" id="txtNombreTransportista" asp-for="@Model.Transportista.NombreTransportista" required></input>
                            <span asp-validation-for="@Model.Transportista.NombreTransportista" class="text-danger"></span>
                        </div>
                    </div>
                    <div>
                        <div class="col">
                            <label for="txtTelefono" class="control-label">Teléfono</label>
                            <input type="text" class="form-control" id="txtTelefono" asp-for="@Model.Transportista.Telefono" required></input>
                            <span asp-validation-for="@Model.Transportista.Telefono" class="text-danger"></span>
                        </div>
                    </div>
                    <div>
                        <div class="col">
                            <label for="txtNombreContacto" class="control-label">Nombre del Contacto</label>
                            <input type="text" class="form-control" id="txtNombreContacto" asp-for="@Model.Transportista.NombreContacto" required></input>
                            <span asp-validation-for="@Model.Transportista.NombreContacto" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <input type="submit" value="Guardar" class="btn btn-primary" />
                </div>
            </form>

        </div>
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function abrirModalYActualizarUrl(id) {
            if (id == 0) {
                var ventanaTitle = document.getElementById("lblModalTitle");
                ventanaTitle.textContent = "REGISTRO TRANSPORTISTA";

                $('#idTransportista').val(0);
                $('#txtNombreTransportista').val('');
                $('#txtTelefono').val('');
                $('#txtNombreContacto').val('');
            }
            else {

                $.ajax({
                    url: `@ViewData["rutaApp"]/Transportista/ObtenerTransportista/${id}`, // URL para obtener los datos
                    type: 'GET',
                    success: function (data) {

                        console.log('data' + JSON.stringify(data));
                        // Llenar el formulario del modal con los datos del transportista
                        $('#idTransportista').val(id);
                        $('#txtNombreTransportista').val(data.nombreTransportista);
                        $('#txtTelefono').val(data.telefono);
                        $('#txtNombreContacto').val(data.nombreContacto);

                        var ventanaTitle = document.getElementById("lblModalTitle");
                        ventanaTitle.textContent = "MODIFICAR TRANSPORTISTA ";
                    },
                    error: function (xhr, status, error) {
                        console.error('Error al obtener los datos del transportista:', error);
                    }
                });
            }

            var modal = new bootstrap.Modal(document.getElementById('wNewTransportista'));
            modal.show();

        }

        function confirmar(e){
            var res=confirm("Esta seguro de eliminar el transportista");
            if (res) return true;
            if (res==false) e.preventDefault();

            //return false;
        }
    </script>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


