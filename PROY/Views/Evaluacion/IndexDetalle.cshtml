    function abrirModalYActualizarUrl(idEvaluacion, idDetalleEvaluacion, codigo) {
        //alert(valorProceso);
        const nuevaUrl = `@ViewData["rutaApp"]/Evaluacion/IndexDetalle?idEvaluacion=${idEvaluacion}&idDetalleEvaluacion=${idDetalleEvaluacion}`;
        
        history.pushState(null, '', nuevaUrl);
        //alert(nuevaUrl);
        //alert('SOL:' + idSolicitud + ' DET:' + idDetalle);
        ///alert('PARAMS:' + idEvaluacion + '--' + idDetalleEvaluacion);
        
        if (idDetalleEvaluacion == 0) {
            var ventanaTitle = document.getElementById("lblModalTitle");
            ventanaTitle.textContent = "REGISTRO VALIDACIÓN SOLICITUD " + codigo;

            $('#hiddenDetEvaluacionId').val(0);
            //$('#cbIntervencion').val('');
            //$('#txtDescripcionEval').val('');
            $('#cbTipoValidacion').val('');
            //$('#cbMunicipio').val('');
            $('#txtObservacionesEval').val('');            
            $('#oldFileEval').val('');
        }
        else {
            //$('#lblModalTitle').val('MODIFICAR SOLICITUD');
            var ventanaTitle = document.getElementById("lblModalTitle");
            ventanaTitle.textContent = "MODIFICAR DETALLE DE SOLICITUD";

        }

        // Abre el modal
        var modal = new bootstrap.Modal(document.getElementById('wAddEditDetalleEvaluacion'));
        modal.show();

        // Llamada AJAX para obtener los datos de la solicitud
        $.ajax({
            url: `@ViewData["rutaApp"]/Evaluacion/ObtenerDetalleEvaluacion?idDetalleEvaluacion=${idDetalleEvaluacion}`, // URL para obtener los datos
            type: 'GET',
            success: function (data) {
                console.log('data' + JSON.stringify(data));
                // Llenar el formulario del modal con los datos de la solicitud
                $('#hiddenDetEvaluacionId').val(data.idDetalleEvaluacion);
                //$('#cbIntervencion').val(data.idIntervencion);
                //$('#txtDescripcionEval').val(data.descripcion);
                $('#cbTipoValidacion').val(data.idTipoValidacion);
                $('#txtObservacionesEval').val(data.observaciones);                
                $('#oldFileEval').val(data.archivo);

                var ventanaTitle = document.getElementById("lblModalTitle");
                ventanaTitle.textContent = "MODIFICAR VALIDACIÓN SOLICITUD " + codigo;
            },
            error: function (xhr, status, error) {
                console.error('Error al obtener los datos de la solicitud:', error);
            }
        });

    }

