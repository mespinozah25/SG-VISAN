    function enviarHiddenField() {
        var idEvaluacion = document.getElementById("hiddenEvaluacionId").value;
        var idDetalleEvaluacion = document.getElementById("hiddenDetEvaluacionId").value;

        //alert('IDs enviados: ' + idEvaluacion + '----' + idDetalleEvaluacion);

        $.ajax({
            url: '@ViewData["rutaApp"]/Evaluacion/IndexDetalle', // La URL del método en el controlador
            type: 'POST',
            data: { idEvaluacion: idEvaluacion, idDetalleEvaluacion: idDetalleEvaluacion, k: '1' }, // Enviar los datos
            success: function (response) {
                console.log('Datos enviados correctamente:', response);
            },
            error: function (xhr, status, error) {
                console.error('Error al enviar los datos:', error);
            }
        });
    }

    window.onpopstate = function (event) {
        // Cierra el modal si el usuario va hacia atrás
        var modalElement = document.getElementById('wAddEditDetalleEvaluacion');
        var modal = bootstrap.Modal.getInstance(modalElement);

        if (modal) {
            modal.hide();
        }
    };

