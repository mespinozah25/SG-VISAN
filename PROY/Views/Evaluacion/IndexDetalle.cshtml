@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>

    $(document).ready(function () {
        var abrirModalEditar = '@ViewBag.AbrirModalEditar';
        //console.log(abrirModalEditar);
        if (abrirModalEditar === 'edit') {
            var modal = new bootstrap.Modal(document.getElementById('wAddEditDetalleEvaluacion'));
            modal.show();
            //abrirModalYActualizarUrl(0);
        }
        else {
            //alert('xxxxx');
            //console.log(abrirModalEditar);
            $('#wAddEditDetalleEvaluacion').on('show.bs.modal', function (event) {

                $('#hiddenDetEvaluacionId').val(0);
                //$('#cbIntervencion').val('');
