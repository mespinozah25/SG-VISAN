@inject IHttpContextAccessor HttpContextAccessor
<head>
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous">
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
    <style>
        .modal-header .btn-close {
            color: white !important; /* Asegura que el ícono de la "X" sea blanco */
            opacity: 1;
            -webkit-filter: invert(1);
        }
    </style>

</head>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@model PROY.ViewModels.SolicitudesVM;

@{
    ViewData["rutaApp"] = @Model.rutaApp;
    //var claimDepto = User.FindFirst("Depto");
    var depto = "";

    try
    {
        depto = User.FindFirst("depto")?.Value;
    }
    catch
    {

    }

    var rol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

    // Usamos el HttpContext inyectado para acceder al QueryString
    var valorK = HttpContextAccessor.HttpContext?.Request.Query["k"].ToString();
    bool tieneValorK = !string.IsNullOrEmpty(valorK);
    
    var valorRetorno = HttpContextAccessor.HttpContext?.Request.Query["returnController"].ToString();
    var valorProceso = HttpContextAccessor.HttpContext?.Request.Query["proceso"].ToString();
    var condicion = "";

    if ((depto == "DAAN" && rol != "Admin") || (tieneValorK && valorK == "1" && rol == "Admin"))
        condicion = "1";
    else if ((depto == "DAPA" && rol != "Admin") || (tieneValorK && valorK == "2" && rol == "Admin"))
        condicion = "2";
}

@if (condicion == "1")
{
    <input type="hidden" name="idSOL" value="@Model.Solicitud.IdSolicitud" />
    <h2 class="float-start">MEDIOS DE VERIFICACION SOLICITUD @Model.Solicitud.Codigo</h2>    
    @if (valorRetorno == "Ejecucion" || ViewBag.RC=="Ejecucion")
    {
        <a class="btn btn-warning btn-sm btn-fixed-end" style="margin-right:135px; position:absolute; z-index:1;" asp-controller="Ejecucion" asp-action="Index" asp-route-k="1"><i class="fas fa-undo"></i> Regresar</a>
    }
    else if (valorRetorno=="Programacion" || ViewBag.RC=="Programacion")
    {
        <a class="btn btn-warning btn-sm btn-fixed-end" style="margin-right:135px; position:absolute; z-index:1;" asp-controller="Programacion" asp-action="Index" asp-route-k="1"><i class="fas fa-undo"></i> Regresar</a>
    }
    else
    {
        <a class="btn btn-warning btn-sm btn-fixed-end" style="margin-right:135px; position:absolute; z-index:1;" asp-controller="Evaluacion" asp-action="Index" asp-route-k="1"><i class="fas fa-undo"></i> Regresar</a>
    }
    

    <a class="btn btn-primary btn-sm btn-fixed-end" style="margin-right:15px; position:absolute; z-index:1;" onclick="abrirModalYActualizarUrl(@Model.Solicitud.IdSolicitud,0,'@Model.Solicitud.Codigo')"><i class="fas fa-plus-square"></i> Validación</a>
    <p><br /></p>
    <table class="table" style="width:100%; position:relative; z-index:2;">
        <thead>
            <tr>
                <th>
                    ID EVALUACION
                </th>
                <th>
                    TIPO VALIDACIÓN
                </th>
                <th>
                    ARCHIVO
                </th>
                <th>
                    OBSERVACIONES
                </th>                
                <th>OPCIONES</th>
            </tr>
        </thead>
        <tbody>
            @try
            {
                foreach (var item in Model.listaDetallesEvaluacion)
                {
                    <tr>
                        <td>
                            @item.IdDetalleEvaluacion
                        </td>
                        <td>
                            @*item.Descripcion*@
                            @{
                                // Obtener la descripción usando el diccionario
                                string descripcionTipoValidacion = Model.ValidacionDict.TryGetValue(item.IdTipoValidacion, out var descTipoValidacion)
                                ? descTipoValidacion
                                : "Validación no encontrada";
                            }
                            @descripcionTipoValidacion
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Archivo))
                            {
                                var extension = System.IO.Path.GetExtension(item.Archivo).ToLower();

                                if (extension == ".pdf")
                                {
                                    <a href="@Url.Action("PreviewFile", new { fileName = item.Archivo })" target="_blank">
                                        <i class="fas fa-file-pdf"></i> Ver PDF
                                    </a>
                                }
                                else if (extension == ".xls" || extension == ".xlsx")
                                {
                                    @* <a href="@Url.Action("PreviewFile", new { fileName = item.Archivo })" target="_blank">
                                       <i class="fas fa-file-excel"></i> Ver Excel
                                       </a> *@
                                    @*<a class="btn btn-success btn-sm" style="margin-right:160px;" data-bs-toggle="modal" data-bs-target="#wCargaExcel" onclick="limpiarINFO()">
                                         <i class="fas fa-plus-square"></i> Ver Excel
                                     </a>*@
                                    <a href="@Url.Action("DownloadFile", new { fileName = item.Archivo })">
                                        <i class="fas fa-file-excel"></i> Descargar
                                    </a>
                                }
                                else if (extension==".doc" || extension == ".docx")
                                {
                                    <a href="@Url.Action("DownloadFile", new { fileName = item.Archivo })">
                                        <i class="fas icon-file-word"></i> Descargar
                                    </a>
                                }
                                else if (extension==".ppt" || extension == ".pptx")
                                {
                                    <a href="@Url.Action("DownloadFile", new { fileName = item.Archivo })">
                                        <i class="fas icon-file-ppt"></i> Descargar
                                    </a>
                                }
                            }
                            else
                            {
                                <span>No disponible</span>
                            }
                        </td>
                        <td>
                            @item.Observaciones
                        </td>                        
                        <td>
                            <a class="btn btn-info btn-sm" onclick="abrirModalYActualizarUrl(@item.IdSolicitud, @item.IdDetalleEvaluacion,'@item.Solicitud.Codigo')"><i class="fas fa-edit"></i> Editar...</a>
                            <a class="btn btn-danger btn-sm" asp-action="EliminarDetalleEvaluacion" asp-route-idEvaluacion="@item.IdSolicitud" asp-route-idDetalleEvaluacion="@item.IdDetalleEvaluacion" onclick="confirmarDetalle(event)"><i class="fas fa-trash"></i> Eliminar</a>
                        </td>
                    </tr>
                }
            }
            catch
            {

            }
        </tbody>
    </table>
}
