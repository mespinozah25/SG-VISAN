                                    foreach (var detalle in item.DetallesSolicitudAPA ?? Enumerable.Empty<DetalleSolicitudAPA>())
                                    {
                                        foreach (var cat in Model.AnulacionDict)
                                        {
                                            if (detalle.IdAnulacion == cat.Key && cat.Value == "DUPLICADO")
                                            {
