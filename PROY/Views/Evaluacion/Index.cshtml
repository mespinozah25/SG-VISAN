@inject IHttpContextAccessor HttpContextAccessor
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous">

<style>
    .modal-header .btn-close {
        color: white !important; /* Asegura que el ícono de la "X" sea blanco */
        opacity: 1;
        -webkit-filter:invert(1);
    }
</style>

@model PROY.ViewModels.SolicitudesVM

@{
    ViewData["Title"] = "Index";
    ViewData["rutaApp"] = @Model.rutaApp;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var depto = "";

    try
    {
        depto = User.FindFirst("depto")?.Value;
    }
    catch
    {

    }

    var rol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var idDepto = User.FindFirst("idDepto")?.Value;
    var usr = User.FindFirst("Usuario")?.Value;
}

@{
    // Usamos el HttpContext inyectado para acceder al QueryString
    var valorK = HttpContextAccessor.HttpContext?.Request.Query["k"].ToString();
    bool tieneValorK = !string.IsNullOrEmpty(valorK);
    var condicion = "";

    if ((depto == "DAAN" && rol != "Admin") || (tieneValorK && valorK == "1" && rol == "Admin"))
        condicion = "1";
    else if ((depto == "DAPA" && rol != "Admin") || (tieneValorK && valorK == "2" && rol == "Admin"))
        condicion = "2";

    //Verificar DEPTO
    if (rol == "Admin")
    {
        if (valorK == "1")
            idDepto = "1";
        else if (valorK == "2")
            idDepto = "2";
    }
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

<ul class="nav nav-tabs" id="myTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="home-tab" data-bs-toggle="tab" data-bs-target="#home" type="button" role="tab" aria-controls="home" aria-selected="true">Solicitudes en Evaluación</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab" aria-controls="profile" aria-selected="false">Solicitudes Rechazadas</button>
    </li>    
</ul>
<div class="tab-content" id="myTabContent">
