@inject IHttpContextAccessor HttpContextAccessor
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous">

<style>
    .modal-header .btn-close {
        color: white !important; /* Asegura que el ícono de la "X" sea blanco */
        opacity: 1;
        -webkit-filter:invert(1);
    }
</style>

@model PROY.ViewModels.SolicitudesVM

@{
    ViewData["Title"] = "Index";
    ViewData["rutaApp"] = @Model.rutaApp;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var depto = "";

    try
    {
        depto = User.FindFirst("depto")?.Value;
    }
    catch
    {

    }

    var rol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var idDepto = User.FindFirst("idDepto")?.Value;
}

@{
    // Usamos el HttpContext inyectado para acceder al QueryString
    var valorK = HttpContextAccessor.HttpContext?.Request.Query["k"].ToString();
    bool tieneValorK = !string.IsNullOrEmpty(valorK);
    var condicion = "";

    if ((depto == "DAAN" && rol != "Admin") || (tieneValorK && valorK == "1" && rol == "Admin"))
        condicion = "1";
    else if ((depto == "DAPA" && rol != "Admin") || (tieneValorK && valorK == "2" && rol == "Admin"))
        condicion = "2";

    //Verificar DEPTO
    if (rol == "Admin")
    {
        if (valorK == "1")
            idDepto = "1";
        else if (valorK == "2")
            idDepto = "2";
    }
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

<h2 class="float-start">Solicitudes en Despacho</h2>@* <a class="btn btn-primary btn-sm float-end" onclick="abrirModalYActualizarUrl(0)"><i class="fas fa-plus-square"></i> Nueva Solicitud</a> *@
@* <button type="button" class="btn btn-primary float-end" data-bs-toggle="modal" data-bs-target="#wNewSolicitud">Nueva Solicitud</button> *@
<p><br /></p>
<table class="table">
    <thead>
        <tr>
            <th>
                CODIGO
            </th>
            <th>
                INTERVENCION
            </th>
            <th>
                FECHA INGRESO A DESPACHO
            </th>
            <th>
                FECHA INGRESO A UNIDAD
            </th>
            <th>
                UNIDAD
            </th>
            <th>
                ARCHIVO
            </th>
            <th>FALLECIDOS</th>
            <th>DUPLICADOS</th>
            <th>SIN DATOS</th>
            <th>GOBIERNO</th>
            <th>OPCIONES</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Solicitudes)
        {
            <tr>
                @* <td>
            @item.Correlativo
            </td> *@
                <td>
                    @item.Codigo
                </td>
                <td>
                    @{
                        // Obtener la descripción usando el diccionario
                        string descripcionIntervencion = Model.IntervencionDict.TryGetValue(item.IdIntervencion, out var descInter)
                        ? descInter
                        : "Intervención no encontrada";
                    }
                    @descripcionIntervencion
                </td>
                <td>
                    @item.FechaIngresoDespacho.Date.ToString("dd/MM/yyyy")
                </td>
                <td>
                    @item.FechaIngresoUnidad.Date.ToString("dd/MM/yyyy")
                </td>
                <td>
                    @* @item.IdUnidad *@
                    @{
                        // Obtener la descripción usando el diccionario
                        string descripcionUnidad = Model.UnidadDict.TryGetValue(Convert.ToInt16(item.Depto), out var descUnidad)
                        ? descUnidad
                        : "Unidad no encontrada";
                    }
                    @descripcionUnidad
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(item.Archivo))
                    {
                        <a href="@Url.Action("PreviewFile", new { fileName = item.Archivo })" target="_blank">
                            <i class="fas fa-file-pdf"></i> Ver PDF
                        </a>
                    }
                    else
                    {
                        <span>No disponible</span>
                    }
                </td>
                <td>
                    @{
                        int contadorFallecido = 0;
                    }

                    @try
                    {
                        foreach (var detalle in item.DetallesSolicitud ?? Enumerable.Empty<DetalleSolicitud>())
                        {
                            foreach (var cat in Model.AnulacionDict)
                            {
                                if (detalle.IdAnulacion == cat.Key && cat.Value == "FALLECIDO")
                                {
                                    contadorFallecido++;
                                }
                            }
                            //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")

                        }
                    }
                    catch
                    {

                    }

                    @contadorFallecido
                    @* @{int contadorFallecido=0;}
                @try{
                contadorFallecido = Model.Solicitudes.Where(s => s.Restrictiva == 0 && s.Depto == "DAAN")
                .SelectMany(s => s.DetallesSolicitud)
                .Where(d => d.Restrictiva == 0 && d.IdAnulacion != 0)
                .Count(d => d.catalogo.Descripcion == "FALLECIDO" && d.catalogo.IdCatalogo == d.IdAnulacion);

                }
                catch
                {

                } *@

                </td>
                @* <td>@item.Duplicados</td> *@
                <td>
                    @{
                        int contadorDuplicado = 0;
                    }

                    @try
                    {
                        foreach (var detalle in item.DetallesSolicitud ?? Enumerable.Empty<DetalleSolicitud>())
                        {
                            foreach (var cat in Model.AnulacionDict)
                            {
                                if (detalle.IdAnulacion == cat.Key && cat.Value == "DUPLICADO")
                                {
                                    contadorDuplicado++;
                                }
                            }
                            //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")

                        }
                    }
                    catch
                    {

                    }

                    @contadorDuplicado
                </td>
                @* <td>@item.SinDatos</td> *@
                <td>
                    @{
                        int contadorSinDatos = 0;
                    }

                    @try
                    {
                        foreach (var detalle in item.DetallesSolicitud ?? Enumerable.Empty<DetalleSolicitud>())
                        {
                            foreach (var cat in Model.AnulacionDict)
                            {
                                if (detalle.IdAnulacion == cat.Key && cat.Value == "SIN DATOS")
                                {
                                    contadorSinDatos++;
                                }
                            }
                            //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")

                        }
                    }
                    catch
                    {

                    }

                    @contadorSinDatos
                </td>
                @* <td>@item.Gobierno</td> *@
                <td>
                    @{
                        int contadorGobierno = 0;
                    }

                    @try
                    {
                        foreach (var detalle in item.DetallesSolicitud ?? Enumerable.Empty<DetalleSolicitud>())
                        {
                            foreach (var cat in Model.AnulacionDict)
                            {
                                if (detalle.IdAnulacion == cat.Key && cat.Value == "GOBIERNO")
                                {
                                    contadorGobierno++;
                                }
                            }
                            //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")

                        }
                    }
                    catch
                    {

                    }

                    @contadorGobierno
                </td>
                <td>


                    <a class="btn btn-primary btn-sm" onclick="abrirModalYActualizarUrl(@item.IdSolicitud, @idDepto)"><i class="fas fa-edit"></i> Info</a>

                    @* <a class="btn btn-warning btn-sm" asp-action="NuevaSolicitud" asp-route-id="@item.IdSolicitud">Editar</a> |*@
                    @* <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#wNewSolicitud">Editar</button> | *@
                    @* <a href="/Solicitud/Index/@item.IdSolicitud" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#wNewSolicitud">Editar</a> | *@

                    @* <a href="@Url.Action("Index", new { id = item.IdSolicitud })" class="btn btn-danger btn-sm">Editar</a> *@
                    @if (rol == "Admin")
                    {
                        <a class="btn btn-dark btn-sm" asp-controller="Programacion" asp-action="ListaDetalle" asp-route-idProgramacion="@item.IdSolicitud" asp-route-k="@condicion" asp-route-returnController="Despacho"><i class="fas fa-bars"></i> Beneficiarios</a>
                    }
                    else
                    {
                        <a class="btn btn-dark btn-sm" asp-controller="Programacion" asp-action="ListaDetalle" asp-route-idProgramacion="@item.IdSolicitud"><i class="fas fa-bars"></i> Beneficiarios</a>
                    }
                    @*<a class="btn btn-dark btn-sm" asp-controller="Evaluacion" asp-action="ListaDetalle" asp-route-idEvaluacion="@item.IdSolicitud"><i class="fas fa-bars"></i> Detalle</a>*@
                    <a class="btn btn-info btn-sm" asp-controller="Evaluacion" asp-action="IndexDetalle" asp-route-idEvaluacion="@item.IdSolicitud" asp-route-k="@condicion" asp-route-returnController="Despacho"><i class="fas fa-bars"></i> Medios Verificación</a>
                    <a class="btn btn-warning btn-sm"><i class="fas fa-bars"></i> Lista de despachos</a>
                    @if (rol == "Admin")
                    {
                        <a class="btn btn-danger btn-sm" asp-controller="Programacion" asp-action="EnviarProgramacion" asp-route-idProgramacion="@item.IdSolicitud" asp-route-k="@condicion" onclick="confirmarEnvio(event)"><i class="fas fa-bolt"></i> Liquidar</a>
                    }
                    else
                    {
                        <a class="btn btn-danger btn-sm" asp-controller="Programacion" asp-action="EnviarProgramacion" asp-route-idProgramacion="@item.IdSolicitud" onclick="confirmarEnvio(event)"><i class="fas fa-bolt"></i> Liquidar</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="wEditDespacho" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="height:650px;">
            <form asp-action="GuardarSolicitud" asp-controller="Solicitud" asp-route-k="@idDepto" asp-route-returnController="Despacho" enctype="multipart/form-data" method="post">
                <div class="modal-header bg-secondary">
                    <h5 class="modal-title text-white" id="lblModalTitle">@ViewBag.ModalTitle</h5>
                    <button type="button" id="btnClose" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" id="solicitudId" asp-for="Solicitud.IdSolicitud" />
                    @* <div class="form-group">
                    <label>Correlativo</label>
                    <input asp-for="@Model.Solicitud.Correlativo" class="form-control" required/>
                    <span asp-validation-for="@Model.Solicitud.Correlativo" class="text-danger"></span>
                    </div> *@
                    <div class="form-group">
                        <label class="control-label">Intervención</label>
                        <select class="form-select" id="cbIntervencion" asp-for="@Model.Solicitud.IdIntervencion" asp-items="ViewBag.Intervenciones" disabled></select>
                        <span asp-validation-for="@Model.Solicitud.IdIntervencion" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <label class="control-label">Fecha Ingreso Despacho</label>
                            <input asp-for="@Model.Solicitud.FechaIngresoDespacho" id="fdespacho" class="form-control" type="date" disabled />
                            <span asp-validation-for="@Model.Solicitud.FechaIngresoDespacho" class="text-danger"></span>
                        </div>
                        <div class="col-6">
                            <label class="control-label">Fecha Ingreso Unidad</label>
                            <input asp-for="@Model.Solicitud.FechaIngresoUnidad" id="funidad" class="form-control" type="date" disabled />
                            <span asp-validation-for="@Model.Solicitud.FechaIngresoUnidad" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Unidad</label>
                        <select class="form-select" id="cbunidad" asp-for="@Model.Solicitud.Depto" asp-items="ViewBag.Unidades" disabled></select>
                        <span asp-validation-for="@Model.Solicitud.Depto" class="text-danger"></span>
                    </div>
                    <div>
                        <label class="control-label">Archivo actual</label>
                        <input asp-for="@Model.Solicitud.Archivo" type="text" id="oldfile" class="form-control" disabled />
                    </div>
                    @* <div class="form-group">
                    <label for="file">Selecciona un archivo:</label>
                    <input type="file" name="file" id="file" class="form-control" />
                    </div> *@
                    @if (condicion == "2")
                    {
                        <div class="row">
                            <div class="col-6">
                                <label>No. Fallecidos:</label>
                                <input asp-for="@Model.Solicitud.Fallecidos" type="number" id="txtFallecidos" class="form-control" />
                            </div>
                            <div class="col-6">
                                <label>No. Duplicados:</label>
                                <input asp-for="@Model.Solicitud.Duplicados" type="number" id="txtDuplicados" class="form-control" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <label>No. Sin datos:</label>
                                <input asp-for="@Model.Solicitud.SinDatos" type="number" id="txtSinDatos" class="form-control" />
                            </div>
                            <div class="col-6">
                                <label>No. pertencen a Gobierno:</label>
                                <input asp-for="@Model.Solicitud.Gobierno" type="number" id="txtGobierno" class="form-control" />
                            </div>
                        </div>
                    }
                    <div class="row">
                        <div class="col-6">
                            <label class="control-label">Fecha inicio entrega</label>
                            <input asp-for="@Model.Solicitud.FInicioEntrega" id="finicioentrega" class="form-control" type="date" disabled />
                            <span asp-validation-for="@Model.Solicitud.FInicioEntrega" class="text-danger"></span>
                        </div>
                        <div class="col-6">
                            <label class="control-label">Fecha final entrega</label>
                            <input asp-for="@Model.Solicitud.FFinEntrega" id="ffinentrega" class="form-control" type="date" disabled/>
                            <span asp-validation-for="@Model.Solicitud.FFinEntrega" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <label>Dirección entrega:</label>
                            <input asp-for="@Model.Solicitud.DireccionEntrega" type="text" id="txtDireccionEntrega" class="form-control" disabled />
                        </div>
                        <div class="col-6">
                            <label>Técnico asignado:</label>
                            <input asp-for="@Model.Solicitud.TecnicoNombre" type="text" id="txtTecnicoAsignado" class="form-control" disabled/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <label>Teléfono tecnico:</label>
                            <input asp-for="@Model.Solicitud.TecnicoTelefono" type="text" id="txtTecnicoTelefono" class="form-control" disabled/>
                        </div>
                        <div class="col-6">
                            <label>Observaciones:</label>
                            <input asp-for="@Model.Solicitud.TecnicoObservaciones" type="text" id="txtObservaciones" class="form-control" disabled/>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <input type="submit" value="Guardar" class="btn btn-primary" disabled />
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
    $(document).on('change', '#cbunidad', function () {
        var opcionSeleccionada = $(this).val();
        console.log('Opción seleccionada:', opcionSeleccionada);
        //alert('hola');
        var catalogoSelect = $('#cbIntervencion');
        catalogoSelect.empty(); // Limpiar el select antes de agregar nuevas opciones

        if (opcionSeleccionada === "1") {
            console.log('Cargando intervenciones para DAAN');
            $.getJSON('@Url.Action("GetCat", "Solicitud")', { tipoCatalogo: "INTERVENCION" },
                function (data) {
                    console.log('Datos devueltos:', data);
                    var items = data.value.value;
                    $.each(items, function (index, item) {
                        catalogoSelect.append('<option value="' + item.id + '">' + item.descripcion + '</option>');
                    });
                });
        } else if (opcionSeleccionada === "2") {
            console.log('Cargando intervenciones para DAPA');
            $.getJSON('@Url.Action("GetCat", "Solicitud")', { tipoCatalogo: "INTERVENCIONES" },
                function (data) {
                    console.log('Datos devueltos:', data);
                    var items = data.value.value;
                    $.each(items, function (index, item) {
                        catalogoSelect.append('<option value="' + item.id + '">' + item.descripcion + '</option>');
                    });
                });
        }
    });

    function abrirModalYActualizarUrl(idSolicitud, idDepto) {
        // Actualiza la URL sin recargar la página
        const nuevaUrl = `@ViewData["rutaApp"]/Solicitud/Index/${idSolicitud}`;
        //alert(nuevaUrl);
        history.pushState(null, '', nuevaUrl);
        //alert('ID:' + idSolicitud);

        if (idSolicitud == 0) {
            //$('#lblModalTitle').val('NUEVA SOLICITUD');
            var ventanaTitle = document.getElementById("lblModalTitle");
            ventanaTitle.textContent = "NUEVA SOLICITUD";

            $('#solicitudId').val(0);
            $('#cbIntervencion').val('');
            $('#fdespacho').val('');
            $('#funidad').val('');
            $('#cbunidad').val(idDepto);
            $('#oldfile').val('');
            // $('#txtFallecidos').val(0);
            // $('#txtDuplicados').val(0);
            // $('#txtSinDatos').val(0);
            // $('#txtGobierno').val(0);

            cargarIntervenciones();
        }
        else {
            //$('#lblModalTitle').val('MODIFICAR SOLICITUD');
            var ventanaTitle = document.getElementById("lblModalTitle");
            ventanaTitle.textContent = "MODIFICAR SOLICITUD";

        }
        //window.location.href = `/Solicitud/Index/${idSolicitud}`;

        // Abre el modal
        var modal = new bootstrap.Modal(document.getElementById('wEditDespacho'));
        modal.show();
        // Llamada AJAX para obtener los datos de la solicitud
        $.ajax({
            url: `@ViewData["rutaApp"]/Solicitud/ObtenerSolicitud/${idSolicitud}`, // URL para obtener los datos
            type: 'GET',
            success: function (data) {
                console.log('data' + JSON.stringify(data));
                // Llenar el formulario del modal con los datos de la solicitud
                $('#solicitudId').val(data.idSolicitud);
                $('#cbIntervencion').val(data.idIntervencion);
                $('#fdespacho').val(data.fechaDespacho);
                $('#funidad').val(data.fechaUnidad);
                $('#cbunidad').val(data.depto);
                $('#oldfile').val(data.archivo);
                $('#finicioentrega').val(data.fInicioEntrega);
                $('#ffinentrega').val(data.fFinEntrega);
                $('#txtDireccionEntrega').val(data.direccionEntrega);
                $('#txtTecnicoAsignado').val(data.tecnicoNombre);
                $('#txtTecnicoTelefono').val(data.tecnicoTelefono);
                $('#txtObservaciones').val(data.tecnicoObservaciones);
            },
            error: function (xhr, status, error) {
                console.error('Error al obtener los datos de la solicitud:', error);
            }
        });

    }    

    function confirmarEnvio(e) {
        var envio = confirm("Confirma el envío de la solicitud");
        if (envio) return true;
        if (envio == false) e.preventDefault();
    }

    function cargarIntervenciones() {
        var opcionSeleccionada = $('#cbunidad').val();
        var catalogoSelect = $('#cbIntervencion');
        catalogoSelect.empty();
        if (opcionSeleccionada === "1") {
            console.log('Cargando intervenciones para DAAN');
            $.getJSON('@Url.Action("GetCat", "Solicitud")', { tipoCatalogo: "INTERVENCION" },
                function (data) {
                    console.log('Datos devueltos:', data);
                    var items = data.value.value;
                    $.each(items, function (index, item) {
                        catalogoSelect.append('<option value="' + item.id + '">' + item.descripcion + '</option>');
                    });
                });
        } else if (opcionSeleccionada === "2") {
            console.log('Cargando intervenciones para DAPA');
            $.getJSON('@Url.Action("GetCat", "Solicitud")', { tipoCatalogo: "INTERVENCIONES" },
                function (data) {
                    console.log('Datos devueltos:', data);
                    var items = data.value.value;
                    $.each(items, function (index, item) {
                        catalogoSelect.append('<option value="' + item.id + '">' + item.descripcion + '</option>');
                    });
                });
        }
    };
</script>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>