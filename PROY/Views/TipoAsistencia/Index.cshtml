@model PROY.ViewModels.TipoAsistenciaVM;
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous">
<head>
</head>
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    ViewData["Title"] = "Tipos Asistencias";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@* <div class="=row">
        <div class="col-sm-8"> *@
<h2 class="float-start">Administración de Tipos de Asistencia</h2> <a class="btn btn-primary btn-sm float-end" onclick="abrirModalYActualizarUrl(0)"><i class="fas fa-plus-square"></i> Tipo de Asistencia</a>
<p><br /></p>
<table class="table">
    <thead>
        <tr>
            <th>No.</th>
            <th>TIPO ASISTENICA</th>
            <th>ABREVIATURA</th>
            <th>OPCIONES</th>
        </tr>
    </thead>
    <tbody>
        @try
        {
            int indexCount = 0;

            foreach (var item in Model.listaTiposAsistencia)
            {
                <tr>
                    <td>
                        @{
                            indexCount++;
                        }
                        @indexCount
                    </td>
                    <td>@item.NombreTipoAsistencia</td>
                    <td>@item.Abreviatura</td>
                    <td class="text-center">
                        <a class="btn btn-info btn-sm" onclick="abrirModalYActualizarUrl(@item.IdTipoAsistencia)"><i class="fas fa-edit"></i> Editar</a>
                        <a class="btn btn-danger btn-sm" asp-controller="TipoAsistencia" asp-action="Eliminar" asp-route-id="@item.IdTipoAsistencia" onclick="confirmar(event)"><i class="fas fa-trash"></i> Eliminar</a>
                    </td>

                </tr>
            }
        }
        catch
        {

        }

    </tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="wNewTipoAsistencia" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="height:350px;">
            <form asp-action="GuardarTipoAsistencia" asp-controller="TipoAsistencia" method="post">
                <div class="modal-header bg-secondary">
                    <h5 class="modal-title text-white" id="lblModalTitle">@ViewBag.ModalTitle</h5>
                    <button type="button" id="btnClose" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" id="idTipoAsistencia" asp-for="@Model.tipoAsistencia.IdTipoAsistencia" />
                    <div>
                        <div class="col">
                            <label for="txtNombreTipoAsistencia" class="control-label">Tipo de Asistencia</label>
                            <input type="text" class="form-control" id="txtNombreTipoAsistencia" asp-for="@Model.tipoAsistencia.NombreTipoAsistencia" required></input>
                            <span asp-validation-for="@Model.tipoAsistencia.NombreTipoAsistencia" class="text-danger"></span>
                        </div>
                        <div class="col">
                            <label for="txtAbreviatura" class="control-label">Abreviatura</label>
                            <input type="text" class="form-control" id="txtAbreviatura" asp-for="@Model.tipoAsistencia.Abreviatura" required></input>
                            <span asp-validation-for="@Model.tipoAsistencia.Abreviatura" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <input type="submit" value="Guardar" class="btn btn-primary" />
                </div>
            </form>

        </div>
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function abrirModalYActualizarUrl(id) {
            if (id == 0) {
                var ventanaTitle = document.getElementById("lblModalTitle");
                ventanaTitle.textContent = "REGISTRO TIPO DE ASISTENCIA";

                $('#idTipoAsistencia').val(0);
                $('#txtNombreTipoAsistencia').val('');
                $('#txtAbreviatura').val('');
            }
            else {

                $.ajax({
                    url: `@ViewData["rutaApp"]/TipoAsistencia/ObtenerTipoAsistencia/${id}`, // URL para obtener los datos
                    type: 'GET',
                    success: function (data) {

                        console.log('data' + JSON.stringify(data));
                        // Llenar el formulario del modal con los datos del tipo de bodega
                        $('#idTipoAsistencia').val(id);
                        $('#txtNombreTipoAsistencia').val(data.nombreTipoAsistencia);
                        $('#txtAbreviatura').val(data.abreviatura);

                        var ventanaTitle = document.getElementById("lblModalTitle");
                        ventanaTitle.textContent = "MODIFICAR TIPO DE ASISTENCIA ";
                    },
                    error: function (xhr, status, error) {
                        console.error('Error al obtener los datos del tipo de asistencia:', error);
                    }
                });
            }

            var modal = new bootstrap.Modal(document.getElementById('wNewTipoAsistencia'));
            modal.show();

        }

        function confirmar(e){
            var res=confirm("Esta seguro de eliminar el tipo de asistencia");
            if (res) return true;
            if (res==false) e.preventDefault();

            //return false;
        }
    </script>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

