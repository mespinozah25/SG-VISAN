@model PROY.ViewModels.SubBodegaVM;
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous">
<head>
</head>
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    ViewData["Title"] = "Sub Bodegas";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@* <div class="=row">
        <div class="col-sm-8"> *@
<h2 class="float-start">Administración de Sub Bodegas</h2> <a class="btn btn-primary btn-sm float-end" onclick="abrirModalYActualizarUrl(0)"><i class="fas fa-plus-square"></i> Sub Bodega</a>
<p><br /></p>
<a class="btn btn-secondary btn-sm" asp-controller="Bodega" asp-action="Index"><i class="fas fa-warehouse"></i>&nbsp;Regresar a Bodegas</a>
<br />
<table class="table">
    <thead>
        <tr>
            <th>NOMBRE</th>
            <th>BODEGA</th>
            <th>OPCIONES</th>
        </tr>
    </thead>
    <tbody>
        @try
        {
            foreach (var item in Model.listaSubBodegas)
            {
                <tr>
                    <td>@item.NombreSubBodega</td>
                    <td>
                        @{
                            // Obtener la descripción usando el diccionario
                            string descripcionBodega = Model.BodegaDict.TryGetValue(item.IdBodega ?? 0, out var descBodega)
                            ? descBodega
                            : "Bodega no encontrado";
                        }
                        @descripcionBodega
                    </td>
                    <td class="text-center">
                        <a class="btn btn-info btn-sm" onclick="abrirModalYActualizarUrl(@item.IdSubBodega)"><i class="fas fa-edit"></i> Editar</a>
                        <a class="btn btn-danger btn-sm" asp-controller="SubBodega" asp-action="Eliminar" asp-route-id="@item.IdSubBodega" asp-route-idBodega="@item.IdBodega" onclick="confirmar(event)"><i class="fas fa-trash"></i> Eliminar</a>
                        <a class="btn btn-secondary btn-sm" asp-controller="Estiba" asp-action="Index" asp-route-idSubBodega="@item.IdSubBodega" asp-route-idBodega="@item.IdBodega"><i class="fas fa-box"></i>&nbsp;Estibas</a>
                    </td>

                </tr>
            }
        }
        catch
        {

        }

    </tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="wNewSubBodega" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="height:300px;">
            <form asp-action="GuardarSubBodega" asp-controller="SubBodega" method="post">
                <div class="modal-header bg-secondary">
                    <h5 class="modal-title text-white" id="lblModalTitle">@ViewBag.ModalTitle</h5>
                    <button type="button" id="btnClose" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" id="idSubBodega" asp-for="@Model.SubBodega.IdSubBodega" />
                    <div>
                        <div class="col">
                            <label for="txtNombreSubBodega" class="control-label">Nombre</label>
                            <input type="text" class="form-control" id="txtNombreSubBodega" asp-for="@Model.SubBodega.NombreSubBodega" required></input>
                            <span asp-validation-for="@Model.SubBodega.NombreSubBodega" class="text-danger"></span>
                        </div>
                        <div class="col">
                            <label for="cbIdBodega" class="control-label">Bodega</label>
                            <select disabled class="form-select" id="cbIdBodega" asp-for="@Model.SubBodega.IdBodega" asp-items="ViewBag.Bodegas" required></select>
                            <span asp-validation-for="@Model.SubBodega.IdBodega" class="text-danger"></span>
                        </div>
                        <input type="hidden" asp-for="@Model.SubBodega.IdBodega" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <input type="submit" value="Guardar" class="btn btn-primary" />
                </div>
            </form>

        </div>
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function abrirModalYActualizarUrl(id) {
            if (id == 0) {
                var ventanaTitle = document.getElementById("lblModalTitle");
                ventanaTitle.textContent = "REGISTRO SUB BODEGA";

                $('#idSubBodega').val(0);
                $('#txtNombreSubBodega').val('');
                $('#cbIdBodega').val();
            }
            else {

                $.ajax({
                    url: `@ViewData["rutaApp"]/SubBodega/ObtenerSubBodega/${id}`, // URL para obtener los datos
                    type: 'GET',
                    success: function (data) {

                        console.log('data' + JSON.stringify(data));
                        // Llenar el formulario del modal con los datos de la Sub Bodega
                        $('#idSubBodega').val(id);
                        $('#txtNombreSubBodega').val(data.nombre);
                        $('#cbIdBodega').val(data.idBodega);
                        //alert(id);

                        var ventanaTitle = document.getElementById("lblModalTitle");
                        ventanaTitle.textContent = "MODIFICAR SUB BODEGA ";
                    },
                    error: function (xhr, status, error) {
                        console.error('Error al obtener los datos de la sub bodega:', error);
                    }
                });
            }

            var modal = new bootstrap.Modal(document.getElementById('wNewSubBodega'));
            modal.show();

        }

        function confirmar(e){
            var res=confirm("Esta seguro de eliminar la sub bodega");
            if (res) return true;
            if (res==false) e.preventDefault();

            //return false;
        }
    </script>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

