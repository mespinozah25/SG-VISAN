@using PROY.Enum
@model PROY.ViewModels.JuntaDeRecepcionVM;
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous">
<head>
</head>
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    ViewData["Title"] = "Junta Receptora";
}
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}


<h2 class="float-start">Ingreso de Juntas Receptoras</h2>
@if (Model.Rol == "Operador de Logistica" || Model.Rol == "Admin")
{
    <a class="btn btn-primary btn-sm float-end" asp-controller="JuntaDeRecepcion" asp-action="JuntaReceptora" asp-route-id="0"><i class="fas fa-plus-square"></i> Crear Junta Receptora</a>
}
<p><br /></p>

<br />

<table class="table table-hover">
    <thead>
        <tr>
            <th>No.</th>
            <th>NÚMERO DE NOMBRAMIENTO</th>
            <th>ARCHIVO</th>
            <th>OPCIONES</th>
        </tr>
    </thead>
    <tbody>
        @try
        {
            int indexCount = 0;

            foreach (var item in Model.listaJuntaReceptora)
            {
                <tr>
                    <td>
                        @{
                            indexCount++;
                        }
                        @indexCount
                    </td>
                    <td>@item.NumeroNombramiento</td>
                    <td>
                        @if (item.ArchivoNombramiento != null && item.ArchivoNombramiento != "")
                        {
                            <a class="btn btn-info btn-sm" href="@Url.Action("DownloadFile", new { fileName =  @item.ArchivoNombramiento , carpeta = "nombramientos" })"><i class="fas fa-file-pdf"></i> Descargar Archivo</a>
                        }
                    </td>
                    <td class="text-center">

                        @if (Model.Rol == "Operador de Logistica" || Model.Rol == "Admin") // 1: Iniciada
                        {
                            <a class="btn btn-info btn-sm" asp-controller="JuntaDeRecepcion" asp-action="JuntaReceptora" asp-route-id="@item.IdJuntaReceptora" asp-route-type="1"><i class="fas fa-edit"></i> Editar</a>
                            <a class="btn btn-danger btn-sm" asp-controller="JuntaDeRecepcion" asp-action="Eliminar" asp-route-id="@item.IdJuntaReceptora" onclick="confirmar(event, this)"><i class="fas fa-trash"></i> Eliminar</a>

                        } else
                        {
                            <a class="btn btn-info btn-sm" asp-controller="JuntaDeRecepcion" asp-action="JuntaReceptora" asp-route-id="@item.IdJuntaReceptora" asp-route-type="2"><i class="fas fa-edit"></i> Ver Detalles</a>
                        }

                    </td>

                </tr>
            }
        }
        catch
        {

        }

    </tbody>
</table>



@section Scripts {

    <script>

        function confirmar(e, boton){

            e.preventDefault();

            Swal.fire({
                title: "Desea eliminar Junta Receptora?",
                text: "Este proceso eliminará la Junta Receptora.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Eliminar!"
            }).then((result) => {
                if (result.isConfirmed) {

                    Swal.fire({
                        title: "Eliminado!",
                        text: "Junta eliminada con éxito.",
                        icon: "success"
                    });

                    window.location.href = e.target.href;

                    return true;
                } else{
                    e.preventDefault();
                }
            });

        }
    </script>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>