@model PROY.ViewModels.UnidadMedidaVM;
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous">
<head>
</head>
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    ViewData["Title"] = "Unidades Medida";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}


@* <div class="=row">
        <div class="col-sm-8"> *@
<h2 class="float-start">Administración de Unidades de Medida</h2> <a class="btn btn-primary btn-sm float-end" onclick="abrirModalYActualizarUrl(0)"><i class="fas fa-plus-square"></i> Unidad de Medida</a>
<p><br /></p>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>UNIDAD DE MEDIDA</th>
            <th>PLURAL</th>
            <th>ABREVIATURA</th>
            <th>OPCIONES</th>
        </tr>
    </thead>
    <tbody>
        @try
        {
            foreach (var item in Model.listaUnidadMedida)
            {
                <tr>
                    <td>@item.IdUnidadMedida</td>
                    <td>@item.NombreUnidadMedida</td>
                    <td>@item.UMPlural</td>
                    <td>@item.Abreviatura</td>

                    <td class="text-center">
                        <a class="btn btn-info btn-sm" onclick="abrirModalYActualizarUrl(@item.IdUnidadMedida)"><i class="fas fa-edit"></i> Editar</a>
                        <a class="btn btn-danger btn-sm" asp-controller="UnidadMedida" asp-action="Eliminar" asp-route-id="@item.IdUnidadMedida" onclick="confirmar(event)"><i class="fas fa-trash"></i> Eliminar</a>
                    </td>

                </tr>
            }
        }
        catch
        {

        }

    </tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="wNewUnidadMedida" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="height:400px;">
            <form asp-action="GuardarUnidadMedida" asp-controller="UnidadMedida" method="post">
                <div class="modal-header bg-secondary">
                    <h5 class="modal-title text-white" id="lblModalTitle">@ViewBag.ModalTitle</h5>
                    <button type="button" id="btnClose" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" id="idUnidadMedida" asp-for="@Model.UnidadMedida.IdUnidadMedida" />
                    <div>
                        <div class="col">
                            <label for="txtNombreUnidadMedida" class="control-label">Unidad de Medida</label>
                            <input type="text" class="form-control" id="txtNombreUnidadMedida" asp-for="@Model.UnidadMedida.NombreUnidadMedida" required></input>
                            <span asp-validation-for="@Model.UnidadMedida.NombreUnidadMedida" class="text-danger"></span>
                        </div>
                        <div class="col">
                            <label for="txtNombreUnidadMedidaPlural" class="control-label">Unidad de Medida en Plural</label>
                            <input type="text" class="form-control" id="txtNombreUnidadMedidaPlural" asp-for="@Model.UnidadMedida.UMPlural" required></input>
                            <span asp-validation-for="@Model.UnidadMedida.UMPlural" class="text-danger"></span>
                        </div>
                        <div class="col">
                            <label for="txtAbreviatura" class="control-label">Abreviatura</label>
                            <input type="text" class="form-control" id="txtAbreviatura" asp-for="@Model.UnidadMedida.Abreviatura" required></input>
                            <span asp-validation-for="@Model.UnidadMedida.Abreviatura" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <input type="submit" value="Guardar" class="btn btn-primary" />
                </div>
            </form>

        </div>
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function abrirModalYActualizarUrl(id) {
            if (id == 0) {
                var ventanaTitle = document.getElementById("lblModalTitle");
                ventanaTitle.textContent = "REGISTRO DE UNIDAD DE MEDIDA";

                $('#idUnidadMedida').val(0);
                $('#txtNombreUnidadMedida').val('');
                $('#txtNombreUnidadMedidaPlural').val('');
                $('#txtAbreviatura').val('');
            }
            else {
                var ventanaTitle = document.getElementById("lblModalTitle");
                ventanaTitle.textContent = "MODIFICAR UNIDAD DE MEDIDA";
            }

            var modal = new bootstrap.Modal(document.getElementById('wNewUnidadMedida'));
            modal.show();

            $.ajax({
                url: `@ViewData["rutaApp"]/UnidadMedida/ObtenerUnidadMedida/${id}`, // URL para obtener los datos
                type: 'GET',
                success: function (data) {

                    console.log('data' + JSON.stringify(data));
                    // Llenar el formulario del modal con los datos de la solicitud
                    $('#idUnidadMedida').val(id);
                    $('#txtNombreUnidadMedida').val(data.nombre);
                    $('#txtNombreUnidadMedidaPlural').val(data.umplural);
                    $('#txtAbreviatura').val(data.abreviatura);
                    //alert(id);

                    var ventanaTitle = document.getElementById("lblModalTitle");
                    ventanaTitle.textContent = "MODIFICAR UNIDAD DE MEDIDA ";
                },
                error: function (xhr, status, error) {
                    console.error('Error al obtener los datos de la Unidad de Medida:', error);
                }
            });
        }

        function confirmar(e){
            var res=confirm("Esta seguro de eliminar la Unidad de Medida");
            if (res) return true;
            if (res==false) e.preventDefault();

            //return false;
        }
    </script>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>