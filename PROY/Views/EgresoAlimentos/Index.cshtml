@using PROY.Enum
@model PROY.ViewModels.EgresoAlimentosVM;
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous">
<head>
</head>
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    ViewData["Title"] = "Egreso Alimentos";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}


<h2 class="float-start">Egreso de Alimentos</h2> 
@if (Model.Rol == "Operador de Logística" || Model.Rol == "Admin")
{
    <a class="btn btn-primary btn-sm float-end" asp-controller="EgresoAlimentos" asp-action="EgresoAlimentos" asp-route-id="0" asp-route-type="1"><i class="fas fa-plus-square"></i> Egreso de Alimentos</a>
}
<p><br /></p>

<br />

<div class="">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>No.</th>
                <th>FECHA SOLICITUD</th>
                <th>DEPARTAMENTO SOLICITANTE</th>
                <th>TOTAL RACIONES</th>
                <th>TIPO DE ASISTENCIA</th>
                <th>TIPO DE SALIDA </th>
                <th>ESTADO</th>
                <th>OPCIONES</th>
            </tr>
        </thead>
        <tbody>
            @try
            {
                int indexCount = 0;

                foreach (var item in Model.listaEgresoAlimentos)
                {
                    <tr>
                        <td>
                            @{
                                indexCount++;
                            }
                            @indexCount
                        </td>
                        <td>@(item.FechaSolicitud?.ToString("dd/MM/yyyy") ?? "")</td>
                        <td>
                            @{
                                // Obtener la descripción usando el diccionario
                                string descripcionPrograma = Model.ProgramaDict.TryGetValue(item.IdPrograma ?? 0, out var descPrograma)
                                ? descPrograma
                                : "Programa no encontrado";
                            }
                            @descripcionPrograma
                        </td>
                        <td>@item.TotalRaciones</td>
                        <td>
                            @{
                                // Obtener el Estado usando el diccionario
                                string descripcionTipoAsis = Model.TipoAsistenciaDict.TryGetValue(item.IdTipoAsistencia ?? 0, out var desctipo)
                                ? desctipo
                                : "Tipo de asistencia no encontrado";
                            }
                            @descripcionTipoAsis
                        </td>
                        <td>
                            @{
                                // Obtener el Estado usando el diccionario
                                string descripcionTipo = item.IdTipoSalidaAlimento == (int)TipoSalidaEnum.EgresoAlimentos ? "Egreso de Alimentos" : "Traslado de Alimentos";
                            }
                            @descripcionTipo
                        </td>
                        <td>
                            @{
                                // Obtener el Estado usando el diccionario
                                TrasladoAlimentos traslado = new TrasladoAlimentos();

                                string descripcionEstado = Model.EstadoEgresoDict.TryGetValue(item.IdEstadoEgreso ?? 0, out var descEstado)
                                ? descEstado
                                : "Estado no encontrado";

                                if (item.IdEstadoEgreso == (int)EstadosEgresoEnum.EgresoFinalizado && item.IdTipoSalidaAlimento == (int)TipoSalidaEnum.TrasladoAlimentos) {

                                    traslado = Model.listaTrasladoAlimentos.Where(i => i.IdEgresoAlimentos == item.IdEgresoAlimentos).FirstOrDefault();

                                    if (traslado != null){
                                        descripcionEstado = Model.EstadoTrasladoDict.TryGetValue(traslado.IdEstadoTraslado ?? 0, out var descEstadoTras)
                                        ? descEstadoTras
                                        : "Estado no encontrado";
                                    }
                                }
                            }
                            @descripcionEstado
                        </td>
                        <td class="text-center">

                            @if (item.IdEstadoEgreso == (int)@EstadosEgresoEnum.Inicio) // 1: Iniciada && Rol se debe de cambiar por Jefe de Bodegas
                            {
                                @if (Model.Rol == "Operador de Logística" || Model.Rol == "Admin")
                                {
                                    <a class="btn btn-info btn-sm" asp-controller="EgresoAlimentos" asp-action="EgresoAlimentos" asp-route-id="@item.IdEgresoAlimentos" asp-route-type="2"> Ver </a>
                                    <a class="btn btn-info btn-sm" asp-controller="EgresoAlimentos" asp-action="EgresoAlimentos" asp-route-id="@item.IdEgresoAlimentos" asp-route-type="1"> Editar </a>

                                    var idUsuario = Model.listaBitacoraInicio.Where(o => o.IdRegistro == item.IdEgresoAlimentos).Select(s => s.IdUsuario).First();

                                    // Se valida que el mismo usuario que crea el ingreso, puede eliminarlos
                                    if (idUsuario == Model.IdUsuario)
                                    {
                                        <a class="btn btn-danger btn-sm" asp-controller="EgresoAlimentos" asp-action="EliminarEgresoAlimentos" asp-route-id="@item.IdEgresoAlimentos" onclick="confirmarEliminacionEgreso(event)"><i class="fas fa-trash"></i> Eliminar</a>
                                    }

                                    <a class="btn btn-info btn-sm" asp-controller="EgresoAlimentos" asp-action="CambioEstado" asp-route-id="@item.IdEgresoAlimentos" asp-route-estado="2" onclick="confirmarTraladoSinUsuario(event, 'Desea enviar el Egreso a Creación de Despacho')"> Crear Despacho </a>

                                }
                                else
                                {
                                    @* <a class="btn btn-info btn-sm" asp-controller="EgresoAlimentos" asp-action="EgresoAlimentos" asp-route-id="@item.IdEgresoAlimentos" asp-route-type="2"> Ver </a> *@
                                    string nombreVista = item.IdTipoSalidaAlimento == (int)TipoSalidaEnum.TrasladoAlimentos ? "Ver Traslado" : "Ver Egreso";
                                    <a class="btn btn-info btn-sm" asp-controller="EgresoAlimentos" asp-action="EgresoAlimentosFinalizado" asp-route-id="@item.IdEgresoAlimentos" asp-route-estado="1"> @nombreVista </a>
                                }
                            }
                            @if ((item.IdEstadoEgreso == (int)@EstadosEgresoEnum.CreacionDeDespacho || item.IdEstadoEgreso == (int)@EstadosEgresoEnum.RechazoEgresoDeAlimentos)) // 2: Bodega, 4: Rechazo && Rol se debe de cambiar por Técnico
                            {
                                @if (Model.Rol == "Operador de Logística" || Model.Rol == "Admin")
                                {
                                    <a class="btn btn-info btn-sm" asp-controller="EgresoAlimentos" asp-action="DespachoAlmacen" asp-route-id="@item.IdEgresoAlimentos" asp-route-type="1"> Crear Despacho </a>
                                    <a class="btn btn-info btn-sm" onclick="CambioEstado(@item.IdEgresoAlimentos, 3)"> Enviar a Bodega </a>
                                }
                                else
                                {
                                    @* <a class="btn btn-info btn-sm" asp-controller="EgresoAlimentos" asp-action="DespachoAlmacen" asp-route-id="@item.IdEgresoAlimentos" asp-route-type="2"> Ver Despacho </a> *@
                                    string nombreVista = item.IdTipoSalidaAlimento == (int)TipoSalidaEnum.TrasladoAlimentos ? "Ver Traslado" : "Ver Egreso";
                                    var estado = item.IdEstadoEgreso == (int)@EstadosEgresoEnum.RechazoEgresoDeAlimentos ? 4 : 2;
                                    <a class="btn btn-info btn-sm" asp-controller="EgresoAlimentos" asp-action="EgresoAlimentosFinalizado" asp-route-id="@item.IdEgresoAlimentos" asp-route-estado="@estado"> @nombreVista </a>
                                }
                            }
                            @if (item.IdEstadoEgreso == (int)@EstadosEgresoEnum.EnBodega) // 3: En Bodega 
                            {
                                @if (Model.IdUsuario == item.IdUsuarioEncargadoBodega || Model.Rol == "Admin")
                                {
                                    <a class="btn btn-info btn-sm" asp-controller="EgresoAlimentos" asp-action="RevisionEgreso" asp-route-id="@item.IdEgresoAlimentos" asp-route-type="1"> Revisión Sanitaria </a>
                                }
                                else
                                {
                                    @* <a class="btn btn-info btn-sm" asp-controller="EgresoAlimentos" asp-action="RevisionEgreso" asp-route-id="@item.IdEgresoAlimentos" asp-route-type="2"> Ver Revisión Sanitaria </a> *@
                                    string nombreVista = item.IdTipoSalidaAlimento == (int)TipoSalidaEnum.TrasladoAlimentos ? "Ver Traslado" : "Ver Egreso";
                                    <a class="btn btn-info btn-sm" asp-controller="EgresoAlimentos" asp-action="EgresoAlimentosFinalizado" asp-route-id="@item.IdEgresoAlimentos" asp-route-estado="3"> @nombreVista </a>
                                } 
                            }
                            @if (item.IdEstadoEgreso == (int)@EstadosEgresoEnum.ApruebaEgresoDeAlimentos) // 5: Aprueba Egreso de Alimentos
                            {
                                @if (Model.Rol == "Encargado de Bodega" || Model.Rol == "Admin")
                                {
                                    <a class="btn btn-info btn-sm" asp-controller="EgresoAlimentos" asp-action="FinalizacionDespacho" asp-route-id="@item.IdEgresoAlimentos" asp-route-type="1"> Registrar Salida </a>
                                }
                                else
                                {
                                    @* <a class="btn btn-info btn-sm" asp-controller="EgresoAlimentos" asp-action="FinalizacionDespacho" asp-route-id="@item.IdEgresoAlimentos" asp-route-type="2"> Ver Registro Salida </a> *@
                                    string nombreVista = item.IdTipoSalidaAlimento == (int)TipoSalidaEnum.TrasladoAlimentos ? "Ver Traslado" : "Ver Egreso";
                                    <a class="btn btn-info btn-sm" asp-controller="EgresoAlimentos" asp-action="EgresoAlimentosFinalizado" asp-route-id="@item.IdEgresoAlimentos" asp-route-estado="5"> @nombreVista </a>
                                }
                            }
                            @if (item.IdEstadoEgreso == (int)@EstadosEgresoEnum.EgresoFinalizado && item.IdTipoSalidaAlimento == (int)TipoSalidaEnum.EgresoAlimentos) // 6: Finalización del Egreso
                            {
                                string nombreVista = item.IdTipoSalidaAlimento == (int)TipoSalidaEnum.TrasladoAlimentos ? "Ver Traslado" : "Ver Egreso";
                                <a class="btn btn-info btn-sm" asp-controller="EgresoAlimentos" asp-action="EgresoAlimentosFinalizado" asp-route-id="@item.IdEgresoAlimentos" asp-route-estado="6"> @nombreVista </a>
                            }

                            @* Traslados *@
                            @if (item.IdEstadoEgreso == (int)@EstadosEgresoEnum.EgresoFinalizado && item.IdTipoSalidaAlimento == (int)TipoSalidaEnum.TrasladoAlimentos && traslado.IdEstadoTraslado == (int)EstadosTrasladoEnum.RecibiendoTraslado) // 7: Aprueba Egreso && Rol se debe de cambiar por Encargado de Bodegas
                            {
                                @if (Model.IdUsuario == item.IdUsuarioRecibeTraslado || Model.Rol == "Admin")
                                {
                                    <a class="btn btn-info btn-sm" asp-controller="EgresoAlimentos" asp-action="RecepcionTraslado" asp-route-id="@item.IdEgresoAlimentos" asp-route-type="1"> Recibir Traslado </a>
                                }
                                else
                                {
                                    @* <a class="btn btn-info btn-sm" asp-controller="EgresoAlimentos" asp-action="RecepcionTraslado" asp-route-id="@item.IdEgresoAlimentos" asp-route-type="2"> Recibir Traslado </a> *@
                                    string nombreVista = item.IdTipoSalidaAlimento == (int)TipoSalidaEnum.TrasladoAlimentos ? "Ver Traslado" : "Ver Egreso";
                                    <a class="btn btn-info btn-sm" asp-controller="EgresoAlimentos" asp-action="EgresoAlimentosFinalizado" asp-route-id="@item.IdEgresoAlimentos" asp-route-estado="7"> @nombreVista </a>
                                }
                                
                            }
                            @if (item.IdEstadoEgreso == (int)@EstadosEgresoEnum.EgresoFinalizado && item.IdTipoSalidaAlimento == (int)TipoSalidaEnum.TrasladoAlimentos && traslado.IdEstadoTraslado == (int)EstadosTrasladoEnum.TrasladoFinalizado) // 8: Finalización del Traslado
                            {
                                string nombreVista = item.IdTipoSalidaAlimento == (int)TipoSalidaEnum.TrasladoAlimentos ? "Ver Traslado" : "Ver Egreso";
                                <a class="btn btn-info btn-sm" asp-controller="EgresoAlimentos" asp-action="EgresoAlimentosFinalizado" asp-route-id="@item.IdEgresoAlimentos" asp-route-estado="8"> @nombreVista </a>
                            }

                        </td>

                    </tr>
                }
            }
            catch
            {

            }

        </tbody>
    </table>
</div>

<!-- Modal -->
<div class="modal fade" id="wCambioEstado" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="height:100%;">

            <form id="frmCambioEstado">
                <input type="hidden" id="idEgresoAlimentos" value="0" />
                <div class="modal-header bg-secondary">
                    <h5 class="modal-title text-white" id="lblModalTitle">Traslado de Egreso</h5>
                    <button type="button" id="btnClose" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div>
                        <div class="col">
                            <label for="cbIdUsuario" class="control-label">Usuario: *</label>
                            <select class="form-select" id="cbIdUsuario" required></select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <a id="btnEnviar" class="btn btn-info btn" onclick="confirmar()"> Enviar </a>
                </div>
            </form>

        </div>
    </div>
</div>


@section Scripts {

    <script>

        
        function CambioEstado(id, estado){

            $.ajax({
                url: `@ViewData["rutaApp"]/EgresoAlimentos/ObtenerUsuariosEncargadosBodega`, // URL para obtener los datos
                type: 'GET',
                success: function (data) {

                    var usuarios = data.usuarios;

                    let selectUsuario = $('#cbIdUsuario');
                    selectUsuario.empty(); // Limpiar opciones previas
                    let optionsUsuarios = "";

                    usuarios.forEach(uss => {
                            optionsUsuarios += `<option value="${uss.idUsuario}">${uss.nombre} ${uss.apellidos}</option>`;
                    });

                    selectUsuario.append(optionsUsuarios);
                },
                error: function (xhr, status, error) {
                    console.error('Error al obtener los datos de usuarios: ', error);
                }
            });

            $("#idEgresoAlimentos").val(parseInt(id));

            var modal = new bootstrap.Modal(document.getElementById('wCambioEstado'));
            modal.show();
        }

        function confirmar(){

            Swal.fire({
              title: "Está seguro de enviar el Egreso de Alimentos al Logísitica?",
              showCancelButton: true,
              confirmButtonText: "Enviar",
              icon: "question"
            }).then((result) => {
              if (result.isConfirmed) {

                  var id = parseInt($("#idEgresoAlimentos").val());
                  var estado = 3;
                  var idTipoSalidaAlimento = 0;
                  var idUsuario = parseInt($('#cbIdUsuario').val());

                $.ajax({
                    url: `@ViewData["rutaApp"]/EgresoAlimentos/CambioEstado`, // Ruta del método
                    type: 'POST',
                    data: { 'id': id, 'estado': estado, 'idTipoSalidaAlimento': idTipoSalidaAlimento, 'idUsuario': idUsuario },
                    success: function (response) {

                        location.reload(); // Recargar la página
                    },
                    error: function (xhr, status, error) {
                        console.error("❌ Error al cambiar estado:", xhr.responseText);
                        alert("Hubo un error al cambiar el estado. Verifica la consola.");
                    }
                });
                  
                  return true;
              } else{
                  // e.preventDefault();
              }
            });
        }

        function confirmarEliminacionEgreso(e){

            e.preventDefault();

            Swal.fire({
                title: "Desea eliminar el Egreso de Alimentos?",
                text: "Este proceso eliminará el Egreso de Alimentos.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Eliminar!"
            }).then((result) => {
                if (result.isConfirmed) {

                    Swal.fire({
                        title: "Eliminado!",
                        text: "Egreso eliminado con éxito.",
                        icon: "success"
                    });

                    window.location.href = e.target.href;

                    return true;
                } else{
                    e.preventDefault();
                }
            });

        }

        function confirmarTraladoSinUsuario(e, mensaje){

            e.preventDefault();

            Swal.fire({
              title: mensaje,
              showCancelButton: true,
              confirmButtonText: "Enviar",
              icon: "question"
            }).then((result) => {
              if (result.isConfirmed) {

                  window.location.href = e.target.href;

                  return true;
              } else{
                  e.preventDefault();
              }
            });

        }
    </script>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
