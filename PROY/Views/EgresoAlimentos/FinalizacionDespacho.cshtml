<head>
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous">
</head>

<style>
    table thead th {
        pointer-events: none; /* Desactiva la interacción con los títulos */
    }
</style>

@model PROY.ViewModels.EgresoAlimentosVM

@{
    ViewData["Title"] = "Finalización";
}

<h1>Finalización Despacho de Almacén</h1>

<br />

<div>
    <form id="frmFinalizacion">

        <input type="hidden" id="idEgresoAlimentos" asp-for="@Model.EgresoAlimentos.IdEgresoAlimentos" />
        <input type="hidden" id="idTipoSalidaAlimentos" asp-for="@Model.EgresoAlimentos.IdTipoSalidaAlimento" />

        <br />

        <div class="row">
            <div class="col">
                <label for="txtFechaSolicitud" class="control-label"><b> Fecha de Solicitud </b></label>
                <input class="form-control" id="txtFechaSolicitud" disabled>
            </div>
            <div class="col">
                <label for="txtTotalRaciones" class="control-label"><b> Total de Raciones </b></label>
                <input class="form-control" id="txtTotalRaciones" disabled>
            </div>
            <div class="col">
                <label for="txtTipoAsistencia" class="control-label"><b> Tipo de Asistencia </b></label>
                <input class="form-control" id="txtTipoAsistencia" disabled>
            </div>
        </div>

        <br />

        <div class="row">
            <div class="col">
                <label for="txtDepartamentoSolicitante" class="control-label"><b> Departamento Solicitante </b></label>
                <input class="form-control" id="txtDepartamentoSolicitante" disabled>
                <input type="hidden" id="cbIdPrograma" disabled>
            </div>
            <div class="col">
                <label for="noDespachoAlmacen" class="control-label">No. Despacho de Almacén</label>
                <input type="text" class="form-control" id="noDespachoAlmacen" disabled>
            </div>
        </div>

        <br />

        <div class="row">
            <div class="col">
                <label for="cbIdDepartamentoCarga" class="control-label">Departamento de Carga</label>
                <input class="form-control" id="cbIdDepartamentoCarga" disabled>
            </div>
            <div class="col">
                <label for="cbIdBodegaCarga" class="control-label">Bodega de Carga</label>
                <input class="form-control" id="cbIdBodegaCarga" disabled>
            </div>
            <div class="col">
                <label for="noAutorizacion" class="control-label">No. de Autorizacion</label>
                <input type="text" class="form-control" id="noAutorizacion" disabled>
            </div>
        </div>

        <br />

        <div class="row">
            <div class="col">
                <label for="cbIdDepartamentoDetino" class="control-label">Departamento de Destino</label>
                <input class="form-control" id="cbIdDepartamentoDetino" disabled>
            </div>
            <div class="col">
                <label for="cbIdMunicipioDestino" class="control-label">Municipio de Destino</label>
                <input class="form-control" id="cbIdMunicipioDestino" disabled>
            </div>
            <div class="col">
                <label for="direccionFinal" class="control-label">Dirección Final</label>
                <input type="text" class="form-control" id="direccionFinal" disabled>
            </div>
        </div>

        <br />
        <br />


        <h3>Creación de Constancias de Salida de Alimentos (Parciales)</h3>

        <br />

        <div class="row">
            <div class="col">
                <label for="txtNoConstancia" class="control-label">No. Constancia</label>
                <input type="text" class="form-control" id="txtNoConstancia" required>
            </div>
            <div class="col">
                <label for="txtFechaDespacho" class="control-label">Fecha de Despacho</label>
                <input type="date" class="form-control" id="txtFechaDespacho" required>
            </div>
        </div>

        <br />

        <div class="row">
            <div class="col">
                <label for="txtNombreTransportista" class="control-label">Nombre Transportista</label>
                <input type="text" class="form-control" id="txtNombreTransportista" required>
                <input type="hidden" class="form-control" id="idTransportista" value="0">
            </div>
        </div>

        <br />

        <div class="row">
            <div class="col">
                <label for="txtPlacasTransporte" class="control-label">Placas del Transporte</label>
                <input type="text" class="form-control" id="txtPlacasTransporte" required>
                <input type="hidden" class="form-control" id="idVehiculo" value="0">
            </div>
            <div class="col" style="display:none">
                <label for="txtNoTrailer" class="control-label">No. Trailer</label>
                <input class="form-control" id="txtNoTrailer" >
            </div>
        </div>

        <br />

        <div class="row">
            <div class="col">
                <label for="txtNombrePiloto" class="control-label">Nombre del Piloto</label>
                <input type="text" class="form-control" id="txtNombrePiloto" required>
                <input type="hidden" class="form-control" id="idPiloto" value="0">
            </div>
            <div class="col-4">
                <label for="NoLicencia" class="control-label">No. Licencia Piloto / DPI</label>
                <input type="text" class="form-control" id="txtNoLicencia">
            </div>
        </div>

        @* <h3>Detalle de la Carga</h3> *@
        
        <div class="row" style="display:none">
            <div class="col">
                <label for="cbIdProductoAlimenticio" class="control-label">Producto Alimenticio</label>
                <select class="form-select" id="cbIdProductoAlimenticio" asp-items="ViewBag.ProductoAlimenticio"></select>
            </div>
            <div class="col">
                <label for="cbIdPresentacionPA" class="control-label">Presentación</label>
                <select class="form-select" id="cbIdPresentacionPA" asp-items="ViewBag.PresentacionPA"></select>
            </div>
            <div class="col">
                <label for="cbIdUnidadMedida" class="control-label">Unidad de Medida</label>
                <select class="form-select" id="cbIdUnidadMedida" asp-items="ViewBag.UnidadMedida"></select>
            </div>
            <div class="col">
                <label for="cbIdTransportista" class="control-label">Nombre Transportista</label>
                <select class="form-select" id="cbIdTransportista" asp-items="ViewBag.Transportistas"></select>
            </div>
            <div class="col">
                <label for="cbIdVehiculo" class="control-label">Placas del Transporte</label>
                <select class="form-select" id="cbIdVehiculo" asp-items="ViewBag.Vehiculos" onchange="return BusquedaVehiculo();"></select>
            </div>
            <div class="col">
                <label for="cbIdPiloto" class="control-label">Nombre del Piloto</label>
                <select class="form-select" id="cbIdPiloto" asp-items="ViewBag.Pilotos" onchange="return BusquedaLicencia();" required></select>
            </div>
        </div>

        <br />
        <br />

        <divr class="row">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="checkAll">
                <label class="form-check-label" for="flexSwitchCheckDefault">Seleecionar todo</label>
            </div>
        </divr>

        <div class="row col-12">
            <div class="">
                <table id="tableDetalle" class="table table-hover" width="100%">
                    <thead>
                        <tr>
                            <th width="5%">No.</th>
                            <th width="10%">SELEC.</th>
                            <th width="10%">CANT. A RETIRAR</th>
                            <th width="45%">ESTIBA</th>
                            <th width="15%">PRODUCTO</th>
                            <th width="5%">CANT. UNIDAD</th>
                            <th width="5%">UNIDAD MEDIDA</th>
                            <th width="5%">CANT. A RECIBIR</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <br />

        <br class="camposAlmacenamiento" />

        <div class="float-end camposAlmacenamiento">
            <a type="button" href="#" class="btn btn-secondary" onclick="return LimpiarDetalles();">Limpiar</a>
            <a type="button" href="#" class="btn btn-primary" onclick="return GuardarSolicitudSalida();">Agregar Detalle</a>
        </div>

        <br />
        <br />

        <h4>Listado de solicitudes de Salida de Alimentos</h4>

        <br />

        <div class="row col-12">
            <div class="">
                <table id="tableSolicitudes" class="table table-hover" width="100%">
                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>No. SOLICITUD</th>
                            <th>FECHA DESPACHO</th>
                            <th>PLACAS TRANSPORTE</th>
                            <th>NOMBRE PILOTO</th>
                            <th>ACCIONES</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <br />
        <br />

        <div class="row float-end">
            <div class="col">
                <a type="button" class="btn btn-secondary btn" asp-action="Index">Regresar</a>
            </div>
            <div class="col">
                <input type="button" value="Guardar" class="btn btn-primary" onclick="return ConfirmSave();" />
                @* <a class="btn btn-info btn-sm" asp-controller="EgresoAlimentos" asp-action="CambioEstado" asp-route-id="@Model.EgresoAlimentos.IdEgresoAlimentos" asp-route-estado="8" asp-route-idTipoSalidaAlimento="@Model.EgresoAlimentos.IdTipoSalidaAlimento" onclick="confirmarFinalizacion(event)"> Enviar a Bodega </a> *@
            </div>
        </div>

        <br />

    </form>
</div>


<!-- Modal -->
