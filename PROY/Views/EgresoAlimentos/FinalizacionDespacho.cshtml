@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $( document ).ready(function() {

            $(".table tbody").empty();
            $('#tableDetalle_paginate').hide();
            $('#tableDetalle_info').hide();
            $('#tableDetalle_filter').hide();

            $('#tableSolicitudes_paginate').hide();
            $('#tableSolicitudes_info').hide();
            $('#tableSolicitudes_filter').hide();

            $('#tableMdlDetalle_paginate').hide();
            $('#tableMdlDetalle_info').hide();
            $('#tableMdlDetalle_filter').hide();

            var urlObj = new URL(window.location.href);
            var type = urlObj.searchParams.get("type");
            var id = window.location.pathname.split('/').pop();

            // Inicializa la tabla (si no está inicializada)
            var table = $('.table').DataTable();

            // Oculta las flechas de ordenamiento
            $('table.dataTable thead th').removeClass('sorting sorting_asc sorting_desc');

            if (parseInt(id) != 0){
                abrirYActualizarUrl(id, type);
            }
        });

        function abrirYActualizarUrl(id, tipoApertura) {

            // Se inicia reiniciando la tabla
             $("#tableDetalle tbody").empty();
             $("#tableSolicitudes tbody").empty();

            // El tipo de apertura 1 indica que se va almacenar o editar un registro
            // El tipo de apertura 2 indica solo de observación
            if(tipoApertura == 1){
                $('.camposAlmacenamiento').show();
                $("#frmFinalizacion input:not([disabled])").attr("disabled", false);  // Hace los inputs solo lectura
                $("#frmFinalizacion select").prop("disabled", false); // Deshabilita los selects
            }else{
                $('.camposAlmacenamiento').hide();
                $("#frmFinalizacion input").attr("disabled", true);  // Hace los inputs solo lectura
                $("#frmFinalizacion select").prop("disabled", true); // Deshabilita los selects
            }

            if (id == 0) {

                $('#noDespachoAlmacen').val();
                $('#cbIdDepartamentoCarga').val(0);
                $('#cbIdBodegaCarga').val(0);
                $('#noAutorizacion').val();
                $('#cbIdDepartamentoDetino').val(0);
                $('#cbIdMunicipioDestino').val(0);
                $('#direccionFinal').val();
                $('#comentarios').val();

            }
            else {

                $.ajax({
                    url: `@ViewData["rutaApp"]/EgresoAlimentos/ObtenerFinalizacionDespacho/${id}`, // URL para obtener los datos
                    type: 'GET',
                    success: function (data) {

                        console.log('data' + JSON.stringify(data));

                        var ea = data.egresoAlimentos;

                        // Llenar el formulario con los datos de Egreso de Alimentos
                        $('#idEgresoAlimentos').val(ea.idEgresoAlimentos);
                        $('#txtFechaSolicitud').val(new Date(ea.fechaSolicitud).toLocaleDateString('es-ES'));
                        $('#txtTotalRaciones').val(ea.totalRaciones);
                        $('#txtTipoAsistencia').val(data.tipoAsistencia);
                        $('#txtDepartamentoSolicitante').val(data.programa);
                        $('#cbIdPrograma').val(ea.idPrograma);
                        $('#noDespachoAlmacen').val(ea.noDespachoAlmacen);
                        $('#cbIdDepartamentoCarga').val(data.departamentoCarga);
                        $('#cbIdBodegaCarga').val(data.bodegaCarga);
                        $('#noAutorizacion').val(ea.noAutorizacion);
                        $('#cbIdDepartamentoDetino').val(data.departamentoDestino);
                        $('#cbIdMunicipioDestino').val(data.municipioDestino);
                        $('#direccionFinal').val(ea.direccionFinal);
                        $('#comentarios').val(ea.comentarios);

                        BusquedaLicencia();
                        BusquedaVehiculo();

                        // Agregar Detalle
                        if (data.detEgresoAlimentos.length > 0){

                            let tabla = document.getElementById("tableDetalle");
                            let tbody = tabla.getElementsByTagName("tbody")[0];

                            data.detEgresoAlimentos.forEach((detalle, index) => {

                                let fila = document.createElement("tr");

                                let txtProducto = $("#cbIdProductoAlimenticio option[value='" + detalle.idProductoAlimenticio + "']").text(); // Nombre del producto
                                let txtpresentacion = $("#cbIdPresentacionPA option[value='" + detalle.idPresentacion + "']").text(); // Nombre de la presentación
                                let cantidadUnidad = detalle.cantidadUnidad;
                                let txtUnidad = $("#cbIdUnidadMedida option[value='" + detalle.idUnidadMedida + "']").text(); // Nombre de la unidad de medida
                                let noUnidades = detalle.noUnidades;

                                var botoncheck = '<input class="form-check-input" type="checkbox" name="checkRow">';

                                var campoCantidad = `<input type="number" class="form-control" min="1" max="${noUnidades}" name="CantidadSalida" value="${noUnidades}">`;

                                var campoEstadoProducto = `<input type="hidden" class="form-control" name="EstadoProducto" value="BUEN ESTADO">`;

                                var campoEstiba = `<input type="text" class="form-control" name="EstibaEgreso" value="${detalle.estibaEgreso ?? ''}">`;

                                fila.innerHTML = `
                                    <td>${index + 1}</td>
                                    <td>
                                        ${botoncheck}

                                        <input type="hidden" name="IdDetalleEgresoAlimentos" value="${detalle.idDetalleEgresoAlimentos}">
                                        <input type="hidden" name="IdEgresoAlimentos" value="${detalle.idEgresoAlimentos}">
                                        <input type="hidden" name="IdProductoAlimenticio" value="${detalle.idProductoAlimenticio}">
                                        <input type="hidden" name="CantidadUnidad" value="${cantidadUnidad}">
                                        <input type="hidden" name="IdUnidadMedida" value="${detalle.idUnidadMedida}">
                                        <input type="hidden" name="NoUnidades" value="${noUnidades}">
                                        ${campoEstadoProducto}
                                         
                                    </td>
                                    <td>${campoCantidad}</td>
                                    <td>${campoEstiba}</td>
                                    <td>${txtProducto}</td>
                                    <td>${cantidadUnidad}</td>
                                    <td>${txtUnidad}</td>
                                    <td>${noUnidades}</td>
                                `;

                                tbody.appendChild(fila);
                            });
                        }
                        cargaDetalleSolicitudes(true);
                    },
                    error: function (xhr, status, error) {
                        console.error('Error al obtener los datos de Egreso de alimentos: ', error);
                    }
                });
            }
        }

        function cargaDetalleSolicitudes(apertura){

            var id = $("#idEgresoAlimentos").val();
            $("#tableSolicitudes tbody").empty();

            $.ajax({
                url: `@ViewData["rutaApp"]/EgresoAlimentos/ObtenerSolicitudesSalida/${id}`, // URL para obtener los datos
                type: 'GET',
                success: function (data) {

                    console.log('data' + JSON.stringify(data));
                        
                    // Agregar Constancias de salida
                    if (data.listaSolicitudSalidaAlimentos.length > 0){

                        let tabla = document.getElementById("tableSolicitudes");
                        let tbody = tabla.getElementsByTagName("tbody")[0];

                        data.listaSolicitudSalidaAlimentos.forEach((detalle, index) => {

                            let fila = document.createElement("tr");

                            let txtPrograma = $("#cbIdProgramaSolicitud option[value='" + detalle.idPrograma + "']").text(); // Nombre del programa
                            let txtTransportista = $("#cbIdTransportista option[value='" + detalle.idTransportista + "']").text(); // Nombre del transportista
                            let fechaDespacho = new Date(detalle.fechaDespacho).toLocaleDateString('es-ES');
                            let txtPiloto = $("#cbIdPiloto option[value='" + detalle.idPiloto + "']").text(); // Nombre del piloto

                            var botonEliminar = `<button type="button" class="btn btn-danger btn-sm camposAlmacenamiento" onclick="ConfirmDelete(this, ${detalle.idSolicitudSalidaAlimentos})">Eliminar</button>`;

                            var verProductos = `<button type="button" class="btn btn-info btn-sm camposAlmacenamiento" onclick="VerProductosSolicitudes(this, ${detalle.idSolicitudSalidaAlimentos})"> Ver Productos</button>`;

                            fila.innerHTML = `
                                <td>${index + 1}</td>
                                <td>${detalle.noConstancia}</td>
                                <td>${fechaDespacho}</td>
                                <td>${txtTransportista}</td>
                                <td>${txtPiloto}</td>
                                <td>
                                    ${botonEliminar}
                                    ${verProductos}
                                    <input type="hidden" name="IdSolicitudSalidaAlimentos" value="${detalle.idSolicitudSalidaAlimentos}">
                                    <input type="hidden" name="IdEgresoAlimentos" value="${detalle.idEgresoAlimentos}">
                                    <input type="hidden" name="NoConstancia" value="${detalle.noConstancia}">
                                    <input type="hidden" name="FechaDespacho" value="${detalle.fechaDespacho}">
                                    <input type="hidden" name="IdPrograma" value="${detalle.idPrograma}">
                                    <input type="hidden" name="IdTransportista" value="${detalle.idTransportista}">
                                    <input type="hidden" name="IdPiloto" value="${detalle.idPiloto}">
                                    <input type="hidden" name="IdVehiculo" value="${detalle.idVehiculo}">
                                </td>
                            `;

                            tbody.appendChild(fila);
                        });

                        if (apertura && data.listaSolicitudSalidaAlimentos.length > 0)
                            CalcularDetallesProductos(data.listaDetalleSalidaAlimentos, 1);
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error al obtener los datos de Egreso de alimentos: ', error);
                }
            });
        }

        // detalles: listado de productos almacenados en DetallesSalidaAlimentos; 
        // type: 1) calculo inicial de resta con los detalles; 2) eliminación de una constancia para sumar los detalles
        function CalcularDetallesProductos(detallesSalida, type){

            detallesSalida.forEach((detalle, index) => {

                $("#tableDetalle tbody tr").each(function () {
                    let fila = $(this);

                    var idProd = fila.find("input[name='IdProductoAlimenticio']").val();
                    var idPres = fila.find("input[name='IdPresentacion']").val();
                    var cantUni = fila.find("input[name='CantidadUnidad']").val();
                    var idUnid = fila.find("input[name='IdUnidadMedida']").val();

                    // Se busca el producto exacto que se tomo para validar el total que le corresponde 
                    if (idProd == detalle.idProductoAlimenticio && idPres  == detalle.idPresentacion && cantUni == detalle.cantidadUnidad && idUnid == detalle.idUnidadMedida){

                        if (type == 1){
                            // Se restará la cantidad seleccionada de salida con la cantidad que se habia ingresado para comprobar que no se pueda seleccionar ese producto
                            if (detalle.cantidadSalida == parseInt(fila.find("input[name='NoUnidades']").val())){
                                fila.find("input[name='checkRow']").prop("disabled", true);
                                fila.find("input[name='CantidadSalida']").val("");
                                fila.find("input[name='CantidadSalida']").attr("disabled", true);
                                fila.find("input[name='EstadoProducto']").val("");
                                fila.find("input[name='EstadoProducto']").attr("disabled", true);

                                fila.find("input[name='NoUnidades']").val(0);
                                fila.find("td:eq(8)").text(0);
                            } else {
                                // En caso de que no sea el total, se actualiza a la cantidad restante
                                var nuevaCantidad = parseInt(fila.find("input[name='NoUnidades']").val()) - parseInt(detalle.cantidadSalida);

                                fila.find("input[name='NoUnidades']").val(nuevaCantidad);
                                fila.find("input[name='CantidadSalida']").attr("max", nuevaCantidad);
                                fila.find("input[name='CantidadSalida']").val(nuevaCantidad);

                                // Actualizar el valor en la novena celda (índice 8)
                                fila.find("td:eq(8)").text(nuevaCantidad);
                            }

                            fila.find("input[name='checkRow']").prop("checked", false);
                        }
                        else {
                            // Se suman los valores que se habían agregado al detalle
                            var nuevaCantidad = parseInt(fila.find("input[name='NoUnidades']").val()) + parseInt(detalle.cantidadSalida);

                            fila.find("input[name='NoUnidades']").val(nuevaCantidad);
                            fila.find("td:eq(8)").text(nuevaCantidad);
                            fila.find("input[name='CantidadSalida']").attr("max", nuevaCantidad);
                            fila.find("input[name='CantidadSalida']").val(nuevaCantidad);

                            fila.find("input[name='checkRow']").prop("disabled", false);
                            fila.find("input[name='CantidadSalida']").attr("disabled", false);
                            fila.find("input[name='EstadoProducto']").attr("disabled", false);
                        }
                    }  
                });
            });
        }

        function VerProductosSolicitudes(tr, id){

            $("#tableMdlDetalle tbody").empty();

            $.ajax({
                url: `@ViewData["rutaApp"]/EgresoAlimentos/ObtenerDetallesSolicitudSalida/${id}`, // URL para obtener los datos
                type: 'GET',
                success: function (data) {

                    console.log('data' + JSON.stringify(data));

                    var ea = data.solicitudSalida;

                    // Llenar el formulario con los datos de Egreso de Alimentos
                    $('#txtMdlNoConstancia').val(ea.noConstancia);
                    $('#txtMdlFechaDespacho').val(new Date(ea.fechaDespacho).toLocaleDateString('es-ES'));
                    $('#txtMdlPlacasTransporte').val(data.placas);
                    $('#txtMdlNombrePiloto').val(data.nombrePiloto);

                    // Agregar Detalles de Salida
                    if (data.listaSolicitudSalidaAlimentos.length > 0){

                        let tabla = document.getElementById("tableMdlDetalle");
                        let tbody = tabla.getElementsByTagName("tbody")[0];

                        data.listaSolicitudSalidaAlimentos.forEach((detalle, index) => {

                            let fila = document.createElement("tr");

                            let txtProducto = $("#cbIdProductoAlimenticio option[value='" + detalle.idProductoAlimenticio + "']").text(); // Nombre del producto
                            var estadoProducto = detalle.estadoProducto ?? " ";

                            fila.innerHTML = `
                                <td>${index + 1}</td>
                                <td>${txtProducto}</td>
                                <td>${detalle.cantidadSalida}</td>
                                <td>${estadoProducto}</td>
                            `;

                            tbody.appendChild(fila);
                        });
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error al obtener los datos de Egreso de alimentos: ', error);
                }
            });

            var modal = new bootstrap.Modal(document.getElementById('wViewDetalles'));
            modal.show();
        }

        document.getElementById("checkAll").addEventListener("click", function () {
            let isChecked = this.checked;
            document.querySelectorAll("#tableDetalle input[name='checkRow']:not(:disabled)").forEach(checkbox => {
                checkbox.checked = isChecked;
            });
        });

