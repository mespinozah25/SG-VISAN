                        </div>
                    </div>

                    <br />

                    <div class="row">
                        <div class="col">
                            <label for="txtMdlFechaDespacho" class="control-label"><b> Fecha de Despacho </b></label>
                            <input class="form-control" id="txtMdlFechaDespacho" disabled>
                        </div>
                        <div class="col">
                            <label for="txtMdlPlacasTransporte" class="control-label"><b> Placas Transporte </b></label>
                            <input class="form-control" id="txtMdlPlacasTransporte" disabled>
                        </div>
                        <div class="col">
                            <label for="txtMdlNombrePiloto" class="control-label"><b> Nombre Piloto </b></label>
                            <input type="text" class="form-control" id="txtMdlNombrePiloto" disabled>
                        </div>
                    </div>

                    <br />

                    <div class="row">
                        <div class="">
                            <table id="tableMdlDetalle" class="table table-hover" width="100%">
