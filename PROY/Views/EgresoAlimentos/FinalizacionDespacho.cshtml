        function ConfirmDelete(boton, idDetalle){
            Swal.fire({
              title: "Está seguro de eliminar la solicitud de salida?",
              showCancelButton: true,
              confirmButtonText: "Eliminar",
              icon: "question"
            }).then((result) => {
              if (result.isConfirmed) {
                  EliminarFila(boton, idDetalle);
              }
            });
        }

        function EliminarFila(boton, idDetalle) {

            // En el escenario en donde el ID de es diferente de cero, se elimina en la BD
            if (idDetalle != 0){

                $.ajax({
                url: `@ViewData["rutaApp"]/EgresoAlimentos/EliminarSolicitudSalida?id=${idDetalle}`,
                type: "POST",
                success: function (data) {
                    CalcularDetallesProductos(data.listaDetalleSalidaAlimentos, 2);

                    Swal.fire("Eliminado!", "Solicitud Eliminada Correctamente", "success");

                },
                error: function (xhr, status, error) {
                    console.error("Error al eliminar:", error);
                    alert("Ocurrió un error al eliminar el producto.");
                }
            });
            }

            let fila = boton.closest("tr");
            fila.remove();

            ActualizarContador();
        }

        function GuardarSolicitudSalida() {
            let solSalida = {
                IdSolicitudSalidaAlimentos: 0,
                IdEgresoAlimentos: $("#idEgresoAlimentos").val(),
                NoConstancia: $("#txtNoConstancia").val(),
                FechaDespacho: $('#txtFechaDespacho').val(),
                IdTransportista: $('#idTransportista').val(),
                IdPiloto: $('#idPiloto').val(),
                IdVehiculo: $('#idVehiculo').val(),
                IdPrograma: $('#cbIdPrograma').val(),
                // Nombres
                NombreTransportista: $('#txtNombreTransportista').val(),
                PlacasTransporte: $('#txtPlacasTransporte').val(),
                NoTrailer: $('#txtNoTrailer').val(),
                NombrePiloto: $('#txtNombrePiloto').val(),
                NoLicencia: $('#txtNoLicencia').val()
            };

            if (!solSalida.NoConstancia || !solSalida.FechaDespacho || !solSalida.NombreTransportista || !solSalida.PlacasTransporte || 
                !solSalida.NombrePiloto || !solSalida.NoLicencia){
                Swal.fire({
                    title: "Error!",
                    text: "Debe de Completar todos los campos la Creación de Constancia.",
                    icon: "warning"
                });

                return;
            }

            let detalles = [];

            $("#tableDetalle tbody tr").each(function () {
                let fila = $(this);

                if (fila.find("input[name='checkRow']").prop('checked') == true){
                    let detalle = {
                        IdDetalleSalidaAlimentos: 0,
                        IdProductoAlimenticio: fila.find("input[name='IdProductoAlimenticio']").val(),
                        CantidadUnidad: fila.find("input[name='CantidadUnidad']").val(),
                        IdUnidadMedida: fila.find("input[name='IdUnidadMedida']").val(),
                        CantidadSalida: fila.find("input[name='CantidadSalida']").val(),
                        EstadoProducto: fila.find("input[name='EstadoProducto']").val()
                    };

                    // Se restará la cantidad seleccionada de salida con la cantidad que se habia ingresado para comprobar que no se pueda seleccionar ese producto
                    if (parseInt(fila.find("input[name='CantidadSalida']").val()) == parseInt(fila.find("input[name='NoUnidades']").val())){
                        fila.find("input[name='checkRow']").prop("disabled", true);
                        fila.find("input[name='CantidadSalida']").val("");
                        fila.find("input[name='CantidadSalida']").attr("disabled", true);
                        fila.find("input[name='EstadoProducto']").val("");
                        fila.find("input[name='EstadoProducto']").attr("disabled", true);

                        fila.find("input[name='NoUnidades']").val(0);
                        fila.find("td:eq(8)").text(0);
                    } else {
                        // En caso de que no sea el total, se actualiza a la cantidad restante
                        var nuevaCantidad = parseInt(fila.find("input[name='NoUnidades']").val()) - parseInt(fila.find("input[name='CantidadSalida']").val());

                        fila.find("input[name='NoUnidades']").val(nuevaCantidad);
                        fila.find("input[name='CantidadSalida']").attr("max", nuevaCantidad);
                        fila.find("input[name='CantidadSalida']").val(nuevaCantidad);

                        // Actualizar el valor en la novena celda (índice 8)
                        fila.find("td:eq(8)").text(nuevaCantidad);
                    }

                    fila.find("input[name='checkRow']").prop("checked", false);

                    detalles.push(detalle);
                }  
            });

            if (detalles.length == 0) {

                Swal.fire({
                    title: "Error!",
                    text: "Debe de Seleccionar Productos.",
                    icon: "warning"
                });

                return;
            }

            let datosEnvio = {
                SolicitudSalidaAlimentos: solSalida,
                listaDetalleSalidaAlimentos: detalles
            };

            console.log(datosEnvio);

            
            $.ajax({
                url: `@ViewData["rutaApp"]/EgresoAlimentos/GuardarConstanciaSalida`,
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(datosEnvio),
                success: function (respuesta) {

                    Swal.fire("Almacenado!", "", "success");

                    // Se carga la tabla de solicitudes
                    cargaDetalleSolicitudes();
                    LimpiarDetalles();
                    GuardarEstibas();
                
                    // Redireccionar o limpiar formulario si es necesario
                    window.location.reload();
                },
                error: function (xhr, status, error) {
                    console.error("Error al guardar:", error);
                    alert("Ocurrió un error al guardar la solicitud.");
                }
            });
        }

        function LimpiarDetalles(){
            $('#txtNombreTransportista').val('');
            $('#txtPlacasTransporte').val('');
            $('#txtNombrePiloto').val('');
            $('#txtNoLicencia').val('');
            $('#txtNoConstancia').val('');
            $('#txtFechaDespacho').val('');
        }

        function GuardarEstibas(){
            let detalles = [];

            $("#tableDetalle tbody tr").each(function () {
                let fila = $(this);

                let detalle = {
                    IdDetalleEgresoAlimentos: fila.find("input[name='IdDetalleEgresoAlimentos']").val(),
                    EstibaEgreso: fila.find("input[name='EstibaEgreso']").val(),
                };

                    detalles.push(detalle);
            });

            let datosEnvio = {
                listaDetalleEgresoAlimentos: detalles
            };

            $.ajax({
                url: `@ViewData["rutaApp"]/EgresoAlimentos/GuardarEstibaDetallesEgresos`,
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(datosEnvio),
                success: function (respuesta) {

                    // Swal.fire("Almacenado!", "", "success");

                    // Redireccionar o limpiar formulario si es necesario
                    // window.location.href = `@ViewData["rutaApp"]/IngresoAlimentos/Index`;
                },
                error: function (xhr, status, error) {
                    console.error("Error al guardar:", error);
                    alert("Ocurrió un error al guardar el ingreso de alimentos.");
                }
            });
        }

        function confirmarFinalizacion(e){

            e.preventDefault();

            var countDet = 0;

            // Para finalizar la solicitud, se contarán los detalles y si hay uno habilitado, indicará que hacen falta asignar para la salida y retornara false
            $("#tableDetalle tbody tr").each(function () {
                let fila = $(this);

                if (fila.find("input[name='checkRow']").prop('disabled') == false){
                    countDet += 1;
                }
            });

            if (countDet > 0){

                Swal.fire({
                    title: "Error!",
                    text: "Debe de asignar todos los productos.",
                    icon: "warning"
                });


                e.preventDefault();
            } else {
                Swal.fire({
                  title: "Está seguro de enviar el Ingreso de Alimentos a Bodega?",
                  showCancelButton: true,
                  confirmButtonText: "Enviar",
                  icon: "question"
                }).then((result) => {
                  if (result.isConfirmed) {

                      window.location.href = e.target.href;

                      return true;
                  } else{
                      e.preventDefault();
                  }
                });
            }
        }

        function ConfirmSave(){

            GuardarEstibas();

            var countDet = 0;
            var countEstibas = 0;

            // Para finalizar la solicitud, se contarán los detalles y si hay uno habilitado, indicará que hacen falta asignar para la salida y retornara false
            $("#tableDetalle tbody tr").each(function () {
                let fila = $(this);

                if (fila.find("input[name='checkRow']").prop('disabled') == false){
                    countDet += 1;
                }

                if (fila.find("input[name='EstibaEgreso']").val() == ""){
                    countEstibas += 1;
                }
            });

            if (countEstibas > 0){

                Swal.fire({
                    title: "Error!",
                    text: "Debe de ingresar todas las Estibas a los productos.",
                    icon: "warning"
                });

                return;
            }

            if (countDet > 0){

                Swal.fire({
                    title: "Error!",
                    text: "Debe de asignar todos los productos.",
                    icon: "warning"
                });


                // e.preventDefault();
            } else {
                Swal.fire({
                  title: "Está seguro de enviar el Ingreso de Alimentos a Bodega?",
                  showCancelButton: true,
                  confirmButtonText: "Guardar",
                  icon: "question"
                }).then((result) => {
                  if (result.isConfirmed) {

                    if ($('#idTipoSalidaAlimentos').val() == 2){
                        AbrirModalAsignaEncargado();
                    } else{
                        confirmarTraslado("Está seguro de finalizar el Egreso de Alimentos?");
                    }
                        
                  }
                });
            }
        }

        function AbrirModalAsignaEncargado(){

            var id = $('#idEgresoAlimentos').val();

            $.ajax({
                url: `@ViewData["rutaApp"]/EgresoAlimentos/ObtenerUsuariosEncargadosBodega`, // URL para obtener los datos
                type: 'GET',
                success: function (data) {

                    var usuarios = data.usuarios;

                    let selectUsuario = $('#cbIdUsuario');
                    selectUsuario.empty(); // Limpiar opciones previas
                    let optionsUsuarios = "";

                    usuarios.forEach(uss => {
                        optionsUsuarios += `<option value="${uss.idUsuario}">${uss.nombre} ${uss.apellidos}</option>`;
                    });

                    selectUsuario.append(optionsUsuarios);
                },
                error: function (xhr, status, error) {
                    console.error('Error al obtener los datos de usuarios: ', error);
                }
            });

            var modal = new bootstrap.Modal(document.getElementById('wCambioEstado'));
            modal.show();
        }

        function confirmarTraslado(mensaje){

            Swal.fire({
              title: mensaje,
              showCancelButton: true,
              confirmButtonText: "Enviar",
              icon: "question"
            }).then((result) => {
              if (result.isConfirmed) {

                  var id = parseInt($("#idEgresoAlimentos").val());
                  var estado = 6; // Finalización del Egreso
                  var idTipoSalidaAlimento = parseInt($('#idTipoSalidaAlimentos').val());
                  var idUsuario = $('#idTipoSalidaAlimentos').val() == 2 ? parseInt($('#cbIdUsuario').val()) : null;

                $.ajax({
                    url: `@ViewData["rutaApp"]/EgresoAlimentos/CambioEstado`, // Ruta del método
                    type: 'POST',
                    data: { 'id': id, 'estado': estado, 'idTipoSalidaAlimento': idTipoSalidaAlimento, 'idUsuario': idUsuario },
                    success: function (response) {

                        // Redireccionar 
                        window.location.href = `@ViewData["rutaApp"]/EgresoAlimentos/Index`;
                    },
                    error: function (xhr, status, error) {
                        console.error("❌ Error al cambiar estado:", xhr.responseText);
                        alert("Hubo un error al cambiar el estado. Verifica la consola.");
                    }
                });

                  return true;
              } else{
                  // e.preventDefault();
              }
            });
        }

    </script>
