@model PROY.ViewModels.PuestoVM;
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous">
<head>
</head>
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    ViewData["Title"] = "Puestos";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@* <div class="=row">
        <div class="col-sm-8"> *@
<h2 class="float-start">Administración de Puestos</h2> <a class="btn btn-primary btn-sm float-end" onclick="abrirModalYActualizarUrl(0)"><i class="fas fa-plus-square"></i> Puestos</a>
<p><br /></p>
<table class="table">
    <thead>
        <tr>
            <th>No.</th>
            <th>NOMBRE</th>
            <th>OPCIONES</th>
        </tr>
    </thead>
    <tbody>
        @try
        {
            int indexCount = 0;

            foreach (var item in Model.listaPuestos)
            {
                <tr>
                    <td>
                        @{
                            indexCount++;
                        }
                        @indexCount
                    </td>
                    <td>@item.NombrePuesto</td>
                    <td class="text-center">
                        <a class="btn btn-info btn-sm" onclick="abrirModalYActualizarUrl(@item.IdPuesto)"><i class="fas fa-edit"></i> Editar</a>
                        <a class="btn btn-danger btn-sm" asp-controller="Puesto" asp-action="Eliminar" asp-route-id="@item.IdPuesto" onclick="confirmar(event)"><i class="fas fa-trash"></i> Eliminar</a>
                    </td>
                </tr>
            }
        }
        catch
        {

        }

    </tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="wNewPuesto" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="height:250px;">
            <form asp-action="GuardarPuesto" asp-controller="Puesto" method="post">
                <div class="modal-header bg-secondary">
                    <h5 class="modal-title text-white" id="lblModalTitle">@ViewBag.ModalTitle</h5>
                    <button type="button" id="btnClose" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" id="idPuesto" asp-for="@Model.Puesto.IdPuesto" />
                    <div>
                        <div class="col">
                            <label for="txtNombrePuesto" class="control-label">Nombre Puesto</label>
                            <input type="text" class="form-control" id="txtPuesto" asp-for="@Model.Puesto.NombrePuesto" required></input>
                            <span asp-validation-for="@Model.Puesto.NombrePuesto" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <input type="submit" value="Guardar" class="btn btn-primary" />
                </div>
            </form>

        </div>
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function abrirModalYActualizarUrl(id) {
            if (id == 0) {
                var ventanaTitle = document.getElementById("lblModalTitle");
                ventanaTitle.textContent = "REGISTRO PUESTO";

                $('#idPuesto').val(0);
                $('#txtPuesto').val('');
            }
            else {

                $.ajax({
                    url: `@ViewData["rutaApp"]/Puesto/ObtenerPuesto/${id}`, // URL para obtener los datos
                    type: 'GET',
                    success: function (data) {

                        console.log('data' + JSON.stringify(data));
                        // Llenar el formulario del modal con los datos del puesto
                        $('#idPuesto').val(id);
                        $('#txtPuesto').val(data.nombre);

                        var ventanaTitle = document.getElementById("lblModalTitle");
                        ventanaTitle.textContent = "MODIFICAR PUESTO";
                    },
                    error: function (xhr, status, error) {
                        console.error('Error al obtener los datos del puesto:', error);
                    }
                });
            }

            var modal = new bootstrap.Modal(document.getElementById('wNewPuesto'));
            modal.show();

            
        }

        function confirmar(e){
            var res=confirm("Esta seguro de eliminar el puesto");
            if (res) return true;
            if (res==false) e.preventDefault();

            //return false;
        }
    </script>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


