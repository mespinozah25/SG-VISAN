@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous">

<style>
    .modal-header .btn-close {
        color: white !important;
        opacity: 1;
        -webkit-filter: invert(1);
    }

    .header-bg {
        background-color: #2c3e50;
    }

    dt {
        color: #6c757d;
        font-size: 0.875rem;
        font-weight: 500;
    }

    dd {
        color: #212529;
        font-size: 1rem;
        margin-bottom: 0;
        margin-top: 0.25rem;
    }

    .section-separator {
        border-bottom: 1px solid #dee2e6;
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        padding-top: 1rem;
    }

    .metric-card {
        transition: all 0.2s ease-in-out;
        cursor: default;
    }

    .metric-card:hover {
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05) !important;
        transform: translateY(-2px);
    }
</style>


@model PROY.ViewModels.SolicitudesVM

@{
    ViewData["Title"] = "Index";
    ViewData["rutaApp"] = @Model.rutaApp;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}
@{
    string? rol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    string? usuario = User.FindFirst("Usuario")?.Value;

    int Rechazada = (int)(ViewData["Rechazada"] ?? 0);

    string descripcionIntervencion = Model.IntervencionDict.TryGetValue(Model.Solicitud!.IdIntervencion, out string?
    descInter)
    ? descInter : "Intervención no encontrada";
    string descripcionProyecto = Model.Solicitud!.IdProyecto.HasValue
    ? Model.ProyectoDict.TryGetValue(Model.Solicitud!.IdProyecto.Value, out string? descProy)
    ? descProy : "Proyecto no encontrado" : "Proyecto no especificado";
    string descripcionDepartamento = Model.Solicitud!.Departamento.HasValue
    ? Model.DepartamentoDict.TryGetValue(Model.Solicitud!.Departamento.Value, out string? descDep)
    ? descDep : "Departamento no encontrado" : "Departamento no especificado";
    string descripcionMunicipio = Model.Solicitud!.Municipio.HasValue
    ? Model.MunicipioDict.TryGetValue(Model.Solicitud!.Municipio.Value, out string? descMun)
    ? descMun : "Municipio no encontrado" : "Municipio no especificado";
    string? extensionMedioConfirmacion = Model.Solicitud!.Archivo != null ?
    System.IO.Path.GetExtension(Model.Solicitud.Archivo).ToLower() : null;
}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="display-6">Solicitud de Alimentos Por Acciones</h1>
        </div>
    </div>
    <div class="row justify-content-center mt-3">
        <div class="card shadow-lg border-0 rounded-3">
            <header class="card-header p-4 p-sm-5 header-bg text-white rounded-top-3">
                <h1 class="display-4 text-white">Solicitud @Model.Solicitud!.Codigo</h1>
                @if(Model.Solicitud!.Rechazada == 0){
                    <span class="badge rounded-pill bg-primary text-white fs-5 p-3">
                        Estado: @Model.Solicitud!.EstadoSolicitud.Nombre
                    </span>
                }
                else if(Model.Solicitud!.Rechazada == 1){
                    <span class="badge rounded-pill bg-danger text-white fs-5 p-3">
                        Rechazada - Estado: @Model.Solicitud!.EstadoSolicitud.Nombre
                    </span>
                }
            </header>
            <div class="card-body p-4 p-sm-5">
                <div class="row">
                    <div class="col">
                        <div class="card metric-card p-3 rounded-3 shadow-sm border-bottom border-success border-4">
                            <p class="h5 text-muted mb-1">Válidos</p>
                            <p class="fs-4 fw-bolder text-success">@Model.Solicitud!.Validos</p>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card metric-card p-3 rounded-3 shadow-sm border-bottom border-warning border-4">
                            <p class="h5 text-muted mb-1">Duplicados</p>
                            <p class="fs-4 fw-bolder text-warning">@Model.Solicitud!.Duplicados</p>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card metric-card p-3 rounded-3 shadow-sm border-bottom border-danger border-4">
                            <p class="h5 text-muted mb-1">Sin Datos</p>
                            <p class="fs-4 fw-bolder text-danger">@Model.Solicitud!.SinDatos</p>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card metric-card p-3 rounded-3 shadow-sm border-bottom border-primary border-4">
                            <p class="h5 text-muted mb-1">Fallecidos</p>
                            <p class="fs-4 fw-bolder text-primary">@Model.Solicitud!.Fallecidos</p>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card metric-card p-3 rounded-3 shadow-sm border-bottom border-secondary border-4">
                            <p class="h5 text-muted mb-1">Gobierno</p>
                            <p class="fs-4 fw-bolder text-secondary">@Model.Solicitud!.Gobierno</p>
                        </div>
                    </div>
                </div>
                <div class="row g-4 mb-3">
                    <div class="col-md-4">
                        <div class="dropdown">
                            <button class="btn btn-secondary w-100 dropdown-toggle" type="button" id="dropdownOpcionesSolicitud"
                                data-bs-toggle="dropdown" aria-expanded="false" data-bs-container="body">
                                Opciones de la solicitud
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownOpcionesSolicitud">
                                <li>
                                    @if (rol == "Admin" || usuario == Model.Solicitud!.UsuarioRegistro){
                                        @if ($"{Model.Solicitud!.IdEstadoSolicitud}" == $"{@Configuration["EtapasSolicitud:APA:CREADA"]}"){
                                            <a class="dropdown-item" asp-controller="SolicitudV2"
                                                asp-action="FormularioSolicitud" asp-route-IdSolicitud="@Model.Solicitud!.IdSolicitud">
                                                Editar Solicitud
                                            </a>
                                            <a class="dropdown-item" asp-controller="SolicitudV2"
                                                asp-action="EliminarSolicitud" asp-route-IdSolicitud="@Model.Solicitud!.IdSolicitud"
                                                onclick="confirmarOperacion(event, this, '¿Esta seguro que desea eliminar la solicitud?')">
                                                Eliminar Solicitud
                                            </a>
                                            <a class="dropdown-item" asp-controller="Solicitud" asp-action="IndexDetalle" 
                                                asp-route-idSolicitud="@Model.Solicitud!.IdSolicitud" asp-route-k="2">
                                                Gestionar Beneficiarios
                                            </a>
                                        }
                                        @if ($"{Model.Solicitud!.IdEstadoSolicitud}" == $"{@Configuration["EtapasSolicitud:APA:REVISION_ADMINISTRATIVA"]}"){
                                            <a class="dropdown-item" asp-controller="SolicitudV2" asp-action="DetalleSolicitud" 
                                                asp-route-IdSolicitud="@Model.Solicitud!.IdSolicitud" asp-route-Rechazada="1">
                                                Rechazar Solicitud
                                            </a>
                                        }
                                        @if ($"{Model.Solicitud!.IdEstadoSolicitud}" == $"{@Configuration["EtapasSolicitud:APA:VERIFICACION_DE_CAMPO"]}"){
                                            <a class="dropdown-item" asp-controller="Evaluacion" asp-action="IndexDetalle"
                                                asp-route-idEvaluacion="@Model.Solicitud!.IdSolicitud" asp-route-k="2" asp-route-proceso="VERIFICACION_CAMPO">
                                                Medios de Verificación
                                            </a>
                                            @if(Model.Solicitud!.MostrarContinuidadVerificacionCampo){    
                                                <a class="dropdown-item" asp-controller="SolicitudV2" asp-action="DetalleSolicitud" 
                                                    asp-route-IdSolicitud="@Model.Solicitud!.IdSolicitud" asp-route-Rechazada="1">
                                                    Rechazar Solicitud
                                                </a>
                                                <a class="dropdown-item" asp-controller="SolicitudV2"
                                                    asp-action="CambioEtapaSolicitud" asp-route-IdSolicitud="@Model.Solicitud!.IdSolicitud"
                                                    onclick="confirmarOperacion(event, this,`¿Desea enviar la solicitud @Model.Solicitud!.Codigo a @Model.Solicitud!.EstadoSolicitud.EstadoSolicitudSiguiente!.Nombre?`)">
                                                    Enviar a etapa: @Model.Solicitud!.EstadoSolicitud.EstadoSolicitudSiguiente!.Nombre
                                                </a>
                                            }
                                            else
                                            {
                                                <a class="dropdown-item text-danger">
                                                    debe ingresar un medio de verificación para aprobación/rechazo
                                                </a>
                                            }
                                        }
                                        @if ($"{Model.Solicitud!.IdEstadoSolicitud}" == $"{@Configuration["EtapasSolicitud:APA:EVALUACION"]}"){
                                            <a class="dropdown-item" asp-controller="Evaluacion" asp-action="ListaDetalle"
                                                asp-route-idEvaluacion="@Model.Solicitud!.IdSolicitud" asp-route-k="2">
                                                Gestionar Beneficiarios
                                            </a>
                                            <a class="dropdown-item" asp-controller="Evaluacion" asp-action="IndexDetalle"
                                                asp-route-idEvaluacion="@Model.Solicitud!.IdSolicitud" asp-route-k="2">
                                                Medios de Verificación
                                            </a>
                                            @if(Model.Solicitud!.Rechazada == 0){
                                                <a class="dropdown-item" asp-controller="SolicitudV2" asp-action="RechazarSolicitud"
                                                    asp-route-IdSolicitud="@Model.Solicitud!.IdSolicitud" onclick="confirmarOperacion(event, this,`¿Desea rechazar la solicitud?`)">
                                                    Rechazar Solicitud
                                                </a>
                                            }
                                            else if(Model.Solicitud!.Rechazada == 1){
                                                <a class="dropdown-item" asp-controller="SolicitudV2" asp-action="HabilitarSolicitud"
                                                    asp-route-IdSolicitud="@Model.Solicitud!.IdSolicitud" onclick="confirmarOperacion(event, this,`¿Desea habilitar la solicitud?`)">
                                                    Habilitar Solicitud
                                                </a>
                                            }
                                        }
                                        @if ($"{Model.Solicitud!.IdEstadoSolicitud}" == $"{@Configuration["EtapasSolicitud:APA:PROGRAMACION"]}"){
                                            <a class="dropdown-item" asp-controller="Programacion" asp-action="ListaDetalle"
                                                asp-route-idProgramacion="@Model.Solicitud!.IdSolicitud" asp-route-k="2">
                                                Gestionar Beneficiarios
                                            </a>
                                            <a class="dropdown-item" asp-controller="Evaluacion" asp-action="IndexDetalle"
                                                asp-route-idEvaluacion="@Model.Solicitud!.IdSolicitud" asp-route-k="2" asp-route-proceso="PROGRAMACION">
                                                Medios de Verificación
                                            </a>
                                            @if (Model.Solicitud!.MostrarDespachoEnProgramacion){
                                                <a class="dropdown-item" asp-controller="SolicitudV2" asp-action="FormularioDespacho"
                                                    asp-route-IdSolicitud="@Model.Solicitud!.IdSolicitud">
                                                    Despacho
                                                </a>
                                            }
                                            else
                                            {
                                                <a class="dropdown-item text-danger">
                                                    debe completar los medios de verificación
                                                </a>
                                            }
                                            @if (Model.Solicitud!.AsignacionDeRacionesCompleta){
                                                <a class="dropdown-item" asp-controller="SolicitudV2"
                                                    asp-action="CambioEtapaSolicitud" asp-route-IdSolicitud="@Model.Solicitud!.IdSolicitud"
                                                    onclick="confirmarOperacion(event, this,`¿Desea enviar la solicitud @Model.Solicitud!.Codigo a @Model.Solicitud!.EstadoSolicitud.EstadoSolicitudSiguiente!.Nombre?`)">
                                                    Enviar a etapa: @Model.Solicitud!.EstadoSolicitud.EstadoSolicitudSiguiente!.Nombre
                                                </a>
                                            }
                                            else
                                            {
                                                <a class="dropdown-item text-danger">
                                                    debe asignar todas las raciones
                                                </a>
                                            }
                                            
                                        }
                                        @if ($"{Model.Solicitud!.IdEstadoSolicitud}" == $"{@Configuration["EtapasSolicitud:APA:EJECUCION"]}"){
                                            <a class="dropdown-item" asp-controller="Ejecucion" asp-action="IndexDetalle"
                                                asp-route-idEjecucion="@Model.Solicitud!.IdSolicitud" asp-route-k="2" asp-route-proceso="EJECUCION">
                                                Gestionar Liquidación
                                            </a>
                                            <a class="dropdown-item" asp-controller="Programacion" asp-action="ListaDetalle"
                                                asp-route-idProgramacion="@Model.Solicitud!.IdSolicitud" asp-route-k="2">
                                                Gestionar Beneficiarios
                                            </a>
                                            <a class="dropdown-item" asp-controller="Evaluacion" asp-action="IndexDetalle"
                                                asp-route-idEvaluacion="@Model.Solicitud!.IdSolicitud" asp-route-k="2" asp-route-proceso="EJECUCION">
                                                Medios de Verificación
                                            </a>
                                        }
                                        @if(Model.Solicitud!.EstadoSolicitud.EstadoSolicitudSiguiente != null &&
                                            $"{Model.Solicitud!.IdEstadoSolicitud}" != $"{@Configuration["EtapasSolicitud:APA:VERIFICACION_DE_CAMPO"]}" &&
                                            $"{Model.Solicitud!.IdEstadoSolicitud}" != $"{@Configuration["EtapasSolicitud:APA:PROGRAMACION"]}"){
                                            <a class="dropdown-item" asp-controller="SolicitudV2"
                                                asp-action="CambioEtapaSolicitud" asp-route-IdSolicitud="@Model.Solicitud!.IdSolicitud"
                                                onclick="confirmarOperacion(event, this,`¿Desea enviar la solicitud @Model.Solicitud!.Codigo a @Model.Solicitud!.EstadoSolicitud.EstadoSolicitudSiguiente!.Nombre?`)">
                                                Enviar a etapa: @Model.Solicitud!.EstadoSolicitud.EstadoSolicitudSiguiente!.Nombre
                                            </a>
                                        }
                                    }
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                @if(Rechazada == 1 && (
                    $"{Model.Solicitud!.IdEstadoSolicitud}" == $"{@Configuration["EtapasSolicitud:APA:VERIFICACION_DE_CAMPO"]}" ||
                    $"{Model.Solicitud!.IdEstadoSolicitud}" == $"{@Configuration["EtapasSolicitud:APA:REVISION_ADMINISTRATIVA"]}"
                )){
                    <form asp-action="RechazarSolicitudConComentario" asp-controller="SolicitudV2" method="post">
                        <div class="row my-3 g-3">
                            <input type="hidden" asp-for="@Model.Solicitud.IdSolicitud" />
                            <div class="col-md-12">
                                <label for="txtComentarioRechazo" class="control-label">Comentario de rechazo</label>
                                <input type="text" class="form-control" id="txtComentarioRechazo" asp-for="@Model.Solicitud!.ComentarioRechazo" required maxlength="255"></input>
                                <span asp-validation-for="@Model.Solicitud!.ComentarioRechazo" class="text-danger"></span>
                            </div>
                            <div class="col-md-12">
                                <input type="submit" value="Rechazar y regresar etapa" class="btn btn-danger w-100 h-100" />
                            </div>
                        </div>
                    </form>
                }
                @if(Model.Solicitud!.Rechazada == 1 && Model.Solicitud!.ComentarioRechazo != null){
                    <div class="card text-white bg-danger mb-3">
                        <div class="card-body">
                            <h5 class="card-title text-white">Comentario de rechazo</h5>
                            <p class="card-text">@Model.Solicitud!.ComentarioRechazo</p>
                        </div>
                    </div>
                }
                <div class="row g-4">
                    <div class="col-12 section-separator">
                        <h3 class="fs-5 fw-bold text-dark">Información Básica</h3>
                    </div>
                    <div class="col-12 col-md-6">
                        <dt>Departamento</dt>
                        <dd class="fw-semibold">Alimentos por Acciones</dd>
                    </div>
                    <div class="col-12 col-md-6">
                        <dt>No. Solicitud</dt>
                        <dd>@Model.Solicitud!.Correlativo</dd>
                    </div>
                    <div class="col-12 col-md-6">
                        <dt>Intervención</dt>
                        <dd>@descripcionIntervencion</dd>
                    </div>
                    <div class="col-12 col-md-6">
                        <dt>Proyecto</dt>
                        <dd>@descripcionProyecto</dd>
                    </div>
                    <div class="col-12 col-md-6">
                        <dt>No. de raciones</dt>
                        <dd>@Model.Solicitud!.Raciones</dd>
                    </div>
                    <div class="col-12 col-md-6">
                        <dt>Medio de verificación actual</dt>
                        @if (extensionMedioConfirmacion == ".pdf" || extensionMedioConfirmacion == ".jpg" ||
                                                extensionMedioConfirmacion == ".jpeg" ||
                                                extensionMedioConfirmacion == ".png" || extensionMedioConfirmacion == ".gif" ||
                                                extensionMedioConfirmacion == ".bmp")
                        {
                            <a href="@Url.Action("PreviewFile", "Solicitud", new { fileName = @Model.Solicitud!.Archivo })"
                                target="_blank">
                                @Model.Solicitud!.Archivo
                            </a>
                        }
                        @if (extensionMedioConfirmacion == ".xls" || extensionMedioConfirmacion == ".xlsx" ||
                                                extensionMedioConfirmacion == ".doc" ||
                                                extensionMedioConfirmacion == ".docx" || extensionMedioConfirmacion == ".ppt" ||
                                                extensionMedioConfirmacion == ".pptx")
                        {
                            <a href="@Url.Action("DownloadFile", "Solicitud", new { fileName = Model.Solicitud!.Archivo })">
                                @Model.Solicitud!.Archivo
                            </a>
                        }
                    </div>
                    <div class="col-12 section-separator">
                        <h3 class="fs-5 fw-bold text-dark">Fechas de referencia</h3>
                    </div>
                    <div class="col-12 col-md-6">
                        <dt>Fecha de ingreso a despacho</dt>
                        <dd>@Model.Solicitud!.FechaIngresoDespacho.Date.ToString("dd/MM/yyyy")</dd>
                    </div>
                    <div class="col-12 col-md-6">
                        <dt>Fecha de ingreso a dirección</dt>
                        <dd>@Model.Solicitud!.FechaIngresoDireccion.Date.ToString("dd/MM/yyyy")</dd>
                    </div>
                    <div class="col-12 col-md-6">
                        <dt>Fecha de ingreso a departamento</dt>
                        <dd>@Model.Solicitud!.FechaIngresoUnidad.Date.ToString("dd/MM/yyyy")</dd>
                    </div>
                    <div class="col-12 section-separator">
                        <h3 class="fs-5 fw-bold text-dark">Ubicación</h3>
                    </div>
                    <div class="col-12 col-md-6">
                        <dt>Departamento</dt>
                        <dd>@descripcionDepartamento</dd>
                    </div>
                    <div class="col-12 col-md-6">
                        <dt>Municipio</dt>
                        <dd>@descripcionMunicipio</dd>
                    </div>
                    <div class="col-12 col-md-6">
                        <dt>Comunidad</dt>
                        <dd>@Model.Solicitud!.Comunidad</dd>
                    </div>
                    <div class="col-12 section-separator">
                        <h3 class="fs-5 fw-bold text-dark">COCODE</h3>
                    </div>
                    <div class="col-12 col-md-6">
                        <dt>Nombre</dt>
                        <dd>@Model.Solicitud!.NombreCocode</dd>
                    </div>
                    <div class="col-12 col-md-6">
                        <dt>Comunidad</dt>
                        <dd>@Model.Solicitud!.ComunidadCocode</dd>
                    </div>
                    <div class="col-12 col-md-6">
                        <dt>Teléfono</dt>
                        <dd>@Model.Solicitud!.TelefonoCocode</dd>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>

    function confirmarOperacion(evento, elemento, mensaje){
        evento.preventDefault();

        Swal.fire({
            title: "ATENCIÓN",
            text: mensaje,
            icon: "question",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Aceptar",
            cancelButtonText: "Cancelar"
        }).then((result) => {
            if (result.isConfirmed) window.location.href = elemento.href;
            else if (result.dismiss === Swal.DismissReason.cancel) evento.preventDefault();
        });
    }
</script>