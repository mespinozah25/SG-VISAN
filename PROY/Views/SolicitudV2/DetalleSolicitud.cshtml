<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

<script>

    function confirmarOperacion(evento, elemento, mensaje){
        evento.preventDefault();

        Swal.fire({
            title: "ATENCIÓN",
            text: mensaje,
            icon: "question",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Aceptar",
            cancelButtonText: "Cancelar"
        }).then((result) => {
            if (result.isConfirmed) window.location.href = elemento.href;
            else if (result.dismiss === Swal.DismissReason.cancel) evento.preventDefault();
        });
    }

    function obtenerImagenBase64(url) {
        return new Promise((resolve, reject) => {
            const img = new Image();
            img.setAttribute("crossOrigin", "anonymous");
            img.onload = () => {
                const canvas = document.createElement("canvas");
                canvas.width = img.width;
                canvas.height = img.height;
                const ctx = canvas.getContext("2d");
                ctx.drawImage(img, 0, 0);
                const dataURL = canvas.toDataURL("image/png");
                resolve(dataURL);
            };
            img.onerror = error => reject(error);
            img.src = url;
        });
    }
    
    async function generacionPlantillasPDF(idSolicitud, nombre, departamento, municipio, comunidad) {
        const magaBase64 = await obtenerImagenBase64('/LogoMAGA.jpg');
        const guatemalaBase64 = await obtenerImagenBase64('/LogoVISAN.png');

        const date = new Date();
        const options = { day: '2-digit', month: 'short', year: '2-digit' };
        const formatter = new Intl.DateTimeFormat('es-ES', options);
        const fecha = formatter.format(date).replace(/\//g, '-').replace(/\./g, '-');

        const response = await fetch('/SolicitudV2/GeneracionPlantillas?IdSolicitud=' + idSolicitud);
        if (!response.ok) return;

        let beneficiariosData = await response.json();

        beneficiariosData = beneficiariosData.filter(beneficiario => beneficiario.idAnulacion == null);

        let contadorFemenino = 0;
        let contadorMasculino = 0;
        beneficiariosData.forEach(b => b.genero === 'F' ? contadorFemenino++ : contadorMasculino++);

        const chunkArray = (arr, size) => {
            const chunks = [];
            for (let i = 0; i < arr.length; i += size) {
                chunks.push(arr.slice(i, i + size));
            }
            return chunks;
        };

        const beneficiariosSegmentados = chunkArray(beneficiariosData, 10);

        const docDefinition = {
            pageSize: 'LETTER',
            // AJUSTE: Reducido de 360 a 310 para eliminar el espacio vacío
            pageMargins: [40, 310, 40, 80],

            header: function(currentPage, pageCount) {
                return {
                    margin: [40, 20, 40, 0],
                    stack: [
                        {
                            table: {
                                widths: ['auto', '*', 'auto'],
                                body: [[
                                    { image: guatemalaBase64, width: 80, height: 40, border: [false, false, false, false] },
                                    {
                                        stack: [
                                            { text: 'MINISTERIO DE AGRICULTURA, GANADERIA Y ALIMENTACIÓN', fontSize: 10, bold: true, alignment: 'center' },
                                            { text: 'Viceministerio de Seguridad Alimentaria y Nutricional', fontSize: 9, alignment: 'center' },
                                            { text: 'ALIMENTOS POR ACCIONES', alignment: 'center', bold: true, fontSize: 10, margin: [0, 5, 0, 0] }
                                        ],
                                        border: [false, false, false, false]
                                    },
                                    {
                                        stack: [
                                            { image: magaBase64, width: 40, height: 40, alignment: 'right' },
                                            { text: `Página ${currentPage} de ${pageCount}`, fontSize: 8, alignment: 'right', margin: [0, 5, 0, 0] }
                                        ],
                                        border: [false, false, false, false]
                                    }
                                ]]
                            },
                            layout: 'noBorders'
                        },
                        {
                            table: {
                                widths: [150, '*', 150, 'auto'],
                                body: [[
                                    { text: 'DESPACHO DE ALMACÉN No. ________', fontSize: 8 },
                                    { text: '', border: [false, false, false, false] },
                                    { text: 'FECHA DE IMPRESIÓN:', fontSize: 8 },
                                    { text: fecha, fontSize: 8, bold: true }
                                ]]
                            },
                            layout: 'noBorders',
                            margin: [0, 5, 0, 5]
                        },
                        {
                            columns: [
                                {
                                    width: '35%',
                                    stack: [
                                        { text: `Departamento: ${departamento}`, fontSize: 8, margin: [0, 1] },
                                        { text: `Municipio: ${municipio}`, fontSize: 8, margin: [0, 1] },
                                        { text: `Comunidad: ${comunidad}`, fontSize: 8, margin: [0, 1] },
                                        { text: 'Fecha de Entrega: _____ / _____ / _______', fontSize: 8, margin: [0, 5, 0, 0] }
                                    ]
                                },
                                {
                                    width: '25%',
                                    stack: [
                                        { text: 'TIPO DE DISCAPACIDAD:', fontSize: 7, bold: true, margin: [0, 0, 0, 2] },
                                        { text: '1. NO', fontSize: 7 },
                                        { text: '2. VER', fontSize: 7 },
                                        { text: '3. OIR', fontSize: 7 },
                                        { text: '4. CAMINAR', fontSize: 7 },
                                        { text: '5. RECORDAR', fontSize: 7 },
                                        { text: '6. ASEARSE', fontSize: 7 },
                                        { text: '7. COMUNICARSE', fontSize: 7 }
                                    ]
                                },
                                {
                                    width: '40%',
                                    stack: [
                                        { text: 'RACIÓN:', fontSize: 7, bold: true, margin: [0, 0, 0, 2] },
                                        { text: '• 5 LBS ARROZ / 25 LBS MAÍZ BLANCO', fontSize: 7 },
                                        { text: '• 1 BOTELLA ACEITE 800 ml', fontSize: 7 },
                                        { text: '• 10 LBS FRIJOL / 1 BOLSA AZÚCAR 1kg', fontSize: 7 },
                                        { text: '• 1 KG AVENA / 1 BOLSA SAL 460gr', fontSize: 7 },
                                        { text: '• 1 BOLSA HARINA MAÍZ Y SOYA 900gr', fontSize: 7 }
                                    ]
                                }
                            ]
                        },
                        {
                            columns: [
                                { width: '*', text: '' },
                                {
                                    width: 'auto',
                                    table: {
                                        widths: [50, 40],
                                        body: [
                                            [{ text: 'Hombres:', fontSize: 8, alignment: 'right', border: [false, false, false, false] }, { text: `${contadorMasculino}`, fontSize: 8, alignment: 'center', border: [true, true, true, true] }],
                                            [{ text: 'Mujeres:', fontSize: 8, alignment: 'right', border: [false, false, false, false] }, { text: `${contadorFemenino}`, fontSize: 8, alignment: 'center', border: [true, true, true, true] }],
                                            [{ text: 'ETNIA:', fontSize: 8, alignment: 'right', border: [false, false, false, false] }, { text: ``, fontSize: 8, alignment: 'center', border: [true, true, true, true] }]
                                        ]
                                    },
                                    margin: [0, 5, 0, 0]
                                }
                            ]
                        }
                    ]
                };
            },

            footer: function(currentPage, pageCount) {
                return {
                    columns: [
                        {
                            stack: [
                                { canvas: [{ type: 'line', x1: 40, y1: 0, x2: 220, y2: 0, lineWidth: 1 }], margin: [0, 20, 0, 5] },
                                { text: 'NOMBRE, FIRMA Y SELLO - COCODE', alignment: 'center', fontSize: 7, bold: true }
                            ],
                            margin: [40, 0, 0, 0]
                        },
                        {
                            stack: [
                                { canvas: [{ type: 'line', x1: 40, y1: 0, x2: 220, y2: 0, lineWidth: 1 }], margin: [0, 20, 0, 5] },
                                { text: 'NOMBRE Y FIRMA - TÉCNICO MAGA', alignment: 'center', fontSize: 7, bold: true }
                            ],
                            margin: [0, 0, 40, 0]
                        }
                    ]
                };
            },

            content: beneficiariosSegmentados.map((chunk, index) => {
                return {
                    stack: [
                        {
                            style: 'mainTableStyle',
                            table: {
                                headerRows: 1,
                                widths: [20, '*', 90, 30, 40, 40, 100],
                                body: buildBeneficiariesTable(chunk, index)
                            },
                            layout: {
                                hLineWidth: (i, node) => 0.5,
                                vLineWidth: (i, node) => 0.5,
                                paddingTop: (i) => (i === 0 ? 1 : 1),
                                paddingBottom: (i) => (i === 0 ? 4 : 12),
                            }
                        }
                    ],
                    pageBreak: (index < beneficiariosSegmentados.length - 1) ? 'after' : null
                };
            }),

            styles: {
                tableHeader: { bold: true, fontSize: 8, alignment: 'center', fillColor: '#EEEEEE' },
                tableCell: { fontSize: 8 },
                centerCell: { fontSize: 8, alignment: 'center' }
            }
        };

        function buildBeneficiariesTable(data, index) {
            const body = [[
                { text: 'No.', style: 'tableHeader' },
                { text: 'NOMBRE DEL BENEFICIARIO', style: 'tableHeader' },
                { text: 'CUI', style: 'tableHeader' },
                { text: 'EDAD', style: 'tableHeader' },
                { text: 'RAC.', style: 'tableHeader' },
                { text: 'DISC.', style: 'tableHeader' },
                { text: 'FIRMA O HUELLA DIGITAL', style: 'tableHeader' }
            ]];

            data.forEach((item, i) => {
                let nombreCompleto = [
                    item.nombre1Esposa,
                    item.nombre2Esposa,
                    item.nombre3Esposa,
                    item.apellido1Esposa,
                    item.apellido2Esposa,
                    item.apellidoCasada
                ]
                .filter(Boolean)
                .join(' ');

                body.push([
                    { text: `${(i + 1) + ((index || 0) * 10)}`, style: 'centerCell' },
                    { text: `${nombreCompleto}`, style: 'tableCell' },
                    { text: `${item.cuiEsposa || ''}`, style: 'centerCell' },
                    { text: '', style: 'centerCell' },
                    { text: '1', style: 'centerCell' },
                    { text: '', style: 'centerCell' },
                    { text: '', style: 'centerCell' }
                ]);
            });
            return body;
        }

        pdfMake.createPdf(docDefinition).download(`${nombre}.pdf`);
    }


    document.getElementById('formActualizarRaciones').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const formData = new FormData(this);
        const idSolicitud = formData.get('IdSolicitud');
        const nuevasRaciones = formData.get('nuevasRaciones');
        
        // Mostrar confirmación
        Swal.fire({
            title: "¿Confirmar actualización?",
            text: `¿Desea actualizar el número de raciones a ${nuevasRaciones}?`,
            icon: "question",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Sí, actualizar",
            cancelButtonText: "Cancelar"
        }).then((result) => {
            if (result.isConfirmed) {
                // Llamar al método del controlador
                actualizarRaciones(idSolicitud, nuevasRaciones);
            }
        });
    });

    function actualizarRaciones(idSolicitud, nuevasRaciones) {
        fetch('@Url.Action("ActualizarRaciones", "SolicitudV2")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: JSON.stringify({
                IdSolicitud: parseInt(idSolicitud),
                Raciones: parseInt(nuevasRaciones)
            })
        })
        .then(response => {
            if (!response.ok) {
                throw new Error('Error en la respuesta del servidor');
            }
            return response.json();
        })
        .then(data => {
            if (data.success) {
                Swal.fire({
                    title: "¡Éxito!",
                    text: data.message,
                    icon: "success",
                    confirmButtonColor: "#3085d6"
                }).then(() => {
                    // Cerrar modal y recargar la página
                    const modal = bootstrap.Modal.getInstance(document.getElementById('modalActualizarRaciones'));
                    modal.hide();
                    location.reload();
                });
            } else {
                Swal.fire({
                    title: "Error",
                    text: data.message,
                    icon: "error",
                    confirmButtonColor: "#d33"
                });
            }
        })
        .catch(error => {
            console.error('Error:', error);
            Swal.fire({
                title: "Error",
                text: "Ocurrió un error al actualizar las raciones",
                icon: "error",
                confirmButtonColor: "#d33"
            });
        });
    }
</script>