@inject IHttpContextAccessor HttpContextAccessor
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous">

<style>
    .section-separator {
        border-bottom: 1px solid #dee2e6;
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        padding-top: 1rem;
    }
</style>


@model PROY.ViewModels.SolicitudesVM

@{
    ViewData["Title"] = "Index";
    ViewData["rutaApp"] = @Model.rutaApp;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}
@{
    string descripcionDepartamento = Model.Solicitud!.Departamento.HasValue
    ? Model.DepartamentoDict.TryGetValue(Model.Solicitud!.Departamento.Value, out string? descDep)
    ? descDep : "Departamento no encontrado" : "Departamento no especificado";
    string descripcionMunicipio = Model.Solicitud!.Municipio.HasValue
    ? Model.MunicipioDict.TryGetValue(Model.Solicitud!.Municipio.Value, out string? descMun)
    ? descMun : "Municipio no encontrado" : "Municipio no especificado";
}
<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-11">
            <h1 class="display-6">Tecnicos de Alimentos Por Acciones</h1>
        </div>
        <div class="col-md-1">
            <a class="btn btn-primary w-100" asp-controller="SolicitudV2" asp-action="DetalleSolicitud"
                asp-route-IdSolicitud="@Model.Solicitud!.IdSolicitud">
                Regresar
            </a>
        </div>
    </div>
    <div class="row g-4">
        <div class="col-12 section-separator">
            <h3 class="fs-5 fw-bold text-dark">Detalle de la solicitud</h3>
        </div>
        <div class="col-md-4">
            <dt>Departamento</dt>
            <dd>@descripcionDepartamento</dd>
        </div>
        <div class="col-md-4">
            <dt>Municipio</dt>
            <dd>@descripcionMunicipio</dd>
        </div>
        <div class="col-md-4">
            <dt>Comunidad</dt>
            <dd>@Model.Solicitud!.Comunidad</dd>
        </div>
    </div>
    <form asp-action="ActualizarFechasEntregaSolicitud" asp-controller="SolicitudV2" method="post">
        <div class="row my-3 g-3">
            <input type="hidden" asp-for="@Model.Solicitud.IdSolicitud" />
            <div class="col-md-6">
                <label class="control-label">Fecha inicio entrega</label>
                <input required asp-for="@Model.Solicitud.FInicioEntrega" id="finicioentrega" class="form-control"
                    type="date" />
                <span asp-validation-for="@Model.Solicitud.FInicioEntrega" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="control-label">Fecha final entrega</label>
                <input required asp-for="@Model.Solicitud.FFinEntrega" id="ffinentrega" class="form-control"
                    type="date" />
                <span asp-validation-for="@Model.Solicitud.FFinEntrega" class="text-danger"></span>
            </div>
            <div class="col-md-12">
                <label>Observaciones</label>
                <input asp-for="@Model.Solicitud.TecnicoObservaciones" type="text" id="txtObservaciones"
                    class="form-control" />
                <span asp-validation-for="@Model.Solicitud.TecnicoObservaciones" class="text-danger"></span>
            </div>
            <div class="col-md-12">
                <input type="submit" value="Guardar" class="btn btn-primary w-100" />
            </div>
        </div>
    </form>
    <div class="col-12 section-separator">
        <h3 class="fs-5 fw-bold text-dark">Gestionar técnicos</h3>
    </div>
    <form asp-action="AgregarAsignacionTecnico" asp-controller="SolicitudV2" method="post">
        <div class="row my-3 g-3 mt-3">
            <input type="hidden" asp-for="@Model.Solicitud.IdSolicitud" />
            <input type="hidden" asp-for="@Model.Solicitud.Departamento" />
            <input type="hidden" asp-for="@Model.Solicitud.Municipio" />
            <div class="col-md-6">
                <label class="control-label">Departamento</label>
                <select disabled class="form-select" id="cbDeptoRacion" asp-for="@Model.Solicitud.Departamento" asp-items="ViewBag.Departamentos" required></select>
                <span asp-validation-for="@Model.Solicitud.Departamento" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="control-label">Municipio</label>
                <select disabled class="form-select" id="cbMuniRacion" asp-for="@Model.Solicitud.Municipio" asp-items="ViewBag.Municipios" required></select>
                <span asp-validation-for="@Model.Solicitud.Municipio" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="control-label">Técnico asignado</label>
                <select class="form-select" id="cbTecnicoAsignado" asp-for="@Model.AsignaTecnicoV2!.IdTecnico" asp-items="ViewBag.Tecnicos" required></select>
                <span asp-validation-for="@Model.AsignaTecnicoV2!.IdTecnico" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label for="txtDireccionEntrega" class="control-label">Dirección entrega</label>
                <input type="text" class="form-control" id="txtDireccionEntrega" asp-for="@Model.AsignaTecnicoV2!.DireccionEntrega" required maxlength="250"></input>
                <span asp-validation-for="@Model.AsignaTecnicoV2!.DireccionEntrega" class="text-danger"></span>
            </div>
            <div class="col-md-12">
                <input type="submit" value="Agregar" class="btn btn-primary w-100 h-100" />
            </div>
        </div>
    </form>
    <div class="row">
        <div class="col-12">
            <div class="table-responsive">
                <table class="table p-5">
                    <thead>
                        <tr>
                            <th>ELIMINAR</th>
                            <th>DEPARTAMENTO</th>
                            <th>MUNICIPIO</th>
                            <th>TECNICO</th>
                            <th>DIRECCIÓN ENTREGA</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (AsignaTecnicoV2 item in Model.ListDetalleTecnicos)
                        {
                            <tr>
                                <td>
                                    <a class="btn btn-danger" asp-controller="SolicitudV2"
                                        asp-action="EliminarAsignacionTecnico" asp-route-IdSolicitud="@Model.Solicitud!.IdSolicitud"
                                        asp-route-IdAsignaTecnico="@item.IdAsignaTecnico">
                                        Eliminar
                                    </a>
                                </td>
                                <td>@descripcionDepartamento</td>
                                <td>@descripcionMunicipio</td>
                                <td>@item.Tecnico!.Nombre</td>
                                <td>@item.DireccionEntrega</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>