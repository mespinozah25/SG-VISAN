@model PROY.ViewModels.ProyectoVM;
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous">
<head>
</head>
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    ViewData["Title"] = "Proyectos";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@* <div class="=row">
        <div class="col-sm-8"> *@
<h2 class="float-start">Administración de Proyectos</h2> <a class="btn btn-primary btn-sm float-end" onclick="abrirModalYActualizarUrl(0)"><i class="fas fa-plus-square"></i> Proyecto</a>
<p><br /></p>
<table class="table">
    <thead>
        <tr>
            <th>NOMBRE PROYECTO</th>
            <th>AÑO</th>
            <th>OPCIONES</th>
        </tr>
    </thead>
    <tbody>
        @try
        {
            foreach (var item in Model.listaProyecto)
            {
                <tr>
                    <td>@item.NombreProyecto</td>
                    <td>@item.Anio</td>
                    <td class="text-center">
                        <a class="btn btn-info btn-sm" onclick="abrirModalYActualizarUrl(@item.IdProyecto)"><i class="fas fa-edit"></i> Editar</a>
                        <a class="btn btn-danger btn-sm" asp-controller="Proyecto" asp-action="Eliminar" asp-route-id="@item.IdProyecto" onclick="confirmar(event)"><i class="fas fa-trash"></i> Eliminar</a>
                    </td>

                </tr>
            }
        }
        catch
        {

        }

    </tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="wNewProyecto" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="height:350px;">
            <form asp-action="GuardarProyecto" asp-controller="Proyecto" method="post">
                <div class="modal-header bg-secondary">
                    <h5 class="modal-title text-white" id="lblModalTitle">@ViewBag.ModalTitle</h5>
                    <button type="button" id="btnClose" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" id="idProyecto" asp-for="@Model.Proyecto.IdProyecto" />
                    <div>
                        <div class="col">
                            <label for="txtNombreProyecto" class="control-label">Nombre Proyecto</label>
                            <input type="text" class="form-control" id="txtNombreProyecto" asp-for="@Model.Proyecto.NombreProyecto" required></input>
                            <span asp-validation-for="@Model.Proyecto.NombreProyecto" class="text-danger"></span>
                        </div>
                        <div class="col">
                            <label for="txtAnio" class="control-label">Año</label>
                            <input type="text" class="form-control" id="txtAnio" asp-for="@Model.Proyecto.Anio" required></input>
                            <span asp-validation-for="@Model.Proyecto.Anio" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <input type="submit" value="Guardar" class="btn btn-primary" />
                </div>
            </form>

        </div>
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function abrirModalYActualizarUrl(id) {
            if (id == 0) {
                var ventanaTitle = document.getElementById("lblModalTitle");
                ventanaTitle.textContent = "REGISTRO PROYECTO";

                $('#idProyecto').val(0);
                $('#txtNombreProyecto').val('');
                $('#txtAnio').val('');
            }
            else {

                $.ajax({
                    url: `@ViewData["rutaApp"]/Proyecto/ObtenerProyecto/${id}`, // URL para obtener los datos
                    type: 'GET',
                    success: function (data) {

                        console.log('data' + JSON.stringify(data));
                        // Llenar el formulario del modal con los datos de la solicitud
                        $('#idProyecto').val(id);
                        $('#txtNombreProyecto').val(data.nombre);
                        $('#txtAnio').val(data.anio);
                        //alert(id);

                        var ventanaTitle = document.getElementById("lblModalTitle");
                        ventanaTitle.textContent = "MODIFICAR PROYECTO ";
                    },
                    error: function (xhr, status, error) {
                        console.error('Error al obtener los datos del proyecto:', error);
                    }
                });
            }

            var modal = new bootstrap.Modal(document.getElementById('wNewProyecto'));
            modal.show();

        }

        function confirmar(e){
            var res=confirm("Esta seguro de eliminar el proyecto");
            if (res) return true;
            if (res==false) e.preventDefault();

            //return false;
        }
    </script>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

