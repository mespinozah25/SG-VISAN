@* @model List<PROY.Models.Solicitud> *@
@model PROY.ViewModels.SolicitudesVM

@{
    ViewData["rutaApp"] = @Model.rutaApp;

    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var depto="";

    try{
        depto = User.FindFirst("depto")?.Value;
    }
    catch
    {

    }

    var rol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var idDepto = User.FindFirst("idDepto")?.Value;
    var usr = User.FindFirst("Usuario")?.Value;
}

@{
    // Usamos el HttpContext inyectado para acceder al QueryString
    var valorK = HttpContextAccessor.HttpContext?.Request.Query["k"].ToString();
    bool tieneValorK = !string.IsNullOrEmpty(valorK);
    var condicion = "";

    if ((depto == "DAAN" && rol != "Admin") || (tieneValorK && valorK == "1" && rol == "Admin"))
        condicion = "1";
    else if ((depto == "DAPA" && rol!="Admin") || (tieneValorK && valorK=="2" && rol=="Admin"))
        condicion = "2";

    //Verificar DEPTO
    if (rol == "Admin")
    {
        if (valorK == "1")
            idDepto = "1";
        else if (valorK == "2")
            idDepto = "2";
    }
}

@* @if (tieneValorK)
{
    <p>El valor de "k" es: @valorK</p>
}
else
{
    <p>No se proporcionó el parámetro "k" o no tiene valor.</p>
} *@


@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (idDepto == "1")
{
    <h2 class="float-start">Solicitudes de Asistencia Alimentaria</h2><a class="btn btn-primary btn-sm btn-fixed-end" style="margin-right:60px;" onclick="abrirModalYActualizarUrl(0,@idDepto)"><i class="fas fa-plus-square"></i> Solicitud</a>    
}
else if (idDepto == "2")
{
    <h2 class="float-start">Solicitudes de Alimentos por Acción</h2><a class="btn btn-primary btn-sm btn-fixed-end" style="margin-right:60px;" onclick="abrirModalYActualizarUrl(0,@idDepto)"><i class="fas fa-plus-square"></i> Solicitud</a>
}



@* <button type="button" class="btn btn-primary float-end" data-bs-toggle="modal" data-bs-target="#wNewSolicitud">Nueva Solicitud</button> *@
<p><br /></p>
<table id="mitabla1" class="table" style="width:100%;">
    <thead>
        <tr>            
            <th>
                CODIGO
            </th>
            <th>
                No. SOLICITUD
            </th>
            @if (idDepto == "1")
            {
               <th>
                    INSTITUCION
               </th>  
            }
            else if (idDepto == "2")
            {
                <th>
                    PROYECTO
                </th> 
            }                       
            <th>
                INTERVENCION
            </th>            
            <th>
                FECHA INGRESO A DESPACHO
            </th>
            <th>
                FECHA INGRESO A UNIDAD
            </th>            
            <th>
                MEDIO VERIFICACIÓN
            </th>
            <th>
                DESCRIPCION
            </th>            
            <th>OPCIONES</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Solicitudes) {
        <tr>
            @* <td>
                @item.Correlativo
            </td> *@ 
            <td>
                @item.Codigo
            </td>
            <td>
                @item.Correlativo
            </td>

            @if (idDepto == "1")
            {
                <td>
                    @{
                        // Obtener la descripción usando el diccionario
                        /*string descripcionInstitucion = Model.InstitucionDict.TryGetValue(item.IdInstitucion, out var descInst)
                        ? descInst
                        : "Institución no encontrada";*/

                        string descripcionInstitucion = item.IdInstitucion.HasValue 
                                    ? Model.InstitucionDict.TryGetValue(item.IdInstitucion.Value, out var descInst) 
                                    ? descInst : "Institución no encontrada" 
                                                : "IdInstitución no especificada";
                    }
                    @descripcionInstitucion
                </td>   
            }
            else if (idDepto == "2")
            {
                <td>
                    @{
                        // Obtener la descripción usando el diccionario
                        /*string descripcionInstitucion = Model.InstitucionDict.TryGetValue(item.IdInstitucion, out var descInst)
                        ? descInst
                        : "Institución no encontrada";*/

                        string descripcionProyecto = item.IdProyecto.HasValue 
                                    ? Model.ProyectoDict.TryGetValue(item.IdProyecto.Value, out var descProy) 
                                    ? descProy : "Proyecto no encontrada" 
                                               : "IdProyecto no especificado";
                    }
                    @descripcionProyecto
                </td>   
            }
                

            <td>
                @{
                    // Obtener la descripción usando el diccionario
                    string descripcionIntervencion = Model.IntervencionDict.TryGetValue(item.IdIntervencion, out var descInter)
                    ? descInter
                    : "Intervención no encontrada";                
                }                   
                @descripcionIntervencion                
            </td>
            <td>
                @item.FechaIngresoDespacho.Date.ToString("dd/MM/yyyy")
            </td>
            <td>
                @item.FechaIngresoUnidad.Date.ToString("dd/MM/yyyy")
            </td>            
            <td>
                @if (!string.IsNullOrEmpty(item.Archivo))
                {
                    var extension = System.IO.Path.GetExtension(item.Archivo).ToLower();

                    if (extension == ".pdf")
                    {
                        <a href="@Url.Action("PreviewFile", new { fileName = item.Archivo })" target="_blank">
                            <i class="fas fa-file-pdf"></i> Ver PDF
                        </a>
                    }
                    else if (extension == ".xls" || extension == ".xlsx")
                    {                        
                        <a href="@Url.Action("DownloadFile", new { fileName = item.Archivo })">
                            <i class="fas fa-file-excel"></i> Descargar
                        </a>
                    }
                    else if (extension==".doc" || extension == ".docx")
                    {
                        <a href="@Url.Action("DownloadFile", new { fileName = item.Archivo })">
                            <i class="fas icon-file-word"></i> Descargar
                        </a>
                    }
                    else if (extension==".ppt" || extension == ".pptx")
                    {
                        <a href="@Url.Action("DownloadFile", new { fileName = item.Archivo })">
                            <i class="fas icon-file-ppt"></i> Descargar
                        </a>
                    }
                    else if (extension == ".jpg" || extension == ".jpeg" || extension == ".png" || extension == ".gif" || extension == ".bmp")
                    {
                        <a href="@Url.Action("PreviewFile", new { fileName = item.Archivo })" target="_blank">
                            <i class="fas fa-file-image"></i> Ver Imagen
                        </a>
                    }                    
                }
                else
                {
                    <span>No disponible</span>
                }
            </td>
            <td>
                @item.Descripcion
            </td>            
            <td>
                @* <a class="btn btn-warning btn-sm" asp-action="NuevaSolicitud" asp-route-id="@item.IdSolicitud">Editar</a> |*@
                @* <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#wNewSolicitud">Editar</button> | *@ 
                @* <a href="/Solicitud/Index/@item.IdSolicitud" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#wNewSolicitud">Editar</a> | *@
                
                @* <a href="@Url.Action("Index", new { id = item.IdSolicitud })" class="btn btn-danger btn-sm">Editar</a> *@
                @if (rol == "Admin")
                {
                    <a class="btn btn-info btn-sm" onclick="abrirModalYActualizarUrl(@item.IdSolicitud, @idDepto)"><i class="fas fa-edit"></i> Editar</a>                        
                }
                else
                {
                    if (usr==item.UsuarioRegistro)
                    {
                        <a class="btn btn-info btn-sm" onclick="abrirModalYActualizarUrl(@item.IdSolicitud, @idDepto)"><i class="fas fa-edit"></i> Editar</a>
                    }                        
                    else
                    {
                        <a class="btn btn-gray btn-sm disabled" href="javascript:void(0);"><i class="fas fa-edit"></i> Editar</a>    
                    }    
                }

                @if (rol == "Admin")
                {
                    <a class="btn btn-danger btn-sm" asp-action="EliminarSolicitud" asp-route-id="@item.IdSolicitud" onclick="confirmarSolicitud(event)"><i class="fas fa-trash"></i> Eliminar</a>                           
                }
                else
                {
                    if (usr==item.UsuarioRegistro)
                    {
                        <a class="btn btn-danger btn-sm" asp-action="EliminarSolicitud" asp-route-id="@item.IdSolicitud" onclick="confirmarSolicitud(event)"><i class="fas fa-trash"></i> Eliminar</a>
                    }                        
                    else
                    {
                        <a class="btn btn-gray btn-sm disabled" href="javascript:void(0);"><i class="fas fa-trash"></i> Eliminar</a>    
                    }     
                }
                
                @if (rol == "Admin")
                {
                    <a class="btn btn-dark btn-sm" asp-action="IndexDetalle" asp-route-idSolicitud="@item.IdSolicitud" asp-route-k="@condicion"><i class="fas fa-bars"></i> Beneficiarios</a>
                }                
                else
                {
                    if (usr==item.UsuarioRegistro)
                    {
                        <a class="btn btn-dark btn-sm" asp-action="IndexDetalle" asp-route-idSolicitud="@item.IdSolicitud"><i class="fas fa-bars"></i> Beneficiarios</a>
                    }                        
                    else
                    {
                        <a class="btn btn-gray btn-sm disabled" href="javascript:void(0);"><i class="fas fa-bars"></i> Beneficiarios</a>    
                    }
                    
                }
                
                @if (rol == "Admin")
                {
                    <a class="btn btn-gray btn-sm" asp-action="EnviarSolicitud" asp-route-id="@item.IdSolicitud" asp-route-k="@condicion" onclick="confirmarEnvio(event,'@item.Codigo', this, @idDepto)" title="Enviar solicitud a status de evaluación"><i class="fas fa-bolt"></i> Enviar</a>
                }                
                else
                {
                    if (usr == item.UsuarioRegistro)
                    {
                         <a class="btn btn-gray btn-sm" asp-action="EnviarSolicitud" asp-route-id="@item.IdSolicitud" onclick="confirmarEnvio(event,'@item.Codigo', this, @idDepto)" title="Enviar solicitud a status de evaluación"><i class="fas fa-bolt"></i> Enviar</a>     
                    }
                    else
                    {
                        <a class="btn btn-gray btn-sm disabled" href="javascript:void(0);"><i class="fas fa-bolt"></i> Enviar</a>    
                    }                    
                }                
            </td>
        </tr>
}
    </tbody>
</table>

<!-- Button trigger modal -->
@* <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#staticBackdrop">
    Launch static backdrop modal
</button> *@

<!-- Modal -->
<div class="modal fade" id="wNewSolicitud" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="height:650px; width:1100px;">
            <form asp-action="GuardarSolicitud" asp-controller="Solicitud" asp-route-k="@condicion" enctype="multipart/form-data" method="post">
                <div class="modal-header bg-secondary">
                    <h5 class="modal-title text-white" id="lblModalTitle">@ViewBag.ModalTitle</h5>
                    <button type="button" id="btnClose" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">                                
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" id="solicitudId" asp-for="Solicitud.IdSolicitud"/>
                    @* <div class="form-group">
                        <label>Correlativo</label>
                        <input asp-for="@Model.Solicitud.Correlativo" class="form-control" required/>
                        <span asp-validation-for="@Model.Solicitud.Correlativo" class="text-danger"></span>
                    </div> *@
                    <div class="row">                    
                        <div class="col-6">
                            <label for="cbTipoAsistAlim" class="control-label">Departamento</label>
                            @if (idDepto=="1")
                            {
                                <select class="form-select" id="cbTipoAsistAlim" name="Solicitud.Depto" required disabled>
                                    <option value="1" selected>Asistencia alimentaria</option>
                                </select>
                            }
                            else if (idDepto=="2")
                            {
                                <select class="form-select" id="cbTipoAsistAlim" name="Solicitud.Depto" required disabled>
                                    <option value="2" selected>Alimentos por acción</option>
                                </select>
                            }
                            @*<select class="form-select" id="cbTipoAsistAlim" asp-for="@Model.Solicitud.Depto" asp-items="ViewBag.Deptos"  required disabled></select>*@
                            <span asp-validation-for="@Model.Solicitud.Depto" class="text-danger"></span>
                        </div>
                        @if (idDepto == "1")
                        {
                            <div class="col-6">
                                <label for="cbInstitucion" class="control-label">Institución</label>
                                <select class="form-select" id="cbInstitucion" asp-for="@Model.Solicitud.IdInstitucion" asp-items="ViewBag.Instituciones" required></select>
                                <span asp-validation-for="@Model.Solicitud.IdInstitucion" class="text-danger"></span>
                            </div>
                        }                        
                    </div>
                    <div class="row">
                        <div class="col">
                            <label for="txtNoSolicitud" class="control-label">No. Solicitud</label>
                            <input asp-for="@Model.Solicitud.Correlativo" type="text" id="txtNoSolicitud" class="form-control" />
                            <span asp-validation-for="@Model.Solicitud.Correlativo" class="text-danger"></span>
                        </div>
                        <div class="col">
                            <label for="cbIntervencion" class="control-label">Intervención</label>
                            <select class="form-select" id="cbIntervencion" asp-for="@Model.Solicitud.IdIntervencion" asp-items="ViewBag.Intervenciones" required></select>
                            <span asp-validation-for="@Model.Solicitud.IdIntervencion" class="text-danger"></span>
                        </div>
                        @if (idDepto == "2")
                        {
                            <div class="col">
                                <label for="cbProyecto" class="control-label">Proyectos</label>
                                <select class="form-select" id="cbProyecto" asp-for="@Model.Solicitud.IdProyecto" asp-items="ViewBag.Proyectos" required></select>
                                <span asp-validation-for="@Model.Solicitud.IdProyecto" class="text-danger"></span>
                            </div>    
                        }                        
                    </div>

                    @if (idDepto == "2")
                    {
                        <div class="row">
                            <div class="col">
                                <label for="cbDepartamento" class="control-label">Departamento</label>
                                <select class="form-select" id="cbDepartamento" asp-for="@Model.Solicitud.Departamento" asp-items="ViewBag.Departamentos" onchange="cambio()" required></select>
                                <span asp-validation-for="@Model.Solicitud.Departamento" class="text-danger"></span>
                            </div>
                            <div class="col">
                                <label for="cbMunicipio" class="control-label">Municipio</label>
                                <select class="form-select" id="cbMunicipio" asp-for="@Model.Solicitud.Municipio" asp-items="ViewBag.Municipios" required></select>
                                <span asp-validation-for="@Model.Solicitud.Municipio" class="text-danger"></span>
                            </div>
                            <div class="col">
                                <label for="txtComunidad" class="control-label">Comunidad</label>
                                <input type="text" class="form-control" id="txtComunidad" asp-for="@Model.Solicitud.Comunidad" required></input>
                                <span asp-validation-for="@Model.Solicitud.Comunidad" class="text-danger"></span>
                            </div>
                        </div>    
                    }
                    
                    <div class="row">
                        <div class="col">
                            <label for="fdespacho" class="control-label">Fecha Ingreso a Despacho</label>
                            <input asp-for="@Model.Solicitud.FechaIngresoDespacho" id="fdespacho" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="@Model.Solicitud.FechaIngresoDespacho" class="text-danger"></span>
                        </div>
                        <div class="col">
                            <label for="fdireccion" class="control-label">Fecha Ingreso a Dirección</label>
                            <input asp-for="@Model.Solicitud.FechaIngresoDireccion" id="fdireccion" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="@Model.Solicitud.FechaIngresoDireccion" class="text-danger"></span>
                        </div>
                        <div class="col">
                            <label for="funidad" class="control-label">Fecha Ingreso a Departamento</label>
                            <input asp-for="@Model.Solicitud.FechaIngresoUnidad" id="funidad" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="@Model.Solicitud.FechaIngresoUnidad" class="text-danger"></span>
                        </div>                        
                        @if (idDepto == "1")
                        {
                            <div class="col">
                                <label for="txtraciones" class="control-label">No. de raciones</label>
                                <input asp-for="@Model.Solicitud.Raciones" id="txtraciones" class="form-control" type="number" required />
                                <span asp-validation-for="@Model.Solicitud.Raciones" class="text-danger"></span>
                            </div>    
                        }
                        else if (idDepto == "2")
                        {
                            <div class="col">
                                <label for="txtraciones" class="control-label">No. de raciones</label>
                                <input asp-for="@Model.Solicitud.Raciones" id="txtraciones" value="1" class="form-control" type="number" required />
                                <span asp-validation-for="@Model.Solicitud.Raciones" class="text-danger"></span>
                            </div>
                        }                        
                    </div>
                    @if (idDepto == "2")
                    {
                        <div class="row">
                            <div class="col">
                                <label for="txtNombreCocode" class="control-label">Nombre COCODE</label>
                                <input type="text" class="form-control" id="txtNombreCocode" asp-for="@Model.Solicitud.NombreCocode" required maxlength="100"></input>
                                <span asp-validation-for="@Model.Solicitud.NombreCocode" class="text-danger"></span>
                            </div>
                            <div class="col">
                                <label for="txtComunidadCocode" class="control-label">Comunidad COCODE</label>
                                <input type="text" class="form-control" id="txtComunidadCocode" asp-for="@Model.Solicitud.ComunidadCocode" required maxlength="150"></input>
                                <span asp-validation-for="@Model.Solicitud.ComunidadCocode" class="text-danger"></span>
                            </div>
                            <div class="col">
                                <label for="txtTelefonoCocode" class="control-label">Teléfono COCODE</label>
                                <input type="text" class="form-control" id="txtTelefonoCocode" asp-for="@Model.Solicitud.TelefonoCocode" required maxlength="10"></input>
                                <span asp-validation-for="@Model.Solicitud.TelefonoCocode" class="text-danger"></span>
                            </div>
                        </div>   
                    }
                    @* <div>
                        <label for="txtdescripcion" class="control-label">Descripcion</label>
                        <input asp-for="@Model.Solicitud.Descripcion" id="txtdescripcion" class="form-control" type="text"/>
                        <span asp-validation-for="@Model.Solicitud.Descripcion" class="text-danger"></span>
                    </div> *@
                    @*<div class="form-group">
                        <label for="cbunidad" class="control-label">Unidad</label>
                        <select class="form-select" id="cbunidad" asp-for="@Model.Solicitud.IdUnidad" asp-items="ViewBag.Unidades" required></select>
                        <span asp-validation-for="@Model.Solicitud.IdUnidad" class="text-danger"></span>
                    </div>*@
                    <div>
                        <label for="oldfile" class="control-label">Medio de verificación actual</label>
                        <input asp-for="@Model.Solicitud.Archivo" type="text" id="oldfile" class="form-control" disabled />
                    </div>
                    <div class="form-group">
                        <label for="file">Medio de verificación:</label>
                        <input type="file" name="file" id="file" class="form-control" 
                               accept=".pdf,
                                        application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,
                                        application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,
                                        application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,
                                        image/jpeg,image/png,image/gif,image/bmp" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>                    
                    <input type="submit" value="Guardar" class="btn btn-primary" />
                </div>
            </form>        
            
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />    
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        var abrirModalEditar = '@ViewBag.AbrirModalEditar';
        //console.log(abrirModalEditar);
        if (abrirModalEditar === 'edit') {
            //$('#lblModalTitle').val('MODIFICAR SOLICITUD');
            var ventanaTitle = document.getElementById("lblModalTitle");
            ventanaTitle.textContent = "MODIFICAR SOLICITUD";
            
            var modal = new bootstrap.Modal(document.getElementById('wNewSolicitud'));
            modal.show();
            //abrirModalYActualizarUrl(0);
        }
        else {
            var today = new Date();        
            // Formatear la fecha como YYYY-MM-DD
            var day = ("0" + today.getDate()).slice(-2); // Asegurar que el día tenga dos dígitos
            var month = ("0" + (today.getMonth() + 1)).slice(-2); // Mes (0 es enero, por eso sumamos 1)
            var year = today.getFullYear();
            // Establecer el valor por defecto en el input
            //document.getElementById("fecha").value = year + "-" + month + "-" + day;

            //alert('xxxxx');
            //console.log(abrirModalEditar);
            //$('#lblModalTitle').val('NUEVA SOLICITUD');
            var ventanaTitle = document.getElementById("lblModalTitle");
            ventanaTitle.textContent = "NUEVA SOLICITUD";
            $('#wNewSolicitud').on('show.bs.modal', function (event) {
                $('#solicitudId').val(0);
                $('#cbTipoAsistAlim').val();
                $('#cbInstitucion').val('');
                $('#cbIntervencion').val('');
                $('#fdespacho').val(year + "-" + month + "-" + day);
                $('#fdireccion').val(year + "-" + month + "-" + day);
                $('#funidad').val(year + "-" + month + "-" + day);
                $('#txtdescripcion').val('');
                //$('#cbunidad').val('');
                $('#oldfile').val('');
                //alert('xxxxxx' + $('#txtraciones').val());
                $('#txtraciones').val(); //Toma el valor que le asigne desde el formulario
            });
        }

        //-----------------------------------------------------------------------
       
        //cargarIntervenciones();
    });   

    

    $(document).on('change', '#cbTipoAsistAlim', function () {
        var opcionSeleccionada = $(this).val();
        //console.log('Opción seleccionada:', opcionSeleccionada);
        //alert('hola');
        var catalogoSelect = $('#cbIntervencion');
        catalogoSelect.empty(); // Limpiar el select antes de agregar nuevas opciones

        if (opcionSeleccionada === "1") {
            //console.log('Cargando intervenciones para DAAN');
            $.getJSON('@Url.Action("GetCat", "Solicitud")', { tipoCatalogo: "INTERVENCION" },
                function (data) {
                    console.log('Datos devueltos:', data);
                    var items = data.value.value;
                    $.each(items, function (index, item) {
                        catalogoSelect.append('<option value="' + item.id + '">' + item.descripcion + '</option>');
                    });
                });
        } else if (opcionSeleccionada === "2") {
            console.log('Cargando intervenciones para DAPA');
            $.getJSON('@Url.Action("GetCat", "Solicitud")', { tipoCatalogo: "INTERVENCIONES" },
                function (data) {
                    console.log('Datos devueltos:', data);
                    var items = data.value.value;
                    $.each(items, function (index, item) {
                        catalogoSelect.append('<option value="' + item.id + '">' + item.descripcion + '</option>');
                    });
                });
        }

        cargarIntervenciones();
    });    

    //console.log('----' + JSON.stringify(data));
    //console.log('----' + item[0].descripcion);

    function abrirModalYActualizarUrl(idSolicitud, idDepto) {        
        // Actualiza la URL sin recargar la página
        //const nuevaUrl = `/Solicitud/Index/${idSolicitud}`;
        const nuevaUrl = `@ViewData["rutaApp"]/Solicitud/Index/${idSolicitud}`;
        //alert(nuevaUrl);
        history.pushState(null, '', nuevaUrl);
        //alert('ID:' + idSolicitud);        
        
        


        if (idSolicitud == 0) {
            //$('#lblModalTitle').val('NUEVA SOLICITUD');
            var ventanaTitle = document.getElementById("lblModalTitle");
            ventanaTitle.textContent="REGISTRO SOLICITUD";            
            //alert('xxx' + idDepto);                        

            var today = new Date();        
            // Formatear la fecha como YYYY-MM-DD
            var day = ("0" + today.getDate()).slice(-2); // Asegurar que el día tenga dos dígitos
            var month = ("0" + (today.getMonth() + 1)).slice(-2); // Mes (0 es enero, por eso sumamos 1)
            var year = today.getFullYear();
            // Establecer el valor por defecto en el input
            //document.getElementById("fecha").value = year + "-" + month + "-" + day;

            $('#solicitudId').val(0);
            $('#cbInstitucion').val('');
            $('#cbIntervencion').val();
            $('#cbProyecto').val('');
            $('#txtNoSolicitud').val('');
            $('#fdespacho').val(year + "-" + month + "-" + day);
            $('#fdireccion').val(year + "-" + month + "-" + day);
            $('#funidad').val(year + "-" + month + "-" + day);
            $('#cbunidad').val('');
            $('#txtdescripcion').val('');
            $('#txtComunidad').val('');
            $('#txtNombreCocode').val('');
            $('#txtComunidadCocode').val('');
            $('#txtTelefonoCocode').val('');
            $('#cbTipoAsistAlim').val(idDepto);
            $('#oldfile').val('');
            if (idDepto=="1"){
                $('#txtraciones').val(0);
            }                
            else if (idDepto=="2"){
                $('#txtraciones').val(1);
                $('#cbDepartamento').val();
                //$('#cbMunicipio').val();
                $('#cbDepartamento').prop('selectedIndex', 0); // Selecciona el primer elemento
                cambio();
            }
                

            //alert('raciones ' + $('#txtraciones').val());                   

            cargarIntervenciones(); //Se dejo aquí junto con el select cuando es nuevo
             
            var catalogoSelect = $('#cbIntervencion');                
            catalogoSelect.append('<option value="" selected></option>');

            //$('#cbTipoAsistAlim').trigger('change');
        }
        else{
            //$('#lblModalTitle').val('MODIFICAR SOLICITUD');
            var ventanaTitle = document.getElementById("lblModalTitle");
            ventanaTitle.textContent = "MODIFICAR SOLICITUD";
            ////cargarIntervenciones(); Se quito de aqui y se paso al load cbTipoAsistAlimentaria del change para que funcione bien   
        }
        //window.location.href = `/Solicitud/Index/${idSolicitud}`;
        
        // Abre el modal        
        var modal = new bootstrap.Modal(document.getElementById('wNewSolicitud'));
        modal.show();

        //cargarIntervenciones();
        

        // Llamada AJAX para obtener los datos de la solicitud
        $.ajax({
            url: `@ViewData["rutaApp"]/Solicitud/ObtenerSolicitud/${idSolicitud}`, // URL para obtener los datos
            type: 'GET',
            success: function (data) {
                
                console.log('data' + JSON.stringify(data));
                // Llenar el formulario del modal con los datos de la solicitud
                $('#solicitudId').val(data.idSolicitud);
                $('#txtNoSolicitud').val(data.correlativo);
                $('#cbInstitucion').val(data.idInstitucion);
                $('#cbIntervencion').val(data.idIntervencion);
                $('#cbProyecto').val(data.idProyecto);
                //var cbInter=document.getElementById("cbIntervencion");
                //cbInter.value=data.idIntervencion;                
                $('#fdespacho').val(data.fechaDespacho);
                $('#fdireccion').val(data.fechaDireccion);
                $('#funidad').val(data.fechaUnidad);
                //$('#cbunidad').val(data.idUnidad);
                $('#txtdescripcion').val(data.descripcion);
                $('#oldfile').val(data.archivo);
                $('#cbTipoAsistAlim').val(data.depto);
                $('#txtraciones').val(data.raciones);

                $('#cbDepartamento').val(data.departamento);
                $('#cbMunicipio').val(data.municipio);
                $('#txtComunidad').val(data.comunidad);
                $('#txtNombreCocode').val(data.nombreCocode);
                $('#txtComunidadCocode').val(data.comunidadCocode);
                $('#txtTelefonoCocode').val(data.telefonoCocode);
                ///cargarIntervenciones();

                var ventanaTitle = document.getElementById("lblModalTitle");
                ventanaTitle.textContent = "MODIFICAR SOLICITUD " + data.codigo;
            },
            error: function (xhr, status, error) {
                console.error('Error al obtener los datos de la solicitud:', error);
            }
        });
        
    };

    function cambio() {
        //var opcionSeleccionada = $(this).val();
        var opcionSeleccionada = $('#cbDepartamento').val();
        //console.log('Opción seleccionada:', opcionSeleccionada);
        //alert(opcionSeleccionada);
        var catalogoSelect = $('#cbMunicipio');
        catalogoSelect.empty(); // Limpiar el select antes de agregar nuevas opciones

        $.ajax({
            url: `@ViewData["rutaApp"]/Solicitud/GetOrdenDepto/${opcionSeleccionada}`, // URL para obtener los datos
            type: 'GET',
            success: function (data) {
                var orden = data;
                //alert(orden);

                //console.log('Cargando intervenciones para DAAN');
                $.getJSON('@Url.Action("GetMunicipios", "Solicitud")', { id: orden },

                    function (data) {
                        //console.log('Datos devueltos:', data);
                        var items = data.value.value;
                        $.each(items, function (index, item) {
                            catalogoSelect.append('<option value="' + item.id + '">' + item.descripcion + '</option>');
                        });
                    });

            },
            error: function (xhr, status, error) {
                console.error('Error al obtener los datos de la solicitud:', error);
            }
        });
    }

    window.onpopstate = function (event) {
        // Cierra el modal si el usuario va hacia atrás
        var modalElement = document.getElementById('wNewSolicitud');
        var modal = bootstrap.Modal.getInstance(modalElement);

        if (modal) {
            modal.hide();
        }
    };

    function confirmarSolicitud(e) {
        var res = confirm("Esta seguro de eliminar la solicitud");
        if (res) return true;
        if (res == false) e.preventDefault();

        //return false;        
    }

    function confirmarEnvio(e,code, element, idDepto){
        /*var envio = confirm("¿Desea enviar la solicitud " + code + " a un status de evaluación?");
        if (envio) return true;
        if (envio == false) e.preventDefault();*/        

        e.preventDefault();

        Swal.fire({
            title: "ATENCIÓN",
            text: idDepto == "2" ? "¿Desea enviar la solicitud " + code + " a un status de revisión administrativa?" : "¿Desea enviar la solicitud " + code + " a un status de evaluación?",
            icon: "question",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Aceptar",
            cancelButtonText: "Cancelar"
        }).then((result) => {
            if (result.isConfirmed) {                
                //return true;
                window.location.href = element.href;
            } 
            else if (result.dismiss === Swal.DismissReason.cancel) 
            {               
                e.preventDefault(); // Evitar acción predeterminada si está vinculada a un evento               
            }
        });
    }    

    function cargarIntervenciones(){
        var opcionSeleccionada = $('#cbTipoAsistAlim').val();        
        var catalogoSelect = $('#cbIntervencion');
        
        catalogoSelect.empty();       

        if (opcionSeleccionada == "1") {
            //console.log('Cargando intervenciones para DAAN');
            
            $.getJSON('@Url.Action("GetCat", "Solicitud")', { tipoCatalogo: "INTERVENCION" },
                function (data) {
                    //console.log('Datos devueltos:', data);
                    var items = data.value.value;
                    $.each(items, function (index, item) {
                        catalogoSelect.append('<option value="' + item.id + '">' + item.descripcion + '</option>');
                    });
                });
        } else if (opcionSeleccionada == "2") {
            //console.log('Cargando intervenciones para DAPA');
            $.getJSON('@Url.Action("GetCat", "Solicitud")', { tipoCatalogo: "INTERVENCIONES" },
                function (data) {
                    //console.log('Datos devueltos:', data);
                    var items = data.value.value;
                    $.each(items, function (index, item) {
                        catalogoSelect.append('<option value="' + item.id + '">' + item.descripcion + '</option>');
                    });
                });
        }

        
    };

</script>


