    function cargarINFO() {
        //alert('ENTRO');

        var table = $('#excelDataTable').DataTable();

        event.preventDefault();
        // Crear un FormData con el archivo seleccionado
        var formData = new FormData();
        var fileInput = $("#fileExcel")[0].files[0];
        formData.append("fileExcel", fileInput);

        // Enviar el archivo al servidor mediante AJAX
        $.ajax({
            url: "/Solicitud/CargaMasiva?k=1", // Ruta al controlador que maneja la carga
            type: "POST",
            data: formData,
            contentType: false,
            processData: false,
            success: function (data) {
                table.clear();
                data.forEach(function (row) {
                    let rowData = [];
                    for (let key in row) {
                        if (row.hasOwnProperty(key)) {
                            rowData.push(row[key]);
                        }
                    }
                    table.row.add(rowData).draw(false);

                    //$("#excelDataTable tbody").append(rowHtml);
                });
            },
            error: function () {
                alert("Error al cargar el archivo Excel.");
            }
        });
    }//);

    function cargarINFO_APA() {
        //alert('ENTRO');
        var table = $('#excelDataTableAPA').DataTable();

        event.preventDefault();
        // Crear un FormData con el archivo seleccionado
        var formData = new FormData();
        var fileInput = $("#fileExcel")[0].files[0];
        formData.append("fileExcel", fileInput);
        cargandoAPA();
        $.ajax({
            url: "@ViewData["rutaApp"]/Solicitud/CargaMasiva?k=2",
            type: "POST",
            data: formData,
            contentType: false,
            processData: false,
            success: function (data) {                
                table.clear();
                //$("#excelDataTableAPA tbody").empty();
                
                data.forEach(function (row) {
                    table.row.add([
                        row.columna1,
                        row.columna2,
                        row.columna3,
                        row.columna4,
                        row.columna5,
                        row.columna6,
                        row.columna7,
                        row.columna8,
                        row.columna9,
                        row.columna10                        
                    ]).draw(false);
                    //$("#excelDataTable tbody").append(rowHtml);
                });
            },
            error: function () {
                alert("Error al cargar el archivo Excel.");
            },
            complete: function () {
                listoAPA();
            }
        });
    }//);

        function guardarINFO(hf){
            //alert('PARAMETRO: ' + hf);  es el idSolicitud
        var idIntervencion = @ViewBag.IdIntervencion;
        var table = $('#excelDataTable').DataTable();
        var datosTabla = [];

        table.rows().every(function (rowIdx, tableLoop, rowLoop) {
            var data = this.data();
            var fila = { columna1: hf };

            for (var i = 0; i < data.length; i++) {
                fila['columna' + (i + 2)] = data[i]; // +2 porque columna1 es hf
            }

            datosTabla.push(fila);
        });            ///console.log('DATA:' + JSON.stringify(datosTabla));
            cargando();
            // Enviar los datos al servidor mediante AJAX
            $.ajax({
                url: '@ViewData["rutaApp"]/Solicitud/GuardarCargaMasiva?k=1&idInteraccion=' + idIntervencion, // Ruta del controlador para guardar en BD
                type: 'POST',
                contentType: 'application/json',
                //data: JSON.stringify(datosTabla),
            data: JSON.stringify({
                InfoData: datosTabla, // Para infodat
                InfoDat: []         // Si no hay datos para infodata, pasa un arreglo vacío
            }),
            success: function (response) {
                    //alert("Datos guardados exitosamente en la BD");
                    $('#wCargaExcel').modal('hide');
                    location.reload();
                    
                },
                error: function (xhr, status, error) {
                    alert("Error al guardar los datos: " + error);
                },
                complete: function () {
                    listo();
                }
            });        
        }

    function guardarINFO_APA(hf) {
        //alert('Entro guardar info apa: ' + hf);  //es el idSolicitud
        var table = $('#excelDataTableAPA').DataTable();

        // Obtener los datos de la tabla
        var datosTabla = [];
        table.rows().every(function (rowIdx, tableLoop, rowLoop) {
            var data = this.data();
            datosTabla.push({
                columna1: hf,
                columna2: data[0],
                columna3: data[1],
                columna4: data[2],
                columna5: data[3],
                columna6: data[4],
                columna7: data[5],
                columna8: data[6],
                columna9: data[7],
                columna10: data[8]                              
            });
        });
        //console.log('DATA:' + JSON.stringify(datosTabla));

        cargandoAPA();
        $.ajax({
            url: '@ViewData["rutaApp"]/Solicitud/GuardarCargaMasiva?k=2',

            type: 'POST',
            contentType: 'application/json',
            //data: JSON.stringify(datosTabla),
            data: JSON.stringify({
                    InfoDat: datosTabla, // Para infodat
                    InfoData: []         // Si no hay datos para infodata, pasa un arreglo vacío
                   }),     
            success: function (response) {
                //alert("Datos guardados exitosamente en la BD");
                $('#wCargaExcelAPA').modal('hide');
                location.reload();

            },
            error: function (xhr, status, error) {
                alert('Cantidad de beneficiarios sobrepasa el límite aceptado de 250');
                //alert("Error al guardar los datos: " + error);
            },
            complete: function () {
                listoAPA();
            }
        });
    }

