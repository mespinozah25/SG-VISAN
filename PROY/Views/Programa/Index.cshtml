@model PROY.ViewModels.ProgramaVM;
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous">
<head>
</head>
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    ViewData["Title"] = "Programas";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}


@* <div class="=row">
        <div class="col-sm-8"> *@
<h2 class="float-start">Administración de Programas</h2> <a class="btn btn-primary btn-sm float-end" onclick="abrirModalYActualizarUrl(0)"><i class="fas fa-plus-square"></i> Programa</a>
<p><br /></p>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>NOMBRE PROGRAMA</th>
            <th>OPCIONES</th>
        </tr>
    </thead>
    <tbody>
        @try
        {
            foreach (var item in Model.listaProgramas)
            {
                <tr>
                    <td>@item.IdPrograma</td>
                    <td>@item.NombrePrograma</td>
                    
                    <td class="text-center">
                        <a class="btn btn-info btn-sm" onclick="abrirModalYActualizarUrl(@item.IdPrograma)"><i class="fas fa-edit"></i> Editar</a>
                        <a class="btn btn-danger btn-sm" asp-controller="Programa" asp-action="Eliminar" asp-route-id="@item.IdPrograma" onclick="confirmar(event)"><i class="fas fa-trash"></i> Eliminar</a>
                    </td>

                </tr>
            }
        }
        catch
        {

        }

    </tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="wNewPrograma" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="height:100%;">
            <form asp-action="GuardarPrograma" asp-controller="Programa" method="post">
                <div class="modal-header bg-secondary">
                    <h5 class="modal-title text-white" id="lblModalTitle">@ViewBag.ModalTitle</h5>
                    <button type="button" id="btnClose" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" id="idPrograma" asp-for="@Model.Programa.IdPrograma" />
                    <div>
                        <div class="col">
                            <label for="txtNombrePrograma" class="control-label">Nombre Programa</label>
                            <input type="text" class="form-control" id="txtNombrePrograma" asp-for="@Model.Programa.NombrePrograma" required></input>
                            <span asp-validation-for="@Model.Programa.NombrePrograma" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <br />
                <br />
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <input type="submit" value="Guardar" class="btn btn-primary" />
                </div>
            </form>

        </div>
    </div>
</div>



@section Scripts {

    <script>
        function abrirModalYActualizarUrl(id) {
            if (id == 0) {
                var ventanaTitle = document.getElementById("lblModalTitle");
                ventanaTitle.textContent = "REGISTRO PROGRAMA";

                $('#idPrograma').val(0);
                $('#txtNombrePrograma').val('');
            }
            else {
                var ventanaTitle = document.getElementById("lblModalTitle");
                ventanaTitle.textContent = "MODIFICAR PROGAMA";

                $.ajax({
                    url: `@ViewData["rutaApp"]/Programa/ObtenerPrograma/${id}`, // URL para obtener los datos
                    type: 'GET',
                    success: function (data) {

                        console.log('data' + JSON.stringify(data));
                        // Llenar el formulario del modal con los datos del programa
                        $('#idPrograma').val(id);
                        $('#txtNombrePrograma').val(data.nombre);

                    },
                    error: function (xhr, status, error) {
                        console.error('Error al obtener los datos del programa:', error);
                    }
                });
            }

            var modal = new bootstrap.Modal(document.getElementById('wNewPrograma'));
            modal.show();
        }


        function confirmar(e){

            e.preventDefault();

            Swal.fire({
                title: "Desea eliminar el Programa?",
                text: "Este proceso eliminará el Programa.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Eliminar!"
            }).then((result) => {
                if (result.isConfirmed) {

                    Swal.fire({
                        title: "Eliminado!",
                        text: "Programa eliminado con éxito.",
                        icon: "success"
                    });

                    window.location.href = e.target.href;

                    return true;
                } else{
                    e.preventDefault();
                }
            });

        }
    </script>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>