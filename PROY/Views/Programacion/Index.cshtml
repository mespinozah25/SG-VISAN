    //--------------------------------------------------------
    
    function AddTecnico(hfSolicitudID) {

        //var nombre = $('#txtTecnicoAsignado').val();
        //var telefono = $('#txtTecnicoTelefono').val();

        var valorTecnico = $('#cbTecnicoAsigna').val();
        var valorDepto = $('#cbDeptoAsigna').val();
        var valorMuni = $('#cbMuniAsigna').val();        
        var valorDir = $('#txtDirEntregaAsigna').val();
        var solicitud = hfSolicitudID;

        //alert(valorTecnico + ' ' + valorDepto + ' ' + valorMuni + ' ' + valorDir);        
        //alert('DEPTO ' + valorDepto);
        $.ajax({
            url: '@ViewData["rutaApp"]/Solicitud/AsignaTecnico?k=1', // Ruta del controlador para guardar en BD
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                asignaTecnico: {
                    TecnicoId: valorTecnico,
                    SolicitudId: solicitud,                                        
                    IdMunicipio: valorMuni,
                    DireccionEntrega: valorDir,
                    DepartamentoId: valorDepto
                }
            }),
            success: function (response) {                
                $.ajax({
                    url: `@ViewData["rutaApp"]/Solicitud/ObtenerDetalleTecnicosSolicitud/${hfSolicitudID}`, // URL para obtener los datos
                    method: 'GET',
                    dataType: 'json',
                    success: function (data) {                        
                        //console.log('data........' + JSON.stringify(data.detalleTecnicos));
                        const datosFiltrados = data.detalleTecnicos.map(info => ({
                            IdAsignaTecnico: info.idAsignaTecnico,
                            Tecnico: info.tecnico.nombre,
                            Telefono: info.tecnico.telefono,
                            Departamento: info.departamentoId,
                            Municipio: info.idMunicipio,
                            DirEntrega: info.direccionEntrega
                            
                        }));

                        // Llenar el formulario del modal con los datos de la solicitud
                        const table = $('#tablaDetalles').DataTable({
                            destroy: true, // Permite reiniciar la tabla con nuevos datos 
                            paging: true,
                            pageLength: 5,
                            lengthChange: false,
                            data: datosFiltrados, // Asigna los datos al DataTable
                            columns: [
                                { data: 'Tecnico', title: 'Técnico' },
                                { data: 'Telefono', title: 'Teléfono' },
                                { data: 'Departamento', title: 'Departamento' },
                                { data: 'Municipio', title: 'Municipio' },
                                { data: 'DirEntrega', title: 'Dirección entrega' },
                                {
                                    title: 'Acciones',
                                    data: null,
                                    render: function (data, type, row) {
                                        //console.log('data' + data + ' row ' + row);
                                        //console.log('.....' + JSON.stringify(data) + '---' + idSolicitud);
                                        return `<a class="btn btn-danger btn-sm btn-eliminar" onclick="eliminarTecnico(${data.IdAsignaTecnico},${hfSolicitudID})"><i class="fas fa-trash"></i> Eliminar</a>`;
                                    }
                                }
                            ]
                        });
                        table.draw(false);
                    },
                    error: function (xhr, status, error) {
                        console.error("Ocurrió un error:", error);
                    }
                });
            },
            error: function (xhr, status, error) {
                alert("Error al guardar los datos: " + error);
            }
        });        
    }

    function abrirModalYActualizarUrl(idSolicitud, idDepto) {
        //------------------Load automatic Deptos----------------------------
        var catalogoSelect = $('#cbDeptoAsigna');
        catalogoSelect.empty(); // Limpiar el select antes de agregar nuevas opciones

        $.ajax({
            url: `@ViewData["rutaApp"]/Programacion/CargarCombos/${idSolicitud}`, // URL para obtener los datos
            type: 'GET',
            success: function (data) {
                //var orden = data;
                //alert(orden);

                //console.log('Cargando intervenciones para DAAN');
                $.getJSON('@Url.Action("CargarCombos", "Programacion")', { id: idSolicitud },

                    function (data) {
                        //console.log('Datos devueltos:', data.result);
                        //var items = data.value.value;
                        var items = data.result;
                        $.each(items, function (index, item) {
                            catalogoSelect.append('<option value="' + item.idCatalogo + '">' + item.descripcion + '</option>');
                        });

                        $('#cbDeptoAsigna option:first').prop('selected', true);
                        //var vv=$('#cbDeptoAsigna').val();
                        //alert(vv);
                        cambio();
                    });

                    
                    //cambio();
            },
            error: function (xhr, status, error) {
                console.error('Error al obtener los datos de la solicitud:', error);
            }
        });
        //----------------------------------------------
        
        

        // Actualiza la URL sin recargar la página
        const nuevaUrl = `@ViewData["rutaApp"]/Solicitud/Index/${idSolicitud}`;
        //alert(nuevaUrl);
        history.pushState(null, '', nuevaUrl);
        //alert('ID:' + idSolicitud);

        if (idSolicitud == 0) {
            //$('#lblModalTitle').val('NUEVA SOLICITUD');
            var ventanaTitle = document.getElementById("lblModalTitle");
            ventanaTitle.textContent = "REGISTRO SOLICITUD";

