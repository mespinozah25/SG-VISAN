    function cambioMuniRacion() {

        //var opcionSeleccionada = $(this).val();
        var opcionSeleccionada = $('#cbDeptoRacion').val();
        //console.log('Opción seleccionada:', opcionSeleccionada);
        //alert(opcionSeleccionada);
        //alert(idSolicitud);
        var catalogoSelect = $('#cbMuniRacion');
        catalogoSelect.empty(); // Limpiar el select antes de agregar nuevas opciones

        $.ajax({
            url: `@ViewData["rutaApp"]/Solicitud/GetOrdenDepto/${opcionSeleccionada}`, // URL para obtener los datos
            type: 'GET',
            success: function (data) {
                var orden = data;
                //alert(orden);

                //console.log('Cargando intervenciones para DAAN');
                $.getJSON('@Url.Action("GetMunicipios", "Solicitud")', { id: orden },

                    function (data) {
                        //console.log('Datos devueltos:', data);
                        var items = data.value.value;
                        $.each(items, function (index, item) {
                            /*---------------*/
                            
                            var existe = false;
                            $('#tblAgrupado tbody tr').each(function () {
                                var departamento = $(this).find("td:eq(0)").text().trim();
                                var municipio = $(this).find("td:eq(1)").text().trim();

                                var deptoCombo=$('#cbDeptoRacion option:selected').text();

                                //console.log('Depto Combo'+$('#cbDeptoRacion option:selected').text()+'Depto tabla'+departamento + ' ' + 'Muni' + municipio);

                                if (deptoCombo === departamento && municipio === item.descripcion) {
                                    existe = true;
                                    return false; // Salir del bucle
                                }
                            });

                            if (existe) {
                                catalogoSelect.append('<option value="' + item.id + '">' + item.descripcion + '</option>');
                            }

                            /*catalogoSelect.append('<option value="' + item.id + '">' + item.descripcion + '</option>');*/
                        });
                    });                   

            },
            error: function (xhr, status, error) {
                console.error('Error al obtener los datos de la solicitud:', error);
            }
        });
    }
    
