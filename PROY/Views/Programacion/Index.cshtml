@using PROY.Controllers
@inject IHttpContextAccessor HttpContextAccessor
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous">

<style>
    .modal-header .btn-close {
        color: white !important; /* Asegura que el ícono de la "X" sea blanco */
        opacity: 1;
        -webkit-filter:invert(1);
    }
</style>

@model PROY.ViewModels.SolicitudesVM

@{
    ViewData["Title"] = "Index";
    ViewData["rutaApp"] = @Model.rutaApp;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var depto = "";

    try
    {
        depto = User.FindFirst("depto")?.Value;
    }
    catch
    {

    }

    var rol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var idDepto = User.FindFirst("idDepto")?.Value;
    var usr = User.FindFirst("Usuario")?.Value;
}

@{
    // Usamos el HttpContext inyectado para acceder al QueryString
    var valorK = HttpContextAccessor.HttpContext?.Request.Query["k"].ToString();
    bool tieneValorK = !string.IsNullOrEmpty(valorK);
    var condicion = "";

    if ((depto == "DAAN" && rol != "Admin") || (tieneValorK && valorK == "1" && rol == "Admin"))
        condicion = "1";
    else if ((depto == "DAPA" && rol != "Admin") || (tieneValorK && valorK == "2" && rol == "Admin"))
        condicion = "2";

    //Verificar DEPTO
    if (rol == "Admin")
    {
        if (valorK == "1")
            idDepto = "1";
        else if (valorK == "2")
            idDepto = "2";
    }
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}
else if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger">
        @TempData["MensajeError"]
    </div>
}

<h2 class="float-start">Solicitudes en Programación</h2>@* <a class="btn btn-primary btn-sm float-end" onclick="abrirModalYActualizarUrl(0)"><i class="fas fa-plus-square"></i> Nueva Solicitud</a> *@
@* <button type="button" class="btn btn-primary float-end" data-bs-toggle="modal" data-bs-target="#wNewSolicitud">Nueva Solicitud</button> *@
<p><br /></p>
<table class="table" style="width:100%;">
    <thead>
        <tr>
            <th>
                CODIGO
            </th>
            <th>
                No. SOLICITUD
            </th>
            @if (idDepto == "1")
            {
                <th>
                    INSTITUCION
                </th>
            }
            else if (idDepto == "2")
            {
                <th>
                    PROYECTO
                </th>
            }
            <th>
                INTERVENCION
            </th>
            <th>
                FECHA INGRESO A DESPACHO
            </th>
            <th>
                FECHA INGRESO A DIRECCIÓN
            </th>
            <th>
                FECHA INGRESO A DEPARTAMENTO
            </th>
            <th>
                MEDIO VERIFICACIÓN
            </th>
            <th>FALLECIDOS</th>
            <th>DUPLICADOS</th>
            <th>SIN DATOS</th>
            <th>GOBIERNO</th>
            <th>VÁLIDOS</th>
            <th>OPCIONES</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Solicitudes)
        {
            <tr>
                <td>
                    @item.Codigo
                </td>
                <td>
                    @item.Correlativo
                </td>
                @if (idDepto == "1")
                {
                    <td>
                        @{
                            // Obtener la descripción usando el diccionario
                            /*string descripcionInstitucion = Model.InstitucionDict.TryGetValue(item.IdInstitucion, out var descInst)
                            ? descInst
                            : "Institución no encontrada";*/

                            string descripcionInstitucion = item.IdInstitucion.HasValue
                            ? Model.InstitucionDict.TryGetValue(item.IdInstitucion.Value, out var descInst)
                            ? descInst : "Institución no encontrada"
                            : "IdInstitución no especificada";
                        }
                        @descripcionInstitucion
                    </td>
                }
                else if (idDepto == "2")
                {
                    <td>
                        @{
                            // Obtener la descripción usando el diccionario
                            /*string descripcionInstitucion = Model.InstitucionDict.TryGetValue(item.IdInstitucion, out var descInst)
                            ? descInst
                            : "Institución no encontrada";*/

                            string descripcionProyecto = item.IdProyecto.HasValue
                            ? Model.ProyectoDict.TryGetValue(item.IdProyecto.Value, out var descProy)
                            ? descProy : "Proyecto no encontrado"
                            : "IdProyecto no especificado";
                        }
                        @descripcionProyecto
                    </td>
                }

                <td>
                    @{
                        // Obtener la descripción usando el diccionario
                        string descripcionIntervencion = Model.IntervencionDict.TryGetValue(item.IdIntervencion, out var descInter)
                        ? descInter
                        : "Intervención no encontrada";
                    }
                    @descripcionIntervencion
                </td>
                <td>
                    @item.FechaIngresoDespacho.Date.ToString("dd/MM/yyyy")
                </td>
                <td>
                    @item.FechaIngresoDireccion.Date.ToString("dd/MM/yyyy")
                </td>
                <td>
                    @item.FechaIngresoUnidad.Date.ToString("dd/MM/yyyy")
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(item.Archivo))
                    {
                        <a href="@Url.Action("PreviewFile", new { fileName = item.Archivo })" target="_blank">
                            <i class="fas fa-file-pdf"></i> Ver PDF
                        </a>
                    }
                    else
                    {
                        <span>No disponible</span>
                    }
                </td>
                @* <td>@item.Fallecidos</td> *@
                <td>
                    @{
                        int contadorFallecido = 0;
                    }

                    @try
                    {
                        if (idDepto == "1")
                        {
                            contadorFallecido = 0;
                            foreach (var detalle in item.DetallesSolicitud ?? Enumerable.Empty<DetalleSolicitud>())
                            {
                                foreach (var cat in Model.AnulacionDict)
                                {
                                    if (detalle.IdAnulacion != null)
                                    {
                                        if (detalle.IdAnulacion == cat.Key && cat.Value == "FALLECIDO")
                                        {
                                            contadorFallecido++;
                                        }
                                    }
                                }
                                //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")
                            }
                        }
                        else if (idDepto == "2")
                        {
                            contadorFallecido = 0;
                            foreach (var detalle in item.DetallesSolicitudAPA ?? Enumerable.Empty<DetalleSolicitudAPA>())
                            {
                                foreach (var cat in Model.AnulacionDict)
                                {
                                    if (detalle.IdAnulacion != null)
                                    {
                                        if (detalle.IdAnulacion == cat.Key && cat.Value == "FALLECIDO")
                                        {
                                            contadorFallecido++;
                                        }
                                    }
                                }
                                //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")
                            }

                            @*foreach (var detalle in Model.listaDetallesSolicitudAPA ?? Enumerable.Empty<DetalleSolicitudAPA>())
                {
                foreach (var cat in Model.AnulacionDict)
                {
                if (detalle.IdAnulacion == cat.Key && cat.Value == "FALLECIDO" && detalle.IdSolicitud==item.IdSolicitud)
                {
                contadorFallecido++;
                }
                }
                //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")
                }*@
                        }
                    }
                    catch
                    {

                    }

                    @contadorFallecido
                    @* @{int contadorFallecido=0;}
                @try{
                contadorFallecido = Model.Solicitudes.Where(s => s.Restrictiva == 0 && s.Depto == "DAAN")
                .SelectMany(s => s.DetallesSolicitud)
                .Where(d => d.Restrictiva == 0 && d.IdAnulacion != 0)
                .Count(d => d.catalogo.Descripcion == "FALLECIDO" && d.catalogo.IdCatalogo == d.IdAnulacion);

                }
                catch
                {

                } *@

                </td>
                @* <td>@item.Duplicados</td> *@
                <td>
                    @{
                        int contadorDuplicado = 0;
                    }

                    @try
                    {
                        if (idDepto == "1")
                        {
                            foreach (var detalle in item.DetallesSolicitud ?? Enumerable.Empty<DetalleSolicitud>())
                            {
                                foreach (var cat in Model.AnulacionDict)
                                {
                                    if (detalle.IdAnulacion == cat.Key && cat.Value == "DUPLICADO")
                                    {
                                        contadorDuplicado++;
                                    }
                                }
                                //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")
                            }
                        }
                        else if (idDepto == "2")
                        {
                            foreach (var detalle in item.DetallesSolicitudAPA ?? Enumerable.Empty<DetalleSolicitudAPA>())
                            {
                                foreach (var cat in Model.AnulacionDict)
                                {
                                    if (detalle.IdAnulacion == cat.Key && cat.Value == "DUPLICADO")
                                    {
                                        contadorDuplicado++;
                                    }
                                }
                                //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")
                            }
                        }
                    }
                    catch
                    {

                    }

                    @contadorDuplicado
                </td>
                @* <td>@item.SinDatos</td> *@
                <td>
                    @{
                        int contadorSinDatos = 0;
                    }

                    @try
                    {
                        if (idDepto == "1")
                        {
                            foreach (var detalle in item.DetallesSolicitud ?? Enumerable.Empty<DetalleSolicitud>())
                            {
                                foreach (var cat in Model.AnulacionDict)
                                {
                                    if (detalle.IdAnulacion == cat.Key && cat.Value == "SIN DATOS")
                                    {
                                        contadorSinDatos++;
                                    }
                                }
                                //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")
                            }
                        }
                        else if (idDepto == "2")
                        {
                            foreach (var detalle in item.DetallesSolicitudAPA ?? Enumerable.Empty<DetalleSolicitudAPA>())
                            {
                                foreach (var cat in Model.AnulacionDict)
                                {
                                    if (detalle.IdAnulacion == cat.Key && cat.Value == "SIN DATOS")
                                    {
                                        contadorSinDatos++;
                                    }
                                }
                                //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")
                            }
                        }
                    }
                    catch
                    {

                    }

                    @contadorSinDatos
                </td>
                @* <td>@item.Gobierno</td> *@
                <td>
                    @{
                        int contadorGobierno = 0;
                    }

                    @try
                    {
                        if (idDepto == "1")
                        {
                            foreach (var detalle in item.DetallesSolicitud ?? Enumerable.Empty<DetalleSolicitud>())
                            {
                                foreach (var cat in Model.AnulacionDict)
                                {
                                    if (detalle.IdAnulacion == cat.Key && cat.Value == "GOBIERNO")
                                    {
                                        contadorGobierno++;
                                    }
                                }
                                //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")
                            }
                        }
                        else if (idDepto == "2")
                        {
                            foreach (var detalle in item.DetallesSolicitudAPA ?? Enumerable.Empty<DetalleSolicitudAPA>())
                            {
                                foreach (var cat in Model.AnulacionDict)
                                {
                                    if (detalle.IdAnulacion == cat.Key && cat.Value == "GOBIERNO")
                                    {
                                        contadorGobierno++;
                                    }
                                }
                                //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")
                            }
                        }
                    }
                    catch
                    {

                    }

                    @contadorGobierno
                </td>
                <td>
                    @{
                        int contadorValidos = 0;
                    }

                    @try
                    {
                        if (idDepto == "1")
                        {
                            foreach (var detalle in item.DetallesSolicitud ?? Enumerable.Empty<DetalleSolicitud>())
                            {
                                contadorValidos++;
                            }
                            contadorValidos = contadorValidos - contadorFallecido - contadorDuplicado - contadorSinDatos - contadorGobierno;
                        }
                        else if (idDepto == "2")
                        {
                            foreach (var detalle in item.DetallesSolicitudAPA ?? Enumerable.Empty<DetalleSolicitudAPA>())
                            {
                                contadorValidos++;
                            }
                            contadorValidos = contadorValidos - contadorFallecido - contadorDuplicado - contadorSinDatos - contadorGobierno;
                        }
                    }
                    catch
                    {

                    }

                    @contadorValidos
                </td>
                <td>
                    @if (rol == "Admin")
                    {
                        <a class="btn btn-primary btn-sm" onclick="abrirModalYActualizarUrl(@item.IdSolicitud, @idDepto)"><i class="fas fa-edit"></i> Ajustes</a>
                    }   
                    else
                    {
                        if (usr == item.UsuarioRegistro)
                        {
                            <a class="btn btn-primary btn-sm" onclick="abrirModalYActualizarUrl(@item.IdSolicitud, @idDepto)"><i class="fas fa-edit"></i> Ajustes</a>
                        }
                        else
                        {
                            <a class="btn btn-gray btn-sm disabled" href="javascript:void(0);"><i class="fas fa-edit"></i> Ajustes</a>
                        }
                    }
                    
                    
                    @* <a class="btn btn-warning btn-sm" asp-action="NuevaSolicitud" asp-route-id="@item.IdSolicitud">Editar</a> |*@
                    @* <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#wNewSolicitud">Editar</button> | *@
                    @* <a href="/Solicitud/Index/@item.IdSolicitud" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#wNewSolicitud">Editar</a> | *@

                    @* <a href="@Url.Action("Index", new { id = item.IdSolicitud })" class="btn btn-danger btn-sm">Editar</a> *@
                    @if (rol == "Admin")
                    {
                        <a class="btn btn-dark btn-sm" asp-controller="Programacion" asp-action="ListaDetalle" asp-route-idProgramacion="@item.IdSolicitud" asp-route-k="@condicion" asp-route-returnController="Programacion"><i class="fas fa-bars"></i> Beneficiarios</a>
                    }
                    else
                    {
                        if (usr == item.UsuarioRegistro)
                        {
                            <a class="btn btn-dark btn-sm" asp-controller="Programacion" asp-action="ListaDetalle" asp-route-idProgramacion="@item.IdSolicitud" asp-route-returnController="Programacion"><i class="fas fa-bars"></i> Beneficiarios</a>
                        }
                        else
                        {
                            <a class="btn btn-gray btn-sm disabled" href="javascript:void(0);"><i class="fas fa-bars"></i> Beneficiarios</a>
                        }
                        
                    }

                    @if (rol == "Admin")
                    {
                        <a class="btn btn-info btn-sm" asp-controller="Evaluacion" asp-action="IndexDetalle" asp-route-idEvaluacion="@item.IdSolicitud" asp-route-k="@condicion" asp-route-returnController="Programacion" asp-route-proceso="PROGRAMACION"><i class="fas fa-bars"></i> Medios Verificación</a>
                    }
                    else
                    {
                        if (usr == item.UsuarioRegistro)
                        {
                            <a class="btn btn-info btn-sm" asp-controller="Evaluacion" asp-action="IndexDetalle" asp-route-idEvaluacion="@item.IdSolicitud" asp-route-k="@condicion" asp-route-returnController="Programacion" asp-route-proceso="PROGRAMACION"><i class="fas fa-bars"></i> Medios Verificación</a>
                        }
                        else
                        {
                            <a class="btn btn-gray btn-sm disabled" href="javascript:void(0);"><i class="fas fa-bars"></i> Medios Verificación</a>
                        }

                    }

                    @if (rol == "Admin")
                    {
                        @if (item.BotonDespacho == true)
                        {
                            <a class="btn btn-warning btn-sm" onclick="abrirModalResumen(@item.IdSolicitud, @idDepto)"><i class="fas fa-bars"></i> Solicitud despacho</a>
                        }
                        else
                        {
                            <a class="btn btn-warning btn-sm disabled" href="javascript:void(0);"><i class="fas fa-bars"></i> Solicitud despacho</a>
                        }
                    }
                    else
                    {
                        if (usr == item.UsuarioRegistro)
                        {
                            @if (item.BotonDespacho == true)
                            {
                                <a class="btn btn-warning btn-sm" onclick="abrirModalResumen(@item.IdSolicitud, @idDepto)"><i class="fas fa-bars"></i> Solicitud despacho</a>
                            }
                            else
                            {
                                <a class="btn btn-warning btn-sm disabled" href="javascript:void(0);"><i class="fas fa-bars"></i> Solicitud despacho</a>
                            }
                        }
                        else
                        {
                            <a class="btn btn-gray btn-sm disabled" href="javascript:void(0);"><i class="fas fa-bars"></i> Solicitud despacho</a>
                        }
                    }

                    
                    @if (rol == "Admin")
                    {
                        <a class="btn btn-danger btn-sm" asp-controller="Programacion" asp-action="EnviarProgramacion" asp-route-idProgramacion="@item.IdSolicitud" asp-route-k="@condicion" onclick="confirmarEnvio(event,'@item.Codigo', this)" title="Enviar solicitud a status de ejecución"><i class="fas fa-bolt"></i> Enviar</a>
                    }
                    else
                    {
                        if (usr == item.UsuarioRegistro)
                        {
                            <a class="btn btn-danger btn-sm" asp-controller="Programacion" asp-action="EnviarProgramacion" asp-route-idProgramacion="@item.IdSolicitud" onclick="confirmarEnvio(event,'@item.Codigo', this)"><i class="fas fa-bolt" title="Enviar solicitud a status de ejecución"></i> Enviar</a>
                        }
                        else
                        {
                            <a class="btn btn-gray btn-sm disabled" href="javascript:void(0);"><i class="fas fa-bolt"></i> Enviar</a>
                        }
                        
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="wEditProgramacion" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content" style="height:1190px;">
            <form asp-action="GuardarSolicitud" asp-controller="Solicitud" asp-route-k="@idDepto" asp-route-returnController="Programacion" enctype="multipart/form-data" method="post">
                <div class="modal-header bg-secondary">
                    <h5 class="modal-title text-white" id="lblModalTitle">@ViewBag.ModalTitle</h5>
                    <button type="button" id="btnClose" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" id="solicitudId" asp-for="Solicitud.IdSolicitud" />
                    @* <div class="form-group">
                    <label>Correlativo</label>
                    <input asp-for="@Model.Solicitud.Correlativo" class="form-control" required/>
                    <span asp-validation-for="@Model.Solicitud.Correlativo" class="text-danger"></span>
                    </div> *@
                    <div class="row">
                        <div class="col-12">
                            <div class="row">
                                <div class="col">
                                    <label class="control-label">Departamento</label>
                                    @if (idDepto == "1")
                                    {
                                        <select class="form-select" id="cbUnidad" name="Solicitud.Depto" required disabled>
                                            <option value="1" selected>Asistencia alimentaria</option>
                                        </select>
                                    }
                                    else if (idDepto == "2")
                                    {
                                        <select class="form-select" id="cbUnidad" name="Solicitud.Depto" required disabled>
                                            <option value="2" selected>Alimentos por acción</option>
                                        </select>
                                    }
                                    @*<select class="form-select" id="cbunidad" asp-for="@Model.Solicitud.Depto" asp-items="ViewBag.Unidades" disabled></select>*@
                                    <span asp-validation-for="@Model.Solicitud.Depto" class="text-danger"></span>
                                </div>
                                @if (idDepto == "1")
                                {
                                    <div class="col">
                                        <label for="cbInstitucion" class="control-label">Institución</label>
                                        <select class="form-select" id="cbInstitucion" asp-for="@Model.Solicitud.IdInstitucion" asp-items="ViewBag.Instituciones" required disabled></select>
                                        <span asp-validation-for="@Model.Solicitud.IdInstitucion" class="text-danger"></span>
                                    </div>
                                }                                
                            </div>
                            <div class="row">
                                <div class="col">
                                    <label for="txtNoSolicitud" class="control-label">No. Solicitud</label>
                                    <input asp-for="@Model.Solicitud.Correlativo" type="text" id="txtNoSolicitud" class="form-control" disabled/>
                                    <span asp-validation-for="@Model.Solicitud.Correlativo" class="text-danger"></span>
                                </div>
                                <div class="col">
                                    <label class="control-label">Intervención</label>
                                    <select class="form-select" id="cbIntervencion" asp-for="@Model.Solicitud.IdIntervencion" asp-items="ViewBag.Intervenciones" disabled></select>
                                    <span asp-validation-for="@Model.Solicitud.IdIntervencion" class="text-danger"></span>
                                </div>
                                @if (idDepto == "2")
                                {
                                    <div class="col">
                                        <label for="cbProyecto" class="control-label">Proyecto</label>
                                        <select class="form-select" id="cbProyecto" asp-for="@Model.Solicitud.IdProyecto" asp-items="ViewBag.Proyectos" required disabled></select>
                                        <span asp-validation-for="@Model.Solicitud.IdProyecto" class="text-danger"></span>
                                    </div>
                                }
                            </div>

                            @if (idDepto == "2")
                            {
                                <div class="row">
                                    <div class="col">
                                        <label for="cbDepartamento" class="control-label">Departamento</label>
                                        <select class="form-select" id="cbDepartamento" asp-for="@Model.Solicitud.Departamento" asp-items="ViewBag.Departamentos" onchange="cambio()" required disabled></select>
                                        <span asp-validation-for="@Model.Solicitud.Departamento" class="text-danger"></span>
                                    </div>
                                    <div class="col">
                                        <label for="cbMunicipio" class="control-label">Municipio</label>
                                        <select class="form-select" id="cbMunicipio" asp-for="@Model.Solicitud.Municipio" asp-items="ViewBag.Municipios" required disabled></select>
                                        <span asp-validation-for="@Model.Solicitud.Municipio" class="text-danger"></span>
                                    </div>
                                    <div class="col">
                                        <label for="txtComunidad" class="control-label">Comunidad</label>
                                        <input type="text" class="form-control" id="txtComunidad" asp-for="@Model.Solicitud.Comunidad" required disabled></input>
                                        <span asp-validation-for="@Model.Solicitud.Comunidad" class="text-danger"></span>
                                    </div>
                                </div>
                            }

                            <div class="row">
                                <div class="col">
                                    <label class="control-label">Fecha Ingreso a Despacho</label>
                                    <input asp-for="@Model.Solicitud.FechaIngresoDespacho" id="fdespacho" class="form-control" type="date" disabled />
                                    <span asp-validation-for="@Model.Solicitud.FechaIngresoDespacho" class="text-danger"></span>
                                </div>
                                <div class="col">
