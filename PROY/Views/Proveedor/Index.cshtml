@model PROY.ViewModels.ProveedorVM;
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous">
<head>
</head>
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    ViewData["Title"] = "Proveedores";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}


@* <div class="=row">
        <div class="col-sm-8"> *@
<h2 class="float-start">Administración de Proveedores</h2> <a class="btn btn-primary btn-sm float-end" onclick="abrirModalYActualizarUrl(0)"><i class="fas fa-plus-square"></i> Proveedores</a>
<p><br /></p>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>NOMBRE PROVEEDOR</th>
            <th>OPCIONES</th>
        </tr>
    </thead>
    <tbody>
        @try
        {
            foreach (var item in Model.listaProveedor)
            {
                <tr>
                    <td>@item.IdProveedor</td>
                    <td>@item.NombreProveedor</td>

                    <td class="text-center">
                        <a class="btn btn-info btn-sm" onclick="abrirModalYActualizarUrl(@item.IdProveedor)"><i class="fas fa-edit"></i> Editar</a>
                        <a class="btn btn-danger btn-sm" asp-controller="Proveedor" asp-action="Eliminar" asp-route-id="@item.IdProveedor" onclick="confirmar(event)"><i class="fas fa-trash"></i> Eliminar</a>
                    </td>

                </tr>
            }
        }
        catch
        {

        }

    </tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="wNewProveedor" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="height:290px;">
            <form asp-action="GuardarProveedor" asp-controller="Proveedor" method="post">
                <div class="modal-header bg-secondary">
                    <h5 class="modal-title text-white" id="lblModalTitle">@ViewBag.ModalTitle</h5>
                    <button type="button" id="btnClose" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" id="idProveedor" asp-for="@Model.Proveedor.IdProveedor" />
                    <div>
                        <div class="col">
                            <label for="txtNombreProveedor" class="control-label">Nombre Proveedor</label>
                            <input type="text" class="form-control" id="txtNombreProveedor" asp-for="@Model.Proveedor.NombreProveedor" required></input>
                            <span asp-validation-for="@Model.Proveedor.NombreProveedor" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <input type="submit" value="Guardar" class="btn btn-primary" />
                </div>
            </form>

        </div>
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function abrirModalYActualizarUrl(id) {
            if (id == 0) {
                var ventanaTitle = document.getElementById("lblModalTitle");
                ventanaTitle.textContent = "REGISTRO PROVEEDOR";

                $('#idProveedor').val(0);
                $('#txtNombreProveedor').val('');
            }
            else {
                var ventanaTitle = document.getElementById("lblModalTitle");
                ventanaTitle.textContent = "MODIFICAR PROVEEDOR";
            }

            var modal = new bootstrap.Modal(document.getElementById('wNewProveedor'));
            modal.show();

            $.ajax({
                url: `@ViewData["rutaApp"]/Proveedor/ObtenerProveedor/${id}`, // URL para obtener los datos
                type: 'GET',
                success: function (data) {

                    console.log('data' + JSON.stringify(data));
                    // Llenar el formulario del modal con los datos de la solicitud
                    $('#idProveedor').val(id);
                    $('#txtNombreProveedor').val(data.nombre);
                    //alert(id);

                    var ventanaTitle = document.getElementById("lblModalTitle");
                    ventanaTitle.textContent = "MODIFICAR PROVEEDOR ";
                },
                error: function (xhr, status, error) {
                    console.error('Error al obtener los datos del proveedor:', error);
                }
            });
        }

        function confirmar(e){
            var res=confirm("Esta seguro de eliminar el proveedor");
            if (res) return true;
            if (res==false) e.preventDefault();

            //return false;
        }
    </script>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>