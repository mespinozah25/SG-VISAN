                    },
                    error: function (xhr, status, error) {
                        console.error("Ocurrió un error:", error);
                    }
                });
            },
            error: function () {
                alert('Error al eliminar la ración.');
            }
        });
    }

    function AddRacion(hfSolicitudID) {
        var valorDepto = $('#cbDeptoRacion').val();
        var valorMuni = $('#cbMuniRacion').val();
        var valorRacion = $('#txtRacion').val();
        var solicitud = hfSolicitudID;
        //alert(valorMuni + ' ' + valorRacion);

        $.ajax({
            url: '@ViewData["rutaApp"]/Solicitud/AsignaRacion?k=1', // Ruta del controlador para guardar en BD
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                asignaRacion: {
                    SolicitudId: solicitud,
                    DepartamentoId: valorDepto,
                    IdMunicipio: valorMuni,
                    RacionAsignada: valorRacion,
                    RacionSaldo: 0
                }
            }),
            success: function (response) {
                $.ajax({
                    url: `@ViewData["rutaApp"]/Solicitud/ObtenerDetalleRacionesSolicitud/${solicitud}`, // URL para obtener los datos
                    method: 'GET',
                    dataType: 'json',
                    success: function (data) {
                        //console.log('data' + JSON.stringify(data.detalleRaciones));
                        const datosFiltrados = data.detalleRaciones.map(raciones => ({
                            IdAsignaRacion: raciones.idAsignaRacion,
                            SolicitudId: raciones.solicitudId,
                            IdMunicipio: raciones.idMunicipio,
                            DepartamentoId: raciones.departamentoId,
                            RacionAsignada: raciones.racionAsignada,
                            RacionSaldo: raciones.racionSaldo
                        }));

                        // Llenar el formulario del modal con los datos de la solicitud
                        const table = $('#tblRacionesDespacho').DataTable({
                            destroy: true, // Permite reiniciar la tabla con nuevos datos
                            paging: true,
                            dom: 'lrtip',
                            pageLength: 5,
                            lengthChange: false,
                            data: datosFiltrados, // Asigna los datos al DataTable
                            columns: [
                                { data: 'IdMunicipio', title: 'Municipio' },
                                { data: 'RacionAsignada', title: 'Racion' },
                                { data: 'RacionSaldo', title: 'Saldo' },
                                {
                                    title: 'Acciones',
                                    data: null,
                                    render: function (data, type, row) {
                                        return `<button class="btn btn-danger btn-sm btn-eliminar" onclick="eliminarRacion(${row.IdAsignaRacion},${solicitud})"><i class="fas fa-trash"></i> Eliminar</button>`;
                                    }
                                }
                            ]
                        });
                        table.draw(false);
                    },
                    error: function (xhr, status, error) {
                        console.error("Ocurrió un error:", error);
                    }
                });
            },
            error: function (xhr, status, error) {
                alert("Error al guardar los datos: " + error);
            }
        });

    }

    function confirmarEnvio(e, code) {
        var envio = confirm("¿Desea enviar la solicitud " + code + " a un status de ejecución?");
        if (envio) return true;
        if (envio == false) e.preventDefault();
    }

    function cargarIntervenciones() {
        var opcionSeleccionada = $('#cbunidad').val();
        var catalogoSelect = $('#cbIntervencion');
        catalogoSelect.empty();
        if (opcionSeleccionada === "1") {
            console.log('Cargando intervenciones para DAAN');
            $.getJSON('@Url.Action("GetCat", "Solicitud")', { tipoCatalogo: "INTERVENCION" },
                function (data) {
                    console.log('Datos devueltos:', data);
                    var items = data.value.value;
                    $.each(items, function (index, item) {
                        catalogoSelect.append('<option value="' + item.id + '">' + item.descripcion + '</option>');
                    });
                });
        } else if (opcionSeleccionada === "2") {
            console.log('Cargando intervenciones para DAPA');
            $.getJSON('@Url.Action("GetCat", "Solicitud")', { tipoCatalogo: "INTERVENCIONES" },
                function (data) {
                    console.log('Datos devueltos:', data);
                    var items = data.value.value;
                    $.each(items, function (index, item) {
                        catalogoSelect.append('<option value="' + item.id + '">' + item.descripcion + '</option>');
                    });
                });
        }
    };

