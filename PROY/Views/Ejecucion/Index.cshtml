                            render: function (data, type, row) {
                                //console.log('data' + data + ' row ' + row);
                                console.log('.....' + JSON.stringify(row.IdAsignaRacion) + '---' + idSolicitud);
                                return `<button class="btn btn-danger btn-sm btn-eliminar" onclick="eliminarRacion(${row.IdAsignaRacion},${idSolicitud})"><i class="fas fa-trash"></i> Eliminar</button>`;
                            }
