                        int contadorFallecido = 0;
                    }

                    @try
                    {
                        if (idDepto == "1")
                        {
                            contadorFallecido = 0;
                            foreach (var detalle in item.DetallesSolicitud ?? Enumerable.Empty<DetalleSolicitud>())
                            {
                                foreach (var cat in Model.AnulacionDict)
                                {
                                    if (detalle.IdAnulacion != null)
                                    {
                                        if (detalle.IdAnulacion == cat.Key && cat.Value == "FALLECIDO")
                                        {
                                            contadorFallecido++;
                                        }
                                    }
                                }
                                //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")
                            }
                        }
                        else if (idDepto == "2")
                        {
                            contadorFallecido = 0;
                            foreach (var detalle in item.DetallesSolicitudAPA ?? Enumerable.Empty<DetalleSolicitudAPA>())
                            {
                                foreach (var cat in Model.AnulacionDict)
                                {
                                    if (detalle.IdAnulacion != null)
                                    {
                                        if (detalle.IdAnulacion == cat.Key && cat.Value == "FALLECIDO")
                                        {
                                            contadorFallecido++;
                                        }
                                    }
                                }
                                //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")
                            }

                            @*foreach (var detalle in Model.listaDetallesSolicitudAPA ?? Enumerable.Empty<DetalleSolicitudAPA>())
                {
                foreach (var cat in Model.AnulacionDict)
                {
                if (detalle.IdAnulacion == cat.Key && cat.Value == "FALLECIDO" && detalle.IdSolicitud==item.IdSolicitud)
                {
                contadorFallecido++;
                }
                }
                //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")
                }*@
                        }
                    }
                    catch
                    {

                    }

                    @contadorFallecido
                    @* @{int contadorFallecido=0;}
                @try{
                contadorFallecido = Model.Solicitudes.Where(s => s.Restrictiva == 0 && s.Depto == "DAAN")
                .SelectMany(s => s.DetallesSolicitud)
                .Where(d => d.Restrictiva == 0 && d.IdAnulacion != 0)
                .Count(d => d.catalogo.Descripcion == "FALLECIDO" && d.catalogo.IdCatalogo == d.IdAnulacion);

                }
                catch
                {

                } *@

                </td>
                @* <td>@item.Duplicados</td> *@
                <td>
                    @{
                        int contadorDuplicado = 0;
                    }

                    @try
                    {
                        if (idDepto == "1")
                        {
                            foreach (var detalle in item.DetallesSolicitud ?? Enumerable.Empty<DetalleSolicitud>())
                            {
                                foreach (var cat in Model.AnulacionDict)
                                {
                                    if (detalle.IdAnulacion == cat.Key && cat.Value == "DUPLICADO")
                                    {
                                        contadorDuplicado++;
                                    }
                                }
                                //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")
                            }
                        }
                        else if (idDepto == "2")
                        {
                            foreach (var detalle in item.DetallesSolicitudAPA ?? Enumerable.Empty<DetalleSolicitudAPA>())
                            {
                                foreach (var cat in Model.AnulacionDict)
                                {
                                    if (detalle.IdAnulacion == cat.Key && cat.Value == "DUPLICADO")
                                    {
                                        contadorDuplicado++;
                                    }
                                }
                                //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")
                            }
                        }
                    }
                    catch
                    {

                    }

                    @contadorDuplicado
                </td>
                @* <td>@item.SinDatos</td> *@
                <td>
                    @{
                        int contadorSinDatos = 0;
                    }

                    @try
                    {
                        if (idDepto == "1")
                        {
                            foreach (var detalle in item.DetallesSolicitud ?? Enumerable.Empty<DetalleSolicitud>())
                            {
                                foreach (var cat in Model.AnulacionDict)
                                {
                                    if (detalle.IdAnulacion == cat.Key && cat.Value == "SIN DATOS")
                                    {
                                        contadorSinDatos++;
                                    }
                                }
                                //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")
                            }
                        }
                        else if (idDepto == "2")
                        {
                            foreach (var detalle in item.DetallesSolicitudAPA ?? Enumerable.Empty<DetalleSolicitudAPA>())
                            {
                                foreach (var cat in Model.AnulacionDict)
                                {
                                    if (detalle.IdAnulacion == cat.Key && cat.Value == "SIN DATOS")
                                    {
                                        contadorSinDatos++;
                                    }
                                }
                                //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")
                            }
                        }
                    }
                    catch
                    {

                    }

                    @contadorSinDatos
                </td>
                @* <td>@item.Gobierno</td> *@
                <td>
                    @{
                        int contadorGobierno = 0;
                    }

                    @try
                    {
                        if (idDepto == "1")
                        {
                            foreach (var detalle in item.DetallesSolicitud ?? Enumerable.Empty<DetalleSolicitud>())
                            {
                                foreach (var cat in Model.AnulacionDict)
                                {
                                    if (detalle.IdAnulacion == cat.Key && cat.Value == "GOBIERNO")
                                    {
                                        contadorGobierno++;
                                    }
                                }
                                //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")
                            }
                        }
                        else if (idDepto == "2")
                        {
                            foreach (var detalle in item.DetallesSolicitudAPA ?? Enumerable.Empty<DetalleSolicitudAPA>())
                            {
                                foreach (var cat in Model.AnulacionDict)
                                {
                                    if (detalle.IdAnulacion == cat.Key && cat.Value == "GOBIERNO")
                                    {
                                        contadorGobierno++;
                                    }
                                }
                                //if (item2.IdAnulacion==item2.catalogo.IdCatalogo && item2.catalogo.Descripcion == "FALLECIDO")
                            }
                        }
                    }
                    catch
                    {

                    }

                    @contadorGobierno
                </td>
                <td>
                    @{
                        int contadorValidos = 0;
                    }

                    @try
                    {
                        if (idDepto == "1")
                        {
                            foreach (var detalle in item.DetallesSolicitud ?? Enumerable.Empty<DetalleSolicitud>())
                            {
                                contadorValidos++;
                            }
                            contadorValidos = contadorValidos - contadorFallecido - contadorDuplicado - contadorSinDatos - contadorGobierno;
                        }
                        else if (idDepto == "2")
                        {
                            foreach (var detalle in item.DetallesSolicitudAPA ?? Enumerable.Empty<DetalleSolicitudAPA>())
                            {
                                contadorValidos++;
                            }
                            contadorValidos = contadorValidos - contadorFallecido - contadorDuplicado - contadorSinDatos - contadorGobierno;
                        }
                    }
                    catch
                    {

                    }

                    @contadorValidos
                </td>

                <td>
                    @if (rol == "Admin")
                    {
                        <a class="btn btn-primary btn-sm" onclick="abrirModalYActualizarUrl(@item.IdSolicitud, @idDepto)"><i class="fas fa-edit"></i> Info</a>
                    }
                    else
                    {
                        if (usr == item.UsuarioRegistro)
                        {
                            <a class="btn btn-primary btn-sm" onclick="abrirModalYActualizarUrl(@item.IdSolicitud, @idDepto)"><i class="fas fa-edit"></i> Info</a>
                        }
                        else
                        {
                            <a class="btn btn-gray btn-sm disabled" href="javascript:void(0);"><i class="fas fa-edit"></i> Info</a>
                        }
                    }
                    

                    @if (rol == "Admin")
                    {
                        <a class="btn btn-danger btn-sm" asp-controller="Ejecucion" asp-action="IndexDetalle" asp-route-idEjecucion="@item.IdSolicitud" asp-route-k="@condicion" asp-route-returnController="Ejecucion"><i class="fas fa-bars"></i> Liquidar</a>
                    }
                    else
                    {
                        if (usr == item.UsuarioRegistro)
                        {
                            <a class="btn btn-danger btn-sm" asp-controller="Ejecucion" asp-action="IndexDetalle" asp-route-idEjecucion="@item.IdSolicitud" asp-route-k="@condicion" asp-route-returnController="Ejecucion"><i class="fas fa-bars"></i> Liquidar</a>
                        }
                        else
                        {
                            <a class="btn btn-gray btn-sm disabled" href="javascript:void(0);"><i class="fas fa-bars"></i> Liquidar</a>
                        }
                    }
                    

                    @* <a class="btn btn-warning btn-sm" asp-action="NuevaSolicitud" asp-route-id="@item.IdSolicitud">Editar</a> |*@
                    @* <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#wNewSolicitud">Editar</button> | *@
                    @* <a href="/Solicitud/Index/@item.IdSolicitud" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#wNewSolicitud">Editar</a> | *@

                    @* <a href="@Url.Action("Index", new { id = item.IdSolicitud })" class="btn btn-danger btn-sm">Editar</a> *@
                    @if (rol == "Admin")
                    {
                        <a class="btn btn-dark btn-sm" asp-controller="Programacion" asp-action="ListaDetalle" asp-route-idProgramacion="@item.IdSolicitud" asp-route-k="@condicion" asp-route-returnController="Ejecucion"><i class="fas fa-bars"></i> Beneficiarios</a>
                    }
                    else
                    {
                        if (usr == item.UsuarioRegistro)
                        {
                            <a class="btn btn-dark btn-sm" asp-controller="Programacion" asp-action="ListaDetalle" asp-route-idProgramacion="@item.IdSolicitud" asp-route-returnController="Ejecucion"><i class="fas fa-bars"></i> Beneficiarios</a>
                        }
                        else
                        {
                            <a class="btn btn-gray btn-sm disabled" href="javascript:void(0);"><i class="fas fa-bars"></i> Beneficiarios</a>
                        }                        
                    }

                    @*<a class="btn btn-dark btn-sm" asp-controller="Evaluacion" asp-action="ListaDetalle" asp-route-idEvaluacion="@item.IdSolicitud"><i class="fas fa-bars"></i> Detalle</a>*@

                    @if (rol == "Admin")
                    {
                        <a class="btn btn-info btn-sm" asp-controller="Evaluacion" asp-action="IndexDetalle" asp-route-idEvaluacion="@item.IdSolicitud" asp-route-k="@condicion" asp-route-returnController="Ejecucion" asp-route-proceso="EJECUCION"><i class="fas fa-bars"></i> Medios Verificación</a>
                    }
                    else
                    {
                        if (usr == item.UsuarioRegistro)
                        {
                            <a class="btn btn-info btn-sm" asp-controller="Evaluacion" asp-action="IndexDetalle" asp-route-idEvaluacion="@item.IdSolicitud" asp-route-k="@condicion" asp-route-returnController="Ejecucion" asp-route-proceso="EJECUCION"><i class="fas fa-bars"></i> Medios Verificación</a>
                        }
                        else
                        {
                            <a class="btn btn-gray btn-sm disabled" href="javascript:void(0);"><i class="fas fa-bars"></i> Medios Verificación</a>
                        }
                    }
                    
                                        
                    @*@if (item.BotonDespacho == true)
                    {
                        <a class="btn btn-warning btn-sm" onclick="abrirModalResumen(@item.IdSolicitud, @idDepto)"><i class="fas fa-bars"></i> Solicitud despacho</a>
                        
                    }
                    else
                    {
                        <a class="btn btn-warning btn-sm disabled" href="javascript:void(0);"><i class="fas fa-bars"></i> Solicitud despacho</a>
                        @*<a class="btn btn-warning btn-sm" onclick="otra();"><i class="fas fa-bars"></i> Solicitud despacho</a>*@
                    @*}*@
                    @*@if (rol == "Admin")
