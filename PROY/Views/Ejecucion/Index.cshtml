                //alert('ENTRE'+ ventanaTitle.textContent);

                var modal = new bootstrap.Modal(document.getElementById('wEditDespacho1'));
                modal.show();
            },
            error: function (xhr, status, error) {
                console.error('Error al obtener los datos de la solicitud:', error);
            }
        });

        $.ajax({
            url: `@ViewData["rutaApp"]/Ejecucion/getAgrupado/${idSolicitud}`,
            method: 'GET',
            dataType: 'json',
            success: function (data) {
                //alert('hola');
                //console.log('data' + JSON.stringify(data));
                const datosFiltrados = data.agrupados.map(info => ({
                    Departamento: info.departamento,
                    Municipio: info.municipio,
                    Beneficiarios: info.beneficiarios,
                    Raciones: info.raciones
                })
                );

                // Llenar el formulario del modal con los datos de la solicitud
                const table = $('#tblAgrupado').DataTable({
                    destroy: true, // Permite reiniciar la tabla con nuevos datos
                    paging: true,
                    pageLength: 5,
                    dom: 'lrtip',
                    lengthChange: false,
                    data: datosFiltrados, // Asigna los datos al DataTable
                    /*columnDefs: [
                        { width: "10%", targets: 0 },  // Cambia el ancho de la primera columna
                        { width: "10%", targets: 1 },  // Cambia el ancho de la primera columna
                        { width: "10%", targets: 2 },  // Cambia el ancho de la segunda columna
