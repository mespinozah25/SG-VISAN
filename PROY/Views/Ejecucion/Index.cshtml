@inject IHttpContextAccessor HttpContextAccessor
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous">

<style>
    .modal-header .btn-close {
        color: white !important; /* Asegura que el ícono de la "X" sea blanco */
        opacity: 1;
        -webkit-filter:invert(1);
    }
</style>

@model PROY.ViewModels.SolicitudesVM

@{
    ViewData["Title"] = "Index";
    ViewData["rutaApp"] = @Model.rutaApp;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var depto = "";

    try
    {
        depto = User.FindFirst("depto")?.Value;
    }
    catch
    {

    }

    var rol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var idDepto = User.FindFirst("idDepto")?.Value;
    var usr = User.FindFirst("Usuario")?.Value;
}

@{
    // Usamos el HttpContext inyectado para acceder al QueryString
    var valorK = HttpContextAccessor.HttpContext?.Request.Query["k"].ToString();
    bool tieneValorK = !string.IsNullOrEmpty(valorK);
    var condicion = "";

    if ((depto == "DAAN" && rol != "Admin") || (tieneValorK && valorK == "1" && rol == "Admin"))
        condicion = "1";
    else if ((depto == "DAPA" && rol != "Admin") || (tieneValorK && valorK == "2" && rol == "Admin"))
        condicion = "2";

    //Verificar DEPTO
    if (rol == "Admin")
    {
        if (valorK == "1")
            idDepto = "1";
        else if (valorK == "2")
            idDepto = "2";
    }
}



@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

<h2 class="float-start">Solicitudes en Ejecucion</h2>@* <a class="btn btn-primary btn-sm float-end" onclick="abrirModalYActualizarUrl(0)"><i class="fas fa-plus-square"></i> Nueva Solicitud</a> *@
@* <button type="button" class="btn btn-primary float-end" data-bs-toggle="modal" data-bs-target="#wNewSolicitud">Nueva Solicitud</button> *@
<p><br /></p>
<table class="table" style="width:100%;">
    <thead>
        <tr>
            <th>
                CODIGO
            </th>
            <th>
                No. SOLICITUD
            </th>
            @if (idDepto == "1")
            {
                <th>
                    INSTITUCION
                </th>
            }
            else if (idDepto == "2")
            {
                <th>
                    PROYECTO
                </th>
            }
            <th>
                INTERVENCION
            </th>
            <th>
                FECHA INGRESO A DESPACHO
            </th>
            <th>
                FECHA INGRESO A DIRECCIÓN
            </th>
            <th>
                FECHA INGRESO A DEPARTAMENTO
            </th>
            <th>
                MEDIO VERIFICACIÓN
            </th>
            <th>FALLECIDOS</th>
            <th>DUPLICADOS</th>
            <th>SIN DATOS</th>
            <th>GOBIERNO</th>
            <th>VÁLIDOS</th>
            <th>OPCIONES</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Solicitudes)
        {
            <tr>
                <td>
                    @item.Codigo
                </td>
                <td>
                    @item.Correlativo
                </td>
                @if (idDepto == "1")
                {
                    <td>
                        @{
                            // Obtener la descripción usando el diccionario
                            /*string descripcionInstitucion = Model.InstitucionDict.TryGetValue(item.IdInstitucion, out var descInst)
                            ? descInst
                            : "Institución no encontrada";*/

                            string descripcionInstitucion = item.IdInstitucion.HasValue
                            ? Model.InstitucionDict.TryGetValue(item.IdInstitucion.Value, out var descInst)
                            ? descInst : "Institución no encontrada"
                            : "IdInstitución no especificada";
                        }
                        @descripcionInstitucion
                    </td>
                }
                else if (idDepto == "2")
                {
                    <td>
                        @{
                            // Obtener la descripción usando el diccionario
                            /*string descripcionInstitucion = Model.InstitucionDict.TryGetValue(item.IdInstitucion, out var descInst)
                            ? descInst
                            : "Institución no encontrada";*/

                            string descripcionProyecto = item.IdProyecto.HasValue
                            ? Model.ProyectoDict.TryGetValue(item.IdProyecto.Value, out var descProy)
                            ? descProy : "Proyecto no encontrado"
                            : "IdProyecto no especificado";
                        }
                        @descripcionProyecto
                    </td>
                }

                <td>
                    @{
                        // Obtener la descripción usando el diccionario
                        string descripcionIntervencion = Model.IntervencionDict.TryGetValue(item.IdIntervencion, out var descInter)
                        ? descInter
                        : "Intervención no encontrada";
                    }
                    @descripcionIntervencion
                </td>
                <td>
                    @item.FechaIngresoDespacho.Date.ToString("dd/MM/yyyy")
                </td>
                <td>
                    @item.FechaIngresoDireccion.Date.ToString("dd/MM/yyyy")
                </td>
                <td>
                    @item.FechaIngresoUnidad.Date.ToString("dd/MM/yyyy")
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(item.Archivo))
