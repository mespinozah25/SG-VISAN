                    ]
                });
                table.draw(false);
                //alert('data' + JSON.stringify(datosFiltrados));
                /*$('#tblRacionesDespacho').on('click', '.btn-eliminar', function () {
                 * 
                    const id = $(this).data('row.IdAsignaRacion');
                    alert(id);
                    //console.log('data' + raciones.idAsignaRacion);
                    eliminarRacion(id); // Llama a la función de eliminación
                });*/

            },
            error: function (xhr, status, error) {
                console.error("Ocurrió un error:", error);
            }
        });
    }

