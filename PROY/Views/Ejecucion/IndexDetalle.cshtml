    function liquidar(id, checkbox) {
        let estado = $(checkbox).prop("checked") ? "LIQUIDADO" : "No liquidado";

        $.ajax({
            url: '@ViewData["rutaApp"]/Ejecucion/LiquidarBeneficiario?k=1',
            type: "POST",
            data: { idDetalleEjecucion: id, estado: estado},
            beforeSend: function () {
                $(checkbox).prop("disabled", true); // Deshabilitar mientras se procesa
            },
            success: function (response) {
                console.log("Éxito: ", response);
            },
            error: function (xhr, status, error) {
                console.error("Error: ", error);
                $(checkbox).prop("checked", !$(checkbox).prop("checked")); // Revertir cambio si hay error
                alert("Ocurrió un error, intenta de nuevo.");
            },
            complete: function () {
                $(checkbox).prop("disabled", false); // Habilitar de nuevo
            }
        });
    }

    function liquidarAPA(id, checkbox) {
        let estado = $(checkbox).prop("checked") ? "LIQUIDADO" : "No liquidado";

        $.ajax({
            url: '@ViewData["rutaApp"]/Ejecucion/LiquidarBeneficiario?k=2',
            type: "POST",
            data: { idDetalleEjecucion: id, estado: estado },
            beforeSend: function () {
                $(checkbox).prop("disabled", true); // Deshabilitar mientras se procesa
            },
            success: function (response) {
                console.log("Éxito: ", response);
            },
            error: function (xhr, status, error) {
                console.error("Error: ", error);
                $(checkbox).prop("checked", !$(checkbox).prop("checked")); // Revertir cambio si hay error
                alert("Ocurrió un error, intenta de nuevo.");
            },
            complete: function () {
                $(checkbox).prop("disabled", false); // Habilitar de nuevo
            }
        });
    }

</script>
