<head>
</head>

<div style="display:block; justify-content:center; align-items:center; position: relative;">
    <div style="width:100%; text-align:center;">
        <img src="~/LogoVISAN.png" style="width:400px;" />
    </div>
    <div style="width:100%; text-align:center;">
        <p style="font-size:45px; font-weight:800;">
            RESUMEN DE EXISTENCIA DE ALIMENTOS
        </p>
    </div>

    <div style="width:100%; text-align:center;">
        <p style="font-size:25px; font-weight:500;">
            DIRECCION DE ASISTENCIA ALIMENTARIA Y NUTRICIONAL
        </p>
    </div>

    <div style="text-align:center;">
        <p style="font-size:25px; font-weight:800;" id="fechaActual"></p>
    </div>

    @* <div style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
                width: 600px; opacity: 0.2; z-index: -1;">
        <img src="~/Logo SGI_600x600.png" style="width:100%;" />
    </div> *@
</div>

<div class="row">
    <table class="table" style="width: 98%; margin-left: 15px;">
        <thead>
            <tr style="text-align: center;">
                <th colspan="3" style="border: black 1px solid;">
                    <h3 style="font-weight: bold;">TOTAL DE RACIONES DISPONIBLES</h3>
                    </>
                </th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td
                    style="width: 60%; text-align: center; font-weight: bold; border-top: black 1px solid; border-left: black 1px solid; border-right: black 1px solid;">
                    Reservas Estrategicas de Granos Básicos</td>
                <td
                    style="width: 20%; text-align: right;  border-top: black 1px solid;  border-right: black 1px solid;">
                </td>
                <td style="width: 20%; text-align: left;  border-top: black 1px solid;  border-right: black 1px solid;">
                </td>
            </tr>
            @foreach (var item in Model.raciones_disponibles)
            {
                @if (item.Tipo == 1)
                {
                    <tr>
                        <td
                            style="width: 60%; text-align: center; border-bottom: black 1px solid; border-left: black 1px solid; border-right: black 1px solid;">
                            @item.Convenio (@item.Descripcion)</td>
                        <td
                            style="width: 20%; text-align: right; border-bottom: black 1px solid; border-right: black 1px solid;">
                            @item.Raciones.ToString("N0")</td>
                        <td
                            style="width: 20%; text-align: left; border-bottom: black 1px solid; border-right: black 1px solid;">
                            Raciones</td>
                    </tr>
                }
            }
            <tr>
                <td
                    style="width: 60%; text-align: center; font-weight: bold; border-top: black 1px solid; border-left: black 1px solid; border-right: black 1px solid;">
                    Programas Regulares</td>
                <td style="width: 20%; text-align: right; border-top: black 1px solid;  border-right: black 1px solid;">
                </td>
                <td style="width: 20%; text-align: left; border-top: black 1px solid;  border-right: black 1px solid;">
                </td>
            </tr>
            @foreach (var item in Model.raciones_disponibles)
            {
                @if (item.Tipo == 2)
                {
                    <tr>
                        <td
                            style="width: 60%; text-align: center; border-left: black 1px solid; border-right: black 1px solid;">
                            @item.Convenio (@item.Descripcion)</td>
                        <td style="width: 20%; text-align: right; border-right: black 1px solid;">@item.Raciones.ToString("N0")
                        </td>
                        <td style="width: 20%; text-align: left;border-left: black 1px solid;  border-right: black 1px solid;">
                            Raciones</td>
                    </tr>
                }
            }
            <tr>
                <td
                    style="width: 60%; text-align: center; font-weight: bold; border: black 1px solid; border-top: black 2px solid;">
                    <h3 style="font-weight: bold;">TOTAL</h3>
                </td>
                <td
                    style="width: 20%; text-align: right; font-weight: bold; border: black 1px solid; border-top: black 2px solid;">
                    @Model.total_raciones.ToString("N0")</td>
                <td
                    style="width: 20%; text-align: left; font-weight: bold; border: black 1px solid; border-top: black 2px solid;">
                    Raciones</td>
            </tr>
        </tbody>
    </table>
</div>
<br>
<div class="row">
    <table class="table" style="width: 98%; margin-left: 15px; border: black 1px solid;">
        <thead>
            <tr style="text-align: center;">
                <th colspan="7">
                    <h4 style="font-weight: bold;">AVANCE DE RECEPCIÓN, EJECUCIÓN Y DISPONIBILIDAD POR CONVENIOS</h4>
                    </>
                </th>
            </tr>
        </thead>
        <tbody>
            <tr style="font-size: 14px;">
                <td style="width: 40%; text-align: center; font-weight: bold; ">Convenios</td>
                <td style="width: 10%; text-align: center; font-weight: bold;">Total por <br /> Convenio</td>
                <td style="width: 10%; text-align: center; font-weight: bold;">Raciones <br /> Recibidas</td>
                <td style="width: 10%; text-align: center; font-weight: bold;">Pendientes de <br /> Recibir</td>
                <td style="width: 10%; text-align: center; font-weight: bold;">Raciones <br /> Entregadas</td>
                <td style="width: 10%; text-align: center; font-weight: bold;">Pendientes de <br /> Entregar</td>
                <td style="width: 10%; text-align: center; font-weight: bold;">% de <br />Ejecución</td>
            </tr>
            @foreach (var item in Model.raciones_avance)
            {
                <tr style="font-size: 12px;">
                    <td style="width: 40%; text-align: center; ">@item.Convenio @item.Descripcion</td>
                    <td style="width: 10%; text-align: center; ">@item.TotalConvenio.ToString("N0")</td>
                    <td style="width: 10%; text-align: center; ">@item.RacionesRecibidas.ToString("N0")</td>
                    <td style="width: 10%; text-align: center; ">@item.RacionesPendientesRecibir.ToString("N0")</td>
                    <td style="width: 10%; text-align: center; ">@item.RacionesEntregadas.ToString("N0")</td>
                    <td style="width: 10%; text-align: center; ">@item.RacionesPendientesEntregar.ToString("N0")</td>
                    <td style="width: 10%; text-align: center; ">@item.PorcentajeEjecucion.ToString("N2")</td>
                </tr>
            }

            <tr style="font-size: 14px;">
                <td style="width: 40%; text-align: center; font-weight: bold; ">TOTALES</td>
                <td style="width: 10%; text-align: center; font-weight: bold;">@Model.totalConvenio.ToString("N0")</td>
                <td style="width: 10%; text-align: center; font-weight: bold;">
                    @Model.totalRacionesRecibidas.ToString("N0")</td>
                <td style="width: 10%; text-align: center; font-weight: bold;">
                    @Model.totalRacionesPendientesRecibir.ToString("N0")</td>
                <td style="width: 10%; text-align: center; font-weight: bold;">
                    @Model.totalRacionesEntregadas.ToString("N0")</td>
                <td style="width: 10%; text-align: center; font-weight: bold;">
                    @Model.totalRacionesPendientesEntregar.ToString("N0")</td>
                <td style="width: 10%; text-align: center; font-weight: bold;">
                    @Model.totalporcentaje.ToString("N2")</td>
            </tr>


        </tbody>
    </table>
</div>
<br>
<div class="row">
    <div class="col-6" style=" width: 48%; margin-left: 15px; border: black 1px solid;">
        <div class="card">
            <div class="card-body">
                <div id="chart_bod" style="width: 100%; height: 500px;"></div>
            </div>
        </div>
    </div>
    <div class="col-6" style=" width: 48%; margin-left: 25px; border: black 1px solid;">
        <div class="card">
            <div class="card-body">
                <div id="chart_raciones" style="width: 100%; height: 500px;"></div>
            </div>
        </div>
    </div>
</div>




@section Scripts {
    <script>
        $(document).ready(function () {
            google.charts.load('current', { 'packages': ['corechart'] });
            google.charts.setOnLoadCallback(ChartBodegasProductos);
            google.charts.setOnLoadCallback(ChartRaciones);

            // Obtener la fecha actual
            var fechaActual = new Date();
            var dia = String(fechaActual.getDate()).padStart(2, '0');
            var mes = String(fechaActual.getMonth() + 1).padStart(2, '0');
            var año = fechaActual.getFullYear();
            var fechaFormateada = dia + '/' + mes + '/' + año;

            $('#fechaActual').text(fechaFormateada);
        });

        function ChartBodegasProductos() {
            fetch('/TableroDeDatos/ObtenerDatosGraficaBodegasProductos')
                .then(response => response.json())
                .then(datos => {
                    // Crear DataTable con el formato correcto
                    var data = new google.visualization.DataTable();

                    // Agregar columnas
                    data.addColumn('string', 'Bodega');
                    datos.encabezados.slice(1).forEach(function (producto) {
                        data.addColumn('number', producto);
                    });

                    // Agregar filas
                    data.addRows(datos.filas);

                    var options = {
                        title: 'Existencias por Bodega y Producto',
                        vAxis: { title: 'Bodegas' },
                        hAxis: { title: 'Existencias' },
                        seriesType: 'bars',
                        isStacked: true,
                        height: 500,
                        legend: { position: 'top' },
                        chartArea: { width: '80%', height: '70%' }
                    };

                    var chart = new google.visualization.BarChart(document.getElementById('chart_bod'));
                    chart.draw(data, options);
                })
                .catch(error => console.error('Error al obtener los datos:', error));
        }

        function ChartRaciones() {
            fetch('/TableroDeDatos/ObtenerDatosGraficaRaciones')
                .then(response => response.json())
                .then(datos => {
                    var data = google.visualization.arrayToDataTable(datos);

                    var options = {
                        title: 'Distribución de Raciones por Programa',
                        pieHole: 0.4,
                        height: 500,
                        legend: { position: 'labeled' },
                        chartArea: { width: '90%', height: '80%' }
                    };

                    var chart = new google.visualization.PieChart(document.getElementById('chart_raciones'));
                    chart.draw(data, options);
                })
                .catch(error => console.error('Error al obtener los datos de raciones:', error));
        }
    </script>
}


@* Charts de Google *@
<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>