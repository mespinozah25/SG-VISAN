<head>
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous">

    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    
</head>

<style>
    table thead th {
        pointer-events: none; /* Desactiva la interacción con los títulos */
    }
</style>

@model PROY.ViewModels.ReingresoAlimentosVM

@{
    ViewData["Title"] = "Registro Reingreso";
}

<h1>Revisión despacho de Almacén</h1>

<br />

<div>
    <form id="frmDespacho">

        <input type="hidden" id="idReingresoAlimentos" asp-for="@Model.ReingresoAlimentos.IdReingresoAlimentos" />
        <input type="hidden" id="idEgresoAlimentos" asp-for="@Model.ReingresoAlimentos.IdEgresoAlimentos" />

        <br />

        <div class="row">
            <div class="col">
                <label for="txtNoOficioReingreso" class="control-label"><b> No. Oficio Reingreso </b></label>
                <input class="form-control" id="txtNoOficioReingreso" disabled>
            </div>
            <div class="col">
                <label for="txtFechaSolicitud" class="control-label"><b> Fecha de Solicitud </b></label>
                <input class="form-control" id="txtFechaSolicitud" disabled>
            </div>
        </div>

        <br />

        <div class="row">
            <div class="col">
                <label for="txtDepartamentoSolicitante" class="control-label"><b> Departamento Solicitante </b></label>
                <input class="form-control" id="txtDepartamentoSolicitante" disabled>
            </div>
        </div>

        <br />

        <div class="row">
            <div class="col">
                <div class="form-group">
                    <label for="txtNoDespachoAlmacenEgreso" class="control-label"><b>No. Despacho Almacén </b></label>
                    <input type="text" id="txtNoDespachoAlmacenEgreso" class="form-control" disabled>
                </div>
            </div>
            <div class="col">
                <label for="txtFechaDespachoEgreso" class="control-label"><b> Fecha de Despacho </b></label>
                <input class="form-control" id="txtFechaDespachoEgreso" disabled>
            </div>
            <div class="col">
                <label for="txtProgramaEgreso" class="control-label"><b> Programa </b></label>
                <input type="text" class="form-control" id="txtProgramaEgreso" disabled>
            </div>
        </div>

        <br />

        <div class="row">
            <div class="col">
                <label for="cbIdDepartamentoDetino" class="control-label"><b> Departamento de Destino </b></label>
                <input class="form-control" id="cbIdDepartamentoDetino" disabled>
            </div>
            <div class="col">
                <label for="cbIdMunicipioDestino" class="control-label"><b> Municipio de Destino </b></label>
                <input class="form-control" id="cbIdMunicipioDestino" disabled>
            </div>
            <div class="col">
                <label for="direccionFinal" class="control-label"><b> Dirección Final </b></label>
                <input type="text" class="form-control" id="direccionFinal" disabled>
            </div>
        </div>

        <br />

        <div class="row">
            <div class="col">
                <div class="form-group">
                    <label class="control-label">Observaciones Inspección Física INDECA de producto que reingresa</label>
                    <textarea class="form-control" rows="3" id="txtObservacionFisicaIndeca" required></textarea>
                </div>
            </div>
        </div>

        <br />

        <h3>Detalle del Producto</h3>

        <br />

        <div class="row camposAlmacenamiento">
            <div class="col">
                <label for="cbIdProductoAlimenticio" class="control-label">Producto Alimenticio</label>
                <select class="form-select" id="cbIdProductoAlimenticio" asp-items="ViewBag.ProductoAlimenticio"></select>
            </div>
            <div class="col">
                <label for="cbIdPresentacionPA" class="control-label">Presentación</label>
                <select class="form-select" id="cbIdPresentacionPA" asp-items="ViewBag.PresentacionPA"></select>
            </div>
            <div class="col">
                <label for="txtCantidadUnidad" class="control-label">Cantidad Unidad</label>
                <input type="number" class="form-control" min="0" id="txtCantidadUnidad">
            </div>
            <div class="col">
                <label for="cbIdUnidadMedida" class="control-label">Unidad de Medida</label>
                <select class="form-select" id="cbIdUnidadMedida" asp-items="ViewBag.UnidadMedida"></select>
            </div>
            <div class="col">
                <label for="txtCantidad" class="control-label">Cantida</label>
                <input type="number" class="form-control" min="0" id="txtCantidad">
            </div>
            <div class="col">
                <label for="txtFechaVencimiento" class="control-label">Fecha Vencimiento</label>
                <input type="date" class="form-control" min="0" id="txtFechaVencimiento">
            </div>
        </div>

        <br class="camposAlmacenamiento" />

        <div class="float-end camposAlmacenamiento">
            <a type="button" href="#" class="btn btn-secondary" onclick="return LimpiarDetalles();">Limpiar</a>
            <a type="button" href="#" class="btn btn-primary" onclick="return AgregarDetalle();">Agregar Detalle</a>
        </div>

        <br />
        <br />
        <br />

        <div class="row col-12">
            <div class="">
                <table id="tableDetalle" class="table">
                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>PRODUCTO</th>
                            <th>PRESENTACIÓN</th>
                            <th>CANT. UNIDAD</th>
                            <th>UNIDAD MEDIDA</th>
                            <th>CANTIDAD</th>
                            <th>FECHA DE VENCIMIENTO</th>
                            <th>ACCIONES</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <br />
        <br />

        <div class="row">
            <div class="col-6">
                <label for="archivoDespacho" class="control-label">Archivo Despacho de Almacén con anotación de reingreso autorizado</label>
                <input type="file" name="file" id="archivoDespacho" class="form-control" />
            </div>
            <div class="col-2 text-center" id="divBtnDescarga">
                <label for="btnDescarga" class="control-label text-center"> Descargar Docto </label>
                <input type="hidden" id="txtUbicacionArchivo" value="@Model.ReingresoAlimentos.ArchivoDespachoAlmacenReingreso" />
                <a type="button" id="btnDescarga" class="btn btn-primary btn-sm text-center" href="@Url.Action("DownloadFile", new { fileName = Model.ReingresoAlimentos.ArchivoDespachoAlmacenReingreso, carpeta = "despachoAlmacenReingreso" })">
                    <i class="fas fa-download"></i>
                </a>
            </div>
        </div>
        


        <div class="row float-end">
            <div class="col">
                <a type="button" class="btn btn-secondary btn" asp-action="Index">Regresar</a>
            </div>
            <div class="col">
                <input type="button" value="Guardar" class="btn btn-primary camposAlmacenamiento" onclick="return ConfirmSave();" />
            </div>
        </div>

        <br />

    </form>
</div>


@section Scripts {

    <script>
        $( document ).ready(function() {

            $("#tableDetalle tbody").empty();
            $('#tableDetalle_paginate').hide();
            $('#tableDetalle_info').hide();
            $('#tableDetalle_filter').hide();

            var urlObj = new URL(window.location.href);
            var type = urlObj.searchParams.get("type");
            var id = window.location.pathname.split('/').pop();

            // Inicializa la tabla (si no está inicializada)
            var table = $('#tableDetalle').DataTable();

            // Oculta las flechas de ordenamiento
            $('table.dataTable thead th').removeClass('sorting sorting_asc sorting_desc');

            if (parseInt(id) != 0){
                abrirYActualizarUrl(id, type);
            }

            
            
        });

        function iniciarAutocompletado(){
            // Evento de autocompletado
            $("#txtNoDespachoAlmacen").autocomplete({
                source: function (request, response) {
                    $.ajax({
                            url: `@ViewData["rutaApp"]/ReingresoAlimentos/ObtenerListEgresos`,
                            dataType: "json",
                            type: "POST",
                            contentType: "application/json",
                            data: JSON.stringify({ term: request.term }),
                            dataFilter: function (data) { return data; },
                            success: function (data) {
                                $("#idEgresoAlimentos").val('');
                                $('#txtFechaDespachoEgreso').val('');
                                $('#txtProgramaEgreso').val('');
                                $('#cbIdDepartamentoDetino').val('');
                                $('#cbIdMunicipioDestino').val('');
                                $('#direccionFinal').val('');

                                $("#txtNoDespachoAlmacen").css('font-weight', 'normal');
                                response(data);
                            }
                    });
                },
                select: function (event, ui) {
                    $("#idEgresoAlimentos").val(ui.item.id);
                    $("#txtNoDespachoAlmacen").css('font-weight', 'bold');

                    obtenerDatosEgreso(ui.item.id);
                }
            });
        }

        function abrirYActualizarUrl(id, tipoApertura) {

            // Se inicia reiniciando la tabla
             $("#tableDetalle tbody").empty();

            // El tipo de apertura 1 indica que se va almacenar o editar un registro
            // El tipo de apertura 2 indica solo de observación
            let disabled = tipoApertura == 1 ? "" : "disabled" ;
            if(tipoApertura == 1){
                $('.camposAlmacenamiento').show();
                $("#frmDespacho input:not([disabled])").attr("disabled", false);  // Hace los inputs solo lectura
                $("#frmDespacho select").prop("disabled", false); // Deshabilita los selects
                $("#frmDespacho textarea").prop("disabled", false); // Deshabilita los TextArea
            }else{
                $('.camposAlmacenamiento').hide();
                $("#frmDespacho input").attr("disabled", true);  // Hace los inputs solo lectura
                $("#frmDespacho select").prop("disabled", true); // Deshabilita los selects
                $("#frmDespacho textarea").prop("disabled", true); // Deshabilita los selects
            }

            if (id == 0) {

                // Test

            }
            else {

                $.ajax({
                    url: `@ViewData["rutaApp"]/ReingresoAlimentos/ObtenerRegistroReingreso/${id}`, // URL para obtener los datos
                    type: 'GET',
                    success: function (data) {

                        console.log('data' + JSON.stringify(data));

                        var ea = data.reingresoAlimentos;
                        var egreso = data.egresoAlimentos;

                        // Llenar el formulario con los datos de Egreso de Alimentos
                        $('#idReingresoAlimentos').val(ea.idReingresoAlimentos);
                        $('#idEgresoAlimentos').val(ea.idEgresoAlimentos);
                        $('#txtNoDespachoAlmacenEgreso').val(egreso.noDespachoAlmacen);
                        $('#txtNoOficioReingreso').val(ea.noOficioReingreso);
                        $('#txtFechaSolicitud').val(new Date(ea.fechaSolicitud).toLocaleDateString('es-ES'));
                        $('#txtDepartamentoSolicitante').val(data.programa);
                        $('#txtObservacionFisicaIndeca').val(ea.observacionFisicaIndeca);

                        obtenerDatosEgreso(egreso.idEgresoAlimentos);

                        if (ea.archivoDespachoAlmacenReingreso == null){
                            $('#divBtnDescarga').hide();
                        }

                        // Agregar Detalle
                        if (data.detReingresoAlimentos.length > 0){

                            let tabla = document.getElementById("tableDetalle");
                            let tbody = tabla.getElementsByTagName("tbody")[0];

                            data.detReingresoAlimentos.forEach((detalle, index) => {

                                let fila = document.createElement("tr");

                                let txtProducto = $("#cbIdProductoAlimenticio option[value='" + detalle.idProductoAlimenticio + "']").text(); // Nombre del producto
                                let txtpresentacion = $("#cbIdPresentacionPA option[value='" + detalle.idPresentacion + "']").text(); // Nombre de la presentación
                                let cantidadUnidad = detalle.cantidadUnidad;
                                let txtUnidad = $("#cbIdUnidadMedida option[value='" + detalle.idUnidadMedida + "']").text(); // Nombre de la unidad de medida
                                // let txtEstiba = $("#cbIdEstiba option[value='" + detalle.idEstiba + "']").text(); // Nombre de la unidad de medida
                                let cantidad = detalle.cantidad;

                                var fechaFormateadaVenci = '';
                                if(detalle.fechaVencimiento != null){
                                    var fecha = detalle.fechaVencimiento;  // Fecha recibida Vencimiento
                                    fechaFormateadaVenci = fecha.split("T")[0]; // Extrae solo la parte "YYYY-MM-DD"
                                }

                                var botonEliminar = tipoApertura == 1
                                    ? `<button type="button" class="btn btn-danger btn-sm camposAlmacenamiento" onclick="EliminarFila(this, ${detalle.idDetalleReingresoAlimentos})">Eliminar</button>`
                                    : '';

                                fila.innerHTML = `
                                    <td>${index + 1}</td>
                                    <td>${txtProducto}</td>
                                    <td>${txtpresentacion}</td>
                                    <td>${cantidadUnidad}</td>
                                    <td>${txtUnidad}</td>
                                    <td>${cantidad}</td>
                                    <td>
                                        <input type="date" name="FechaVencimiento" class="form-control" value="${fechaFormateadaVenci}" ${disabled}>
                                    </td>
                                    <td>
                                        ${botonEliminar}
                                        <input type="hidden" name="IdDetalleReingresoAlimentos" value="${detalle.idDetalleReingresoAlimentos}">
                                        <input type="hidden" name="IdProductoAlimenticio" value="${detalle.idProductoAlimenticio}">
                                        <input type="hidden" name="IdPresentacion" value="${detalle.idPresentacion}">
                                        <input type="hidden" name="CantidadUnidad" value="${cantidadUnidad}">
                                        <input type="hidden" name="IdUnidadMedida" value="${detalle.idUnidadMedida}">
                                        <input type="hidden" name="Cantidad" value="${cantidad}">
                                        <input type="hidden" name="Estiba" value="${detalle.Estiba}">
                                    </td>
                                `;

                                tbody.appendChild(fila);
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Error al obtener los datos de Egreso de alimentos: ', error);
                    }
                });
            }
        }

        function obtenerDatosEgreso(id) {

            $.ajax({
                url: `@ViewData["rutaApp"]/ReingresoAlimentos/ObtenerEgresoAlimentos/${id}`, // URL para obtener los datos
                type: 'GET',
                success: function (data) {

                    console.log('data' + JSON.stringify(data));

                    var ea = data.egresoAlimentos;

                    // Llenar el formulario con los datos de Egreso de Alimentos
                    $('#txtFechaDespachoEgreso').val(new Date(ea.fechaSolicitud).toLocaleDateString('es-ES'));
                    $('#txtProgramaEgreso').val(data.programa);
                    $('#cbIdDepartamentoDetino').val(data.departamentoDestino);
                    $('#cbIdMunicipioDestino').val(data.municipioDestino);
                    $('#direccionFinal').val(ea.direccionFinal);
                        
                },
                error: function (xhr, status, error) {
                    console.error('Error al obtener los datos de Egreso de alimentos: ', error);
                }
            });
        }

        function ActualizarContador() {
            let filas = document.querySelectorAll("#tableDetalle tbody tr");
            filas.forEach((fila, index) => {
                fila.cells[0].innerHTML = `${index + 1}`;
            });
        }

        function AgregarDetalle() {
            let productoAlimenticio = $("#cbIdProductoAlimenticio").val();
            let txtProductoAlimenticio = $("#cbIdProductoAlimenticio option:selected").text();
            let presentacion = $("#cbIdPresentacionPA").val();
            let txtpresentacion = $("#cbIdPresentacionPA option:selected").text();
            let cantidadUnidad = $("#txtCantidadUnidad").val();
            let unidadMedida = $("#cbIdUnidadMedida").val();
            let txtUnidad = $("#cbIdUnidadMedida option:selected").text();
            let cantidad = $("#txtCantidad").val();
            let fechaVencimiento = $("#txtFechaVencimiento").val();
            // let estiba = $("#cbIdEstiba").val();
            // let txtEstiba = $("#cbIdEstiba option:selected").text();

            if (!productoAlimenticio || !cantidadUnidad || !presentacion || !unidadMedida || !cantidad || !fechaVencimiento) {
                Swal.fire({
                    title: "Error!",
                    text: "Todos los campos son obligatorios.",
                    icon: "warning"
                });
                return false;
            }

            let tabla = document.getElementById("tableDetalle");
            let tbody = tabla.getElementsByTagName("tbody")[0];

            if (!tbody) {
                tbody = document.createElement("tbody");
                tabla.appendChild(tbody);
            }

            let fila = document.createElement("tr");

            fila.innerHTML = `
                <td></td>
                <td>${txtProductoAlimenticio}</td>
                <td>${txtpresentacion}</td>
                <td>${cantidadUnidad}</td>
                <td>${txtUnidad}</td>
                <td>${cantidad}</td>
                <td>
                    <input type="date" name="FechaVencimiento" class="form-control" value="${fechaVencimiento}" disabled>
                </td>
                <td>
                    <button type="button" class="btn btn-danger btn-sm" onclick="EliminarFila(this, 0)">Eliminar</button>

                    <input type="hidden" name="IdDetalleReingresoAlimentos" value="0">
                    <input type="hidden" name="IdProductoAlimenticio" value="${productoAlimenticio}">
                    <input type="hidden" name="IdPresentacion" value="${presentacion}">
                    <input type="hidden" name="CantidadUnidad" value="${cantidadUnidad}">
                    <input type="hidden" name="IdUnidadMedida" value="${unidadMedida}">
                    <input type="hidden" name="Cantidad" value="${cantidad}">
                </td>
            `;

            tbody.appendChild(fila);
            ActualizarContador();

            LimpiarDetalles();
            return false;
        }

        function EliminarFila(boton, idDetalle) {

            // En el escenario en donde el ID de es diferente de cero, se elimina en la BD
            if (idDetalle != 0){

                if (!confirm("¿Estás seguro de que deseas eliminar este Producto Alimenticio?")) {
                    return;
                }

                $.ajax({
                url: `@ViewData["rutaApp"]/ReingresoAlimentos/EliminarDetalleReingresoAlimentos?id=${idDetalle}`,
                type: "POST",
                success: function (respuesta) {
                    Swal.fire({
                        title: "Eliminado!",
                        text: "Producto eliminado correctamente.",
                        icon: "success"
                    });
                },
                error: function (xhr, status, error) {
                    console.error("Error al eliminar:", error);
                    alert("Ocurrió un error al eliminar el producto.");
                }
            });
            }

            let fila = boton.closest("tr");
            fila.remove();

            ActualizarContador();
        }

        function LimpiarDetalles(){
            $('#cbIdProductoAlimenticio').val();
            $('#cbIdPresentacionPA').val();
            $('#cbIdUnidadMedida').val();
            $('#txtCantidadUnidad').val('');
            $('#txtCantidad').val('');
        }

        function ConfirmSave(){
            Swal.fire({
              title: "Está seguro de almacenar el Registro de Reingreso?",
              showCancelButton: true,
              confirmButtonText: "Guardar",
              icon: "question"
            }).then((result) => {
              if (result.isConfirmed) {
                  GuardarReingreso();
              }
            });
        }

        function GuardarReingreso() {

            let reingresoAlimentos = {
                IdReingresoAlimentos: $("#idReingresoAlimentos").val(),
                IdEgresoAlimentos: $("#idEgresoAlimentos").val(),
                ObservacionFisicaIndeca: $("#txtObservacionFisicaIndeca").val(),
            };

            if (!reingresoAlimentos.IdEgresoAlimentos){
                Swal.fire({
                    title: "Error!",
                    text: "Debe de Seleccionar un Egreso.",
                    icon: "warning"
                });

                return;
            }

            // Almacenamiento de Detalles
            let tabla = document.getElementById("tableDetalle");
            let tbody = tabla.getElementsByTagName("tbody")[0];

            let detalles = [];

            $("#tableDetalle tbody tr").each(function () {
                let fila = $(this);

                let detalle = {
                    IdDetalleReingresoAlimentos: fila.find("input[name='IdDetalleEgresoAlimentos']").val(),
                    IdReingresoAlimentos: $('#idReingresoAlimentos').val(),
                    IdProductoAlimenticio: fila.find("input[name='IdProductoAlimenticio']").val(),
                    IdPresentacion: fila.find("input[name='IdPresentacion']").val(),
                    CantidadUnidad: fila.find("input[name='CantidadUnidad']").val(),
                    IdUnidadMedida: fila.find("input[name='IdUnidadMedida']").val(),
                    Cantidad: fila.find("input[name='Cantidad']").val(),
                    FechaVencimiento: fila.find("input[name='FechaVencimiento']").val(),
                    IdEstiba: fila.find("input[name='IdEstiba']").val()
                };

                    detalles.push(detalle);
            });

            if (detalles.length == 0) {

                Swal.fire({
                    title: "Error!",
                    text: "Debe de ingresar Productos.",
                    icon: "warning"
                });

                return;
            }

            // Almacenamiento de Documento
            if ($('#archivoDespacho')[0].files[0] == undefined && $('#txtUbicacionArchivo').val() == '' ){
                Swal.fire({
                    title: "Error!",
                    text: "Debe de Cargar el Archivo de Despacho de almacén.",
                    icon: "warning"
                });

                return;
            }

            let datosEnvio = {
                ReingresoAlimentos: reingresoAlimentos,
                listaDetalleReingresoAlimentos: detalles
            };

            var condicionSanitaria = $('#AutorizadoRechazado').prop('checked');

            // Crear un objeto FormData
            var formData = new FormData();

            // Agregar los datos del formulario al objeto FormData
            formData.append('modelo', JSON.stringify(datosEnvio)); // Enviar el modelo como JSON
            formData.append('file', $('#archivoDespacho')[0].files[0]); // Agregar el archivo


            $.ajax({
                url: `@ViewData["rutaApp"]/ReingresoAlimentos/GuardarRegistroReingreso`,
                type: "POST",
                contentType: false,
                processData: false,
                data: formData,
                success: function (respuesta) {

                    Swal.fire("Almacenado!", "", "success");

                    // Redireccionar o limpiar formulario si es necesario
                    window.location.href = `@ViewData["rutaApp"]/ReingresoAlimentos/Index`;
                },
                error: function (xhr, status, error) {
                    console.error("Error al guardar:", error);
                    alert("Ocurrió un error al guardar el despacho de almacén.");
                }
            });
        }

    </script>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    // Forzar la carga de jQuery UI si no está disponible
        if (typeof $.ui === "undefined") {
            $.getScript("https://code.jquery.com/ui/1.12.1/jquery-ui.min.js", function () {
                console.log("jQuery UI cargado correctamente.");
                iniciarAutocompletado(); // Llamamos la función después de cargar jQuery UI
            });
        } 

</script> 


